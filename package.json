{
  "name": "terry-templeos",
  "version": "1.0.0",
  "description": "Holytron DM-640 (TempleOS replica) desktop app",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check:paths": "node scripts/check-paths.mjs",
    "check:shell": "node scripts/check-shell.mjs",
    "check:apps": "node scripts/check-apps.mjs",
    "check:persist": "node scripts/check-persist.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "check:package": "node scripts/check-package.mjs",
    "check:listeners": "node scripts/check-listeners.mjs",
    "check:music": "node scripts/check-music.mjs",
    "check:garage": "node scripts/check-garage.mjs",
    "check:drunk": "node scripts/check-drunk.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:styletrack": "node scripts/check-styletrack.mjs",
    "check:desk": "node scripts/check-desk.mjs",
    "check:bulk": "node scripts/check-bulk.mjs",
    "check:delete": "node scripts/check-delete.mjs",
    "check:farewell": "node scripts/check-farewell.mjs",
    "check:petlines": "node scripts/check-petlines.mjs",
    "check:rooms": "node apps/bekkedal/rooms_check.js",
    "check:sun": "node scripts/check-sun.mjs",
    "check:trophies": "node scripts/check-trophies.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:props": "node scripts/check-props.mjs",
    "check:drop": "node scripts/check-drop.mjs",
    "check:standbattle": "node scripts/check-standbattle.mjs",
    "check:bios": "node scripts/check-bios.mjs",
    "check:demo": "node scripts/check-demo.mjs",
    "check:stack": "node scripts/check-stack.mjs",
    "check:lines": "node scripts/check-lines.mjs",
    "check:dave": "node scripts/check-dave.mjs",
    "check:wires": "node scripts/check-trophy-wires.mjs",
    "check:pictures": "node scripts/check-pictures.mjs",
    "check:eggs": "node scripts/check-eggs.mjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0"
  },
  "author": "Teodor Popa-Ghiorghici",
  "private": true,
  "homepage": "https://github.com/teodor-popa-ghiorghici/bobo-testing-unit",
  "desktopName": "holytron.desktop"
}
