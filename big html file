/* is this line HolyC, or is it a word for the answering machine? */
function looksLikeHolyC(s) {
  const t = String(s).trim();
  if (!t) return false;
  if (t.charAt(0) === '"') return true;
  if (/^(U0|I64|I32|I16|I8|U64|U32|U16|U8|F64|Bool)\b/.test(t)) return true;
  if (/^(if|while|for|return)\s*[({]/.test(t)) return true;
  if (/;\s*$/.test(t)) return true;
  if (/^[A-Za-z_]\w*\s*\([^)]*\)\s*;?$/.test(t)) return true;
  return false;
}


/* ==========================================================================
   31. THE DISK, AND WHAT IS WRITTEN ON IT
   --------------------------------------------------------------------------
   The machine already had a disk: kvGet/kvSet over localStorage, one
   namespaced key per subsystem. Everything added below writes through the
   same door rather than opening a second one, because a machine with two
   save files is a machine that loses one of them.

   Reads are synchronous on purpose. The frame around the screen and the logo
   on the boot splash have to be right on the first painted frame, and a
   promise does not resolve in time to be part of that frame.
   ========================================================================== */
const SUN_KEY  = 'templeos.sun.v1';
const COSM_KEY = 'templeos.cosm.v1';
const GARD_KEY = 'templeos.garden.v1';
const SWP_KEY  = 'templeos.sweeper.v1';
const SOL_KEY  = 'templeos.solitaire.v1';
const DRAW_KEY = 'templeos.drawings.v1';

let diskErrorShown = false;

/* A key that will not parse is not a reason to wipe a machine. It is copied
   aside, the defaults are used, and the operator is told — once. */
function sysLoad(key, def) {
  let raw = null;
  try { raw = localStorage.getItem(key); } catch (e) { return def; }
  if (raw == null || raw === '') return def;
  let val = null;
  try { val = JSON.parse(raw); } catch (e) { val = undefined; }
  if (val === undefined || val === null || typeof val !== 'object') {
    try { localStorage.setItem(key + '.bak', raw); localStorage.removeItem(key); } catch (x) {}
    if (!diskErrorShown) {
      diskErrorShown = true;
      setTimeout(() => sysDialog('DISK ERROR',
        'A SECTOR WOULD NOT PARSE.\n\n' + key + '\n\nPREVIOUS SESSION RECOVERED TO BACKUP:\n' +
        key + '.bak\n\nTHE MACHINE HAS STARTED FROM DEFAULTS.'), 1200);
    }
    return def;
  }
  return val;
}

/* every write is debounced half a second, per key, the way the editor is */
const sysTimers = Object.create(null);
function sysSave(key, obj) {
  clearTimeout(sysTimers[key]);
  sysTimers[key] = setTimeout(() => { kvSet(key, obj); }, 500);
}
function sysSaveNow(key, obj) { clearTimeout(sysTimers[key]); kvSet(key, obj); }

/* fill in anything a save from before this update does not carry, rather
   than deciding an old save is a broken one */
function withDefaults(got, def) {
  const out = {};
  for (const k in def) out[k] = def[k];
  for (const k in got) if (got[k] !== undefined) out[k] = got[k];
  return out;
}

