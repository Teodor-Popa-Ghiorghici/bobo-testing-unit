/* ---- 24.3 degauss -------------------------------------------------------
   The thump, the colour swimming, the picture breathing, and then it
   settles. On a real set this ran every cold start and you felt it in the
   desk. */
let degaussing = false;
function degauss() {
  if (degaussing || !CRT.on) return;
  degaussing = true;
  Snd.thunk();
  Snd.noise(420, { mech: true, freq: 90, q: 0.5, vol: 0.32 });
  Snd.tone(52, 900, { mech: true, type: 'triangle', to: 30, vol: 0.14 });
  Snd.tone(104, 700, { mech: true, type: 'sine', to: 61, vol: 0.07, delay: 0.05 });

  const tube = document.getElementById('tube');
  const ring = document.getElementById('degauss');
  if (!tube || !ring) { degaussing = false; return; }
  ring.classList.remove('held');
  ring.style.display = 'block';

  const t0 = performance.now();
  const DUR = 1500;
  const step = now => {
    const t = (now - t0) / DUR;
    if (t >= 1) {
      tube.style.transform = 'scale(var(--tube-zoom, 1))';
      ring.style.opacity = '';
      ring.style.transform = '';
      /* held on, the coil keeps humming at a level you can work through */
      if (CRT.dgauss) ring.classList.add('held'); else ring.style.display = 'none';
      degaussing = false;
      Snd.ok();
      return;
    }
    const decay = Math.pow(1 - t, 2.2);
    const wob = Math.sin(t * Math.PI * 2 * 7) * decay;
    const sc = 1 + wob * 0.008;
    const sk = wob * 0.45;
    tube.style.transform = 'scale(calc(var(--tube-zoom, 1) * ' + sc.toFixed(4) + ')) skewX(' + sk.toFixed(3) + 'deg)';
    ring.style.opacity = String(decay * 0.34);
    ring.style.transform = 'rotate(' + (t * 260).toFixed(1) + 'deg) scale(' + (1 + wob * 0.05).toFixed(3) + ')';
    requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}

/* ---- 24.4 vertical and horizontal hold ---------------------------------
   Both start locked at 5. Take one off centre and the picture goes with it,
   exactly like the set you used to thump. The roll is a composited
   transform plus a tear bar, so it costs nothing per frame. */
const Hold = {
  raf: null, phase: 0, last: 0,
  v() { return ((Vol.vhold == null ? 5 : Vol.vhold) - 5) / 5; },
  h() { return ((Vol.hhold == null ? 5 : Vol.hhold) - 5) / 5; },
  locked() { return Math.abs(this.v()) < 0.01 && Math.abs(this.h()) < 0.01; },
  apply() {
    const shell = document.getElementById('shell');
    const tear = document.getElementById('tear');
    if (!shell) return;
    if (this.locked()) {
      shell.style.transform = '';
      if (tear) tear.style.display = 'none';
      if (this.raf) { cancelAnimationFrame(this.raf); this.raf = null; }
      return;
    }
    if (!this.raf) {
      this.last = performance.now();
      const loop = now => {
        this.raf = requestAnimationFrame(loop);
        const dt = Math.min(64, now - this.last);
        this.last = now;
        this.tick(dt);
      };
      this.raf = requestAnimationFrame(loop);
    }
  },
  tick(dt) {
    const shell = document.getElementById('shell');
    const tear = document.getElementById('tear');
    if (!shell) return;
    const host = document.getElementById('tube');
    const H = (host && host.clientHeight) || shell.clientHeight || 400;
    const v = this.v(), h = this.h();
    this.phase += (dt / 1000) * v * H * 0.55;
    if (this.phase > H) this.phase -= H * 2;
    if (this.phase < -H) this.phase += H * 2;

    /* horizontal hold slipping is a steady offset plus a little shear */
    const hx = h * 46;
    const shear = h * 3.2 + Math.sin(performance.now() / 90) * Math.abs(h) * 1.1;
    shell.style.transform =
      'translate(' + hx.toFixed(1) + 'px,' + this.phase.toFixed(1) + 'px) skewX(' + shear.toFixed(2) + 'deg)';

    if (tear) {
      if (Math.abs(v) < 0.01) { tear.style.display = 'none'; return; }
      tear.style.display = 'block';
      const y = ((this.phase % H) + H) % H;
      tear.style.top = (y - 10) + 'px';
      tear.style.opacity = String(Math.min(1, Math.abs(v) * 1.6));
    }
  }
};

