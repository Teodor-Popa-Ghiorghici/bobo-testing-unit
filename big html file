          g.fillStyle = C(9); g.fillRect(px, py, BEK_T, 4);
          g.fillStyle = C(11); g.fillRect(px + 3, py + 2, 6, 1); g.fillRect(px + 12, py + 4, 5, 1);
          g.fillStyle = C(14); g.fillRect(px, py + BEK_T - 5, BEK_T, 2);
