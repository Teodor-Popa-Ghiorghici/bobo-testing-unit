/* ==========================================================================
   27. VIDEO ON THE DESKTOP
   --------------------------------------------------------------------------
   The same crush, running behind the icons. Ten frames a second, because it
   is a background and the tube has other things to do.
   ========================================================================== */
const DeskVid = {
  raf: null, video: null, cv: null, work: null, last: 0, src: null,
  start(src) {
    this.stop();
    const desk = document.getElementById('desktop');
    if (!desk) return;
    this.src = src;
    const cv = document.createElement('canvas');
    cv.id = 'deskvid';
    desk.insertBefore(cv, desk.firstChild);
    const v = document.createElement('video');
    v.src = src; v.loop = true; v.muted = true; v.playsInline = true;
    v.setAttribute('playsinline', '');
    this.cv = cv; this.video = v; this.work = document.createElement('canvas');
    let sized = false;
    const size = () => {
      const W = v.videoWidth || 320, H = v.videoHeight || 240;
      const s = Math.min(1, 256 / Math.max(W, H));
      this.work.width = cv.width = Math.max(2, Math.round(W * s));
      this.work.height = cv.height = Math.max(2, Math.round(H * s));
      sized = true;
    };
    v.addEventListener('loadedmetadata', () => { size(); v.play().catch(() => {}); });
    v.addEventListener('error', () => { toast('THAT VIDEO WILL NOT DECODE.'); this.stop(); });
    const loop = ts => {
      if (!this.cv || !document.body.contains(this.cv)) { this.stop(); return; }
      this.raf = requestAnimationFrame(loop);
      if (!sized && v.videoWidth) size();
      if (!sized || v.readyState < 2) return;
      if (ts - this.last < 100) return;              /* ten frames a second */
      this.last = ts;
      const g = this.work.getContext('2d'), o = cv.getContext('2d');
      if (!g || !o) return;
      try { g.drawImage(v, 0, 0, this.work.width, this.work.height); } catch (e) { return; }
      ditherBayer(g, this.work.width, this.work.height, 56);
      o.drawImage(this.work, 0, 0);
    };
    this.raf = requestAnimationFrame(loop);
  },
  stop() {
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = null;
    if (this.cv && this.cv.parentNode) this.cv.parentNode.removeChild(this.cv);
    if (this.video) { try { this.video.pause(); this.video.src = ''; } catch (e) {} }
    this.cv = this.video = null;
    this.src = null;
  }
};

