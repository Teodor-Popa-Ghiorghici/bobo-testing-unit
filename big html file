        if (c === 'f') { g.fillStyle = C(6); g.fillRect(px, py, BEK_T, BEK_T); g.fillStyle = C(8); g.fillRect(px, py + 19, BEK_T, 1); g.fillRect(px + 19, py, 1, BEK_T); }
