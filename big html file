        if (c === 'x') { g.fillStyle = C(6); g.fillRect(px, py + 3, BEK_T, 14); g.fillStyle = C(8); for (let i = 0; i < BEK_T; i += 4) g.fillRect(px + i, py + 3, 1, 14); }
