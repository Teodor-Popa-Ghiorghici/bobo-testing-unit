<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TempleOS V5.03</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<style>
/* ==========================================================================
   TempleOS visual replica — 16-color VGA palette only.
   #000000 #0000AA #00AA00 #00AAAA #AA0000 #AA00AA #AA5500 #AAAAAA
   #555555 #5555FF #55FF55 #55FFFF #FF5555 #FF55FF #FFFF55 #FFFFFF
   No gradients (except the scanline overlay), no radii, no shadows,
   no transitions, no anti-aliased curves.
   ========================================================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

html, body {
  height: 100%;
  overflow: hidden;
  background: #0b0b0e;
  color: #AAAAAA;
  font-family: 'VT323', 'Courier New', monospace;
  font-size: 20px;
  line-height: 1.05;
  -webkit-font-smoothing: none;
  font-smooth: never;
}

/* ==========================================================================
   THE HARDWARE
   Everything from here to the end of this block is the physical monitor.
   It is not a picture of a machine sitting in a room — it IS the page: the
   case fills the viewport and the plastic is the browser's own border, so
   the whole thing grows and shrinks with the window. It is also the one
   part of this page allowed off the 16-color palette, because it is
   plastic, not phosphor.
   ========================================================================== */
#room {
  position: fixed;
  inset: 0;
  padding: 0;
  background: #08080b;
}

#monitor {
  --bez: clamp(7px, 1.5vmin, 26px);
  --chin: clamp(46px, 6.6vmin, 78px);
  /* All four are rewritten by the LENS knob — see applyLensShape(). The
     radii are in PIXELS on purpose: a percentage radius on a 1600px-wide
     tube eats 170px of corner and swallows the File menu. */
  --tube-r: 8px / 10px;
  --well-r: 12px;
  --case-r: 12px;
  /* how far the whole interface sits inside the curved picture area */
  --safe-x: 0px;
  --safe-y: 0px;
  --tube-zoom: 1;
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  padding: calc(var(--bez) * 1.1) var(--bez) 0 var(--bez);
  border-radius: var(--case-r);
  /* injection-molded beige, lit from the upper left */
  background: linear-gradient(158deg, #dcd4c0 0%, #c4bba5 26%, #a79e88 62%, #8f8770 100%);
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,0.55),
    inset 0 -3px 0 rgba(0,0,0,0.30),
    inset 3px 0 0 rgba(255,255,255,0.16),
    inset -3px 0 0 rgba(0,0,0,0.18);
  transition: border-radius 260ms ease;
}

/* the recessed well the tube sits in */
#bezel {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  padding: calc(var(--bez) * 0.9);
  border-radius: var(--well-r);
  background: linear-gradient(160deg, #8c836d 0%, #a89f89 40%, #7d745f 100%);
  box-shadow:
    inset 0 3px 8px rgba(0,0,0,0.55),
    inset 0 -1px 0 rgba(255,255,255,0.25);
  transition: border-radius 260ms ease;
}

#screen {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #05050a;
  /* the tube's own corner radius — wider than it is tall, like real glass.
     It deepens as the lens is turned up, so the glass, the well and the case
     all follow the same curve the picture is being bent to. */
  border-radius: var(--tube-r);
  box-shadow:
    inset 0 0 0 2px rgba(0,0,0,0.9),
    inset 0 0 22px 8px rgba(0,0,0,0.85),
    0 0 26px rgba(90,160,255,0.10);
  transition: border-radius 260ms ease;
}

/* The picture layer. It carries no SVG filter: a full-viewport
   feDisplacementMap re-ran on every repaint — every clock tick, every
   keystroke, every dragged window — which is where the lag came from, and
   rasterizing the subtree is what made editor and terminal text spill past
   its own window border. The curvature now lives entirely in the glass
   canvas and the frame, which are drawn once per resize and cost nothing.
   All that is left here is a little overscan, so turning the lens still
   makes the picture move. No will-change: promoting this layer is what
   would blur the text at non-integer scales. */
#tube {
  position: absolute;
  inset: 0;
  background: #000000;
  transform: scale(var(--tube-zoom, 1));
  transform-origin: 50% 50%;
}

/* curved glass drawn on a canvas: scanlines, grille, vignette, glare.
   It sits outside #tube so animating it never re-runs the lens filter. */
#glass {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
}
@keyframes hum { 0%, 100% { opacity: 1; } 47% { opacity: 0.97; } 52% { opacity: 1.02; } }
#glass.live { animation: hum 7s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) { #glass.live { animation: none; } }

/* --- the chin: badge, lamp, and the monitor's own buttons ---------------- */
#chin {
  height: var(--chin);
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: clamp(6px, 1.2vmin, 16px);
  padding: 0 clamp(6px, 1.4vmin, 18px);
  font-size: clamp(10px, 1.5vmin, 15px);
  letter-spacing: 1px;
  color: #6b6353;
  user-select: none;
}
#badge { display: flex; align-items: center; gap: 6px; text-shadow: 0 1px 0 rgba(255,255,255,0.45); }
#badge svg { width: clamp(12px, 1.8vmin, 19px); height: clamp(12px, 1.8vmin, 19px); display: block; }

#lamp {
  width: clamp(6px, 0.9vmin, 10px);
  height: clamp(6px, 0.9vmin, 10px);
  border-radius: 50%;
  background: #1d3b1d;
  box-shadow: inset 0 1px 2px rgba(0,0,0,0.7);
  flex: 0 0 auto;
}
#lamp.on {
  background: #6dff6d;
  box-shadow: 0 0 7px 2px rgba(90,255,90,0.75), inset 0 0 3px rgba(255,255,255,0.9);
}

.knob {
  font: inherit;
  letter-spacing: 1px;
  color: #4e4739;
  background: linear-gradient(180deg, #cdc4ae 0%, #a89f89 100%);
  border: 0;
  border-radius: 3px;
  padding: 3px clamp(5px, 1vmin, 11px);
  cursor: pointer;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.6),
    inset 0 -2px 0 rgba(0,0,0,0.22),
    0 1px 2px rgba(0,0,0,0.3);
  white-space: nowrap;
}
.knob:hover { background: linear-gradient(180deg, #ded5bf 0%, #b6ad97 100%); }
.knob:active { box-shadow: inset 0 2px 4px rgba(0,0,0,0.4); transform: translateY(1px); }
#power { color: #6a3b32; font-weight: bold; }

/* --- the front panel: two pots and a switch, in a routed recess ---------- */
@media (max-width: 1080px) { #k-phos, #k-burn { display: none; } }
@media (max-width: 880px)  { .potbox.hold { display: none; } }
@media (max-width: 700px)  { #k-dgauss { display: none; } }

#panel {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: clamp(5px, 1.1vmin, 14px);
  padding: 0 clamp(5px, 1.1vmin, 14px);
  height: calc(var(--chin) * 0.84);
  border-radius: 4px;
  background: linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(255,255,255,0.12) 100%);
  box-shadow:
    inset 0 1px 3px rgba(0,0,0,0.30),
    inset 0 -1px 0 rgba(255,255,255,0.40);
  flex: 0 0 auto;
}
.potbox, .swbox {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
}
.potlbl {
  font-size: clamp(8px, 1.1vmin, 11px);
  letter-spacing: 1px;
  line-height: 1.1;
  color: #57503f;
  text-shadow: 0 1px 0 rgba(255,255,255,0.45);
  white-space: nowrap;
  user-select: none;
}

.pot {
  --deg: -135deg;
  position: relative;
  width: calc(var(--chin) * 0.50);
  height: calc(var(--chin) * 0.50);
  cursor: grab;
  touch-action: none;
  outline: 0;
  flex: 0 0 auto;
}
.pot:focus-visible { outline: 2px solid #55FFFF; outline-offset: 2px; }
.pot .ticks { position: absolute; inset: 0; width: 100%; height: 100%; }
.pot .cap {
  position: absolute;
  inset: 15%;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 26%, #6f6754 0%, #4a4438 46%, #2b2822 78%, #191712 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.28),
    inset 0 -2px 3px rgba(0,0,0,0.55),
    0 1px 2px rgba(0,0,0,0.55);
  transform: rotate(var(--deg));
}
/* knurling — the grip you can feel through the sound */
.pot .cap::before {
  content: '';
  position: absolute;
  inset: 7%;
  border-radius: 50%;
  background: repeating-conic-gradient(
    rgba(255,255,255,0.11) 0deg 3deg, rgba(0,0,0,0.16) 3deg 6deg);
  opacity: 0.6;
}
.pot .cap i {
  position: absolute;
  left: calc(50% - 1px);
  top: 7%;
  width: 2px;
  height: 41%;
  background: #f6eed8;
}
.pot.turning { cursor: grabbing; }
.pot.turning .cap {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.20),
    inset 0 -1px 2px rgba(0,0,0,0.60),
    0 0 0 1px rgba(0,0,0,0.35);
}

/* an old slim rocker: plate, paddle, and a pip that lights when it is up */
.lswitch {
  position: relative;
  width: calc(var(--chin) * 0.27);
  height: calc(var(--chin) * 0.50);
  border-radius: 3px;
  background: linear-gradient(180deg, #e9e0ca 0%, #cdc4ae 55%, #b0a790 100%);
  box-shadow:
    inset 0 0 0 1px rgba(0,0,0,0.22),
    inset 0 1px 0 rgba(255,255,255,0.65),
    0 1px 2px rgba(0,0,0,0.40);
  cursor: pointer;
  touch-action: none;
  outline: 0;
  flex: 0 0 auto;
}
.lswitch:focus-visible { outline: 2px solid #55FFFF; outline-offset: 2px; }
.lswitch .rocker {
  position: absolute;
  left: 14%; right: 14%;
  height: 45%;
  top: 48%;                                   /* down is off */
  border-radius: 2px;
  background: linear-gradient(180deg, #f7f0dd 0%, #ded5bd 60%, #bcb39b 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.85),
    inset 0 -1px 0 rgba(0,0,0,0.22),
    0 1px 1px rgba(0,0,0,0.35);
  transition: top 70ms cubic-bezier(.2,.9,.25,1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lswitch.on .rocker { top: 7%; }              /* up is on */
.lswitch .pip {
  width: 3px; height: 3px;
  border-radius: 50%;
  background: #8b8270;
}
.lswitch.on .pip {
  background: #6dff6d;
  box-shadow: 0 0 4px rgba(90,255,90,0.9);
}

/* CRT power-down: the picture collapses to a line, then a dot */
#tube { transition: transform 260ms ease; }
#glass { transition: none; }
#screen.off #tube, #screen.off #glass { opacity: 0; }
#screen.collapsing #tube {
  transform: scaleY(0.004) scaleX(1.04);
  filter: brightness(9) !important;
  transition: transform 260ms cubic-bezier(.6,0,.9,.3), filter 260ms ease-out;
}
#screen.collapsing #glass { opacity: 0; transition: opacity 180ms; }

@media (max-width: 640px) {
  #monitor { --bez: 5px; --chin: 42px; }
  #chin { font-size: 9px; letter-spacing: 0; gap: 4px; overflow: hidden; }
  #badge span { display: none; }
  #panel { gap: 4px; padding: 0 4px; }
  html, body { font-size: 16px; }
}

/* --- blink (hard toggle, no fade) --------------------------------------- */
@keyframes blink { 0%,49% { visibility: visible; } 50%,100% { visibility: hidden; } }
.blink { animation: blink 1s steps(1,end) infinite; }

/* ========================= BOOT SPLASH ================================== */
#splash {
  position: absolute;
  inset: 0;
  background: #000000;
  z-index: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2% 0;
  margin: var(--safe-y) var(--safe-x);
  overflow: hidden;
  cursor: pointer;
}
/* the temple is sized off the glass, not off a fixed pixel width, so a wide
   window gets a wide splash instead of a stretched one */
#logo {
  height: 38%;
  min-height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}
#logo svg { display: block; height: 100%; width: auto; max-width: 92%; }
#wordmark {
  font-size: clamp(30px, 8.5vmin, 68px);
  letter-spacing: 4px;
  line-height: 1;
  margin: 2px 0 14px 0;
  color: #FFFF55;
}
#bootlines {
  width: 70%;
  max-width: 560px;
  font-size: clamp(13px, 2.8vmin, 22px);
  line-height: 1.25;
  color: #FFFFFF;
}
.bootline.g { color: #55FF55; }
.bootline.w { color: #FFFFFF; }
.bootline.y { color: #FFFF55; }
#bootcursor { color: #55FF55; }
#boothint { color: #55FFFF; margin-top: 6px; }

/* ========================= DESKTOP SHELL ================================ */
/* The shell is inset by the lens margin rather than each bar padding itself.
   Padding moved the text but left the bars running off into the corner, so
   the menu and the taskbar still got eaten. Insetting the whole shell moves
   the menubar, the taskbar, the icons and every window together, and leaves
   black glass in the curve where a real tube has nothing to show. */
#shell {
  position: absolute;
  top: var(--safe-y);
  bottom: var(--safe-y);
  left: var(--safe-x);
  right: var(--safe-x);
  display: none;
  transition: top 220ms ease, bottom 220ms ease, left 220ms ease, right 220ms ease;
}

#menubar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 24px;
  background: #AAAAAA;
  color: #000000;
  border-bottom: 1px solid #555555;
  display: flex;
  align-items: center;
  z-index: 400;
  user-select: none;
}
.menuitem { padding: 0 10px; height: 100%; display: flex; align-items: center; cursor: pointer; }
.menuitem:hover { background: #000000; color: #AAAAAA; }
#menubar .brand { margin-left: auto; padding-right: 10px; color: #000000; }

#desktop {
  position: absolute;
  top: 25px; bottom: 25px; left: 0; right: 0;
  background: #0000AA;
  overflow: hidden;
  cursor: default;
}

/* The desktop lays its icons out by coordinate, not by flow, so they can be
   picked up and put down anywhere. Icons inside a folder window keep the
   flow layout below — a file list should sort itself, a desktop should not. */
#icons {
  position: absolute;
  inset: 0;
}
#icons .icon { position: absolute; }
#icons .icon.dragging { opacity: 0.65; z-index: 60; }

/* rubber band */
#marquee {
  position: absolute;
  display: none;
  z-index: 50;
  border: 1px dotted #FFFFFF;
  background: rgba(85, 255, 255, 0.14);
  pointer-events: none;
}

.icon {
  width: 92px;
  padding: 4px 0 2px 0;
  text-align: center;
  cursor: pointer;
  user-select: none;
}
.icon svg { width: 36px; height: 36px; display: block; margin: 0 auto 2px auto; }
.icon .lbl {
  display: inline-block;
  padding: 0 3px;
  color: #FFFFFF;
  max-width: 90px;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
}
.icon.sel .lbl { background: #FFFFFF; color: #000000; }

#taskbar {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 25px;
  background: #AAAAAA;
  border-top: 1px solid #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 4px;
  z-index: 400;
  user-select: none;
}
#tasks { display: flex; gap: 4px; overflow: hidden; }
.tbtn {
  border: 1px solid #555555;
  background: #AAAAAA;
  color: #000000;
  padding: 0 8px;
  height: 20px;
  line-height: 20px;
  cursor: pointer;
  white-space: nowrap;
  max-width: 190px;
  overflow: hidden;
}
.tbtn:hover { background: #FFFFFF; }
.tbtn.active { background: #000000; color: #FFFF55; border-color: #FFFFFF; }
#clock {
  margin-left: auto;
  padding: 0 8px;
  height: 20px;
  line-height: 20px;
  border: 1px solid #555555;
  background: #000000;
  color: #55FF55;
}

/* ========================= WINDOWS ====================================== */
.win {
  position: absolute;
  background: #000000;
  border: 2px solid #FFFFFF;
  display: flex;
  flex-direction: column;
  min-width: 180px;
  min-height: 90px;
}
.titlebar {
  height: 22px;
  display: flex;
  align-items: center;
  color: #000000;
  cursor: move;
  user-select: none;
  flex: 0 0 auto;
}
.titlebar .t { padding: 0 6px; overflow: hidden; white-space: nowrap; }
.titlebar .m,
.titlebar .x {
  padding: 0 6px;
  cursor: pointer;
  border-left: 2px solid #000000;
}
.titlebar .m { margin-left: auto; }
.titlebar .m:hover,
.titlebar .x:hover { background: #000000; color: #FFFFFF; }
.wbody { flex: 1 1 auto; overflow: auto; background: #000000; position: relative; }

.win.hidden { display: none; }

/* resize grip, bottom right */
.grip {
  position: absolute;
  right: 0; bottom: 0;
  width: 14px; height: 14px;
  cursor: nwse-resize;
  z-index: 5;
  background:
    linear-gradient(135deg,
      transparent 0%, transparent 34%,
      #FFFFFF 34%, #FFFFFF 45%,
      transparent 45%, transparent 62%,
      #FFFFFF 62%, #FFFFFF 73%,
      transparent 73%);
}
.tbtn.min { color: #555555; font-style: normal; }

/* folder window contents */
.folderpane {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  padding: 8px 4px;
  gap: 4px;
  min-height: 100%;
}
.emptynote { color: #555555; padding: 10px; }

/* text editor */
textarea.editor {
  width: 100%;
  height: 100%;
  display: block;
  background: #000000;
  color: #55FF55;
  border: 0;
  outline: 0;
  resize: none;
  padding: 4px 6px;
  font-family: inherit;
  font-size: 20px;
  line-height: 1.1;
}

/* image viewer */
.imgpane {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: #000000;
  padding: 6px;
}
.imgpane img { max-width: 100%; max-height: 100%; }

/* terminal */
.term { display: flex; flex-direction: column; height: 100%; background: #000000; padding: 4px 6px; }
.termout { flex: 1 1 auto; overflow-y: auto; white-space: pre-wrap; word-break: break-word; }
.termout div { line-height: 1.15; }
.l-echo { color: #FFFFFF; }
.l-ok   { color: #55FF55; }
.l-holy { color: #FFFF55; }
.l-err  { color: #FF5555; }
.l-dim  { color: #AAAAAA; }
.termline { position: relative; flex: 0 0 auto; color: #55FF55; padding-top: 2px; }
.termline .p { color: #55FFFF; }
.termline .typed { color: #FFFFFF; }
.termline .cur { color: #55FF55; }
.terminput {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0;
  border: 0;
  background: transparent;
  font: inherit;
}
/* --- drop targets while dragging files in -------------------------------- */
.dropok { outline: 2px dashed #55FF55; outline-offset: -3px; }
.icon.dropok { background: #00AA00; outline-offset: -1px; }
#desktop.dropok { outline: 3px dashed #55FF55; outline-offset: -5px; }

/* --- File menu + right click menu ---------------------------------------- */
.popmenu {
  position: absolute;
  background: #AAAAAA;
  color: #000000;
  border: 2px solid #FFFFFF;
  z-index: 450;
  display: none;
  min-width: 200px;
  padding: 2px 0;
  user-select: none;
}
.popmenu .mi { padding: 1px 10px; cursor: pointer; white-space: nowrap; }
.popmenu .mi:hover { background: #000000; color: #FFFF55; }
.popmenu .mi.off, .popmenu .mi.off:hover { color: #555555; background: #AAAAAA; cursor: default; }
.popmenu .sep { height: 1px; background: #555555; margin: 2px 4px; }

/* --- status line --------------------------------------------------------- */
#toast {
  position: absolute;
  left: 8px; bottom: 30px;
  background: #000000;
  color: #55FF55;
  border: 1px solid #55FF55;
  padding: 1px 8px;
  z-index: 460;
  display: none;
}

/* --- name prompt dialog -------------------------------------------------- */
.dlgpane { padding: 8px; color: #AAAAAA; }
.dlgpane input {
  width: 100%;
  background: #000000;
  color: #55FF55;
  border: 1px solid #555555;
  font: inherit;
  padding: 2px 4px;
  outline: 0;
  margin: 6px 0;
}
.dlgpane .btns { display: flex; gap: 6px; }
.dlgpane button {
  font: inherit;
  background: #AAAAAA;
  color: #000000;
  border: 1px solid #FFFFFF;
  padding: 0 10px;
  cursor: pointer;
}
.dlgpane button:hover { background: #FFFFFF; }

/* ---- DolDoc ------------------------------------------------------------- */
.ddpane {
  padding: 8px 10px;
  color: #AAAAAA;
  min-height: 100%;
  background: #000000;
  line-height: 1.15;
}
.ddline { white-space: pre-wrap; word-break: break-word; min-height: 1.15em; }
.ddhr {
  display: block;
  height: 2px;
  background: #555555;
  margin: 3px 0;
}
.ddspwrap { display: inline-block; vertical-align: -3px; }
.ddsp { width: 18px; height: 18px; display: inline-block; }
.ddlink {
  color: #55FFFF;
  text-decoration: underline;
  cursor: pointer;
}
.ddlink:hover { background: #00AAAA; color: #000000; }
.ddmacro {
  color: #000000;
  background: #FFFF55;
  border: 1px solid #FFFFFF;
  padding: 0 5px;
  cursor: pointer;
}
.ddmacro:hover { background: #FFFFFF; }
.ddtreehead { color: #FFFF55; cursor: pointer; user-select: none; }
.ddtreehead:hover { background: #0000AA; }
.ddtree .ddtreekids { display: block; padding-left: 14px; }
.ddtree:not(.open) .ddtreekids { display: none; }
.srcbtn { color: #000000; }
.editor.ddsrc { color: #FFFF55; }

/* ---- app windows -------------------------------------------------------- */
.appbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 4px;
  background: #000000;
  border-top: 1px solid #555555;
  position: sticky;
  bottom: 0;
}
.appbtn {
  font: inherit;
  font-size: 16px;
  background: #AAAAAA;
  color: #000000;
  border: 1px solid #FFFFFF;
  padding: 0 8px;
  cursor: pointer;
}
.appbtn:hover { background: #FFFFFF; }
.godword { color: #55FF55; padding-left: 4px; white-space: nowrap; overflow: hidden; }
.godpane, .vidpane, .gamepane {
  display: flex; align-items: center; justify-content: center;
  background: #000000; padding: 4px; min-height: 60%;
}
.godcv, .vidcv, .gamecv {
  image-rendering: pixelated;
  max-width: 100%;
  max-height: 100%;
  background: #000000;
}
.gamecv { outline: 0; cursor: crosshair; }
/* Bekkedal draws 480x300 and is presented at 150% — a whole-number-ish blow-up
   the pixelated scaler keeps crisp. height:auto holds the ratio while
   max-width shrinks it on a small desktop, and max-height must be released
   or the shared rule squashes the picture instead of scaling it. */
.bekcv {
  cursor: default;
  width: 720px;
  height: auto;
  max-height: none;
}
/* The elephant draws 480x300 and gets the same 150% blow-up, for the same
   reason. The pointer is a hand because the whole picture is the button. */
/* The Cook draws 420x320 and is shown at 150%, like everything else in here
   that is a game rather than a document. */
.ckcv { cursor: pointer; width: 630px; height: auto; max-height: none; outline: 0; }
.ckpane { background: #05070a; }
.ckbar .appbtn:disabled { background: #555555; color: #000000; cursor: default; }
.ckbar .ckheat { background: #FF5555; }
.ckbar .ckcool { background: #55FFFF; }
.ckinfo { color: #55FFFF; }

.elecv {
  cursor: pointer;
  width: 720px;
  height: auto;
  max-height: none;
}
/* the rack sits in its own dark room rather than on the desktop grey, and
   is blown up with nearest neighbour so the knobs keep their jagged edges */
.hifipane { background: #06060a; padding: 3px; }
.hificv {
  cursor: pointer;
  width: 800px;
  height: auto;
  max-height: none;
  image-rendering: pixelated;
  box-shadow: 0 0 0 2px #000000, 0 6px 18px rgba(0,0,0,0.8);
}
.l-holyc { color: #55FFFF; }
.tasklist .killable { cursor: pointer; }
.tasklist .killable:hover { background: #AA0000; color: #FFFFFF; }
.panicterm { background: #0000AA; }
.panicterm .termout div { color: #FFFF55; }
.panicterm .l-err { color: #FF5555; }
.panicterm .l-ok { color: #FFFFFF; }
.panicterm .l-dim { color: #55FFFF; }
.panicterm .l-holy { color: #FFFF55; }
.win.panic { border-color: #FF5555 !important; }
.slbox { color: #55FF55; }

/* ---- defrag ------------------------------------------------------------- */
.defragpane { padding: 6px; background: #0000AA; min-height: 100%; }
.defraggrid {
  display: grid;
  grid-template-columns: repeat(40, 1fr);
  gap: 1px;
  border: 2px solid #FFFFFF;
  padding: 2px;
  background: #000000;
}
.db { display: block; width: 100%; padding-bottom: 100%; background: #555555; }
.db.used { background: #AAAAAA; }
.db.free { background: #0000AA; }
.db.read { background: #FFFF55; }
.db.writ { background: #55FF55; }
.db.bad  { background: #FF5555; }
.defraglegend {
  display: flex; flex-wrap: wrap; gap: 8px;
  color: #FFFFFF; padding: 4px 2px; font-size: 15px;
}
.defraglegend span { display: flex; align-items: center; gap: 3px; }
.defraglegend .db { width: 9px; height: 9px; padding: 0; }
.defragstatus { color: #55FF55; padding: 2px; }

/* ---- CMOS --------------------------------------------------------------- */
.cmos { background: #0000AA; color: #FFFFFF; min-height: 100%; padding: 6px; }
.cmoshead { text-align: center; background: #AAAAAA; color: #000000; margin-bottom: 6px; }
.cmosbody { border: 1px solid #FFFFFF; padding: 4px 6px; }
.cmosrow { display: flex; }
.cmosrow .k { width: 55%; color: #FFFF55; }
.cmosrow .v { color: #55FFFF; }
.cmosfoot { margin-top: 6px; text-align: center; color: #AAAAAA; }

/* ---- the tube's own layers ---------------------------------------------- */
#burn {
  position: absolute;
  inset: 0;
  display: none;
  pointer-events: none;
  z-index: 300;
  opacity: 0.055;
  mix-blend-mode: screen;
}
#burn .bb { position: absolute; background: #FFFFFF; }
#tear {
  position: absolute;
  left: 0; right: 0;
  height: 20px;
  display: none;
  pointer-events: none;
  z-index: 320;
  background: linear-gradient(180deg,
    rgba(255,255,255,0.28) 0%, rgba(0,0,0,0.85) 22%,
    rgba(0,0,0,0.85) 78%, rgba(255,255,255,0.12) 100%);
}
/* The coil, at about a third of what it used to be. It was a strobe before;
   now it is a shimmer you can leave switched on and still read the screen. */
#degauss {
  position: absolute;
  inset: -12%;
  display: none;
  pointer-events: none;
  z-index: 9998;
  background:
    conic-gradient(from 0deg,
      rgba(255,0,0,0.11), rgba(0,255,0,0.11), rgba(0,0,255,0.11),
      rgba(255,0,255,0.11), rgba(255,255,0,0.11), rgba(255,0,0,0.11));
  mix-blend-mode: screen;
  filter: blur(20px);
}
/* left on, it drifts rather than flashes */
#degauss.held { display: block; opacity: 0.5; animation: dg-drift 9s linear infinite; }
@keyframes dg-drift { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { #degauss.held { animation: none; } }
#saver {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  z-index: 9000;
  background: #000000;
  image-rendering: pixelated;
}
#deskvid {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  image-rendering: pixelated;
  z-index: 0;
}
#icons, #marquee { z-index: 2; }

/* ---- phosphor persistence ----------------------------------------------- */
.termout div, textarea.editor, .ddline, .bootline, #bios div, .icon .lbl {
  text-shadow: 0 0 var(--phos-px, 0px) currentColor;
}

/* ---- the BIOS ----------------------------------------------------------- */
#bios {
  position: absolute;
  inset: 0;
  display: none;
  background: #000000;
  color: #AAAAAA;
  padding: 14px 18px;
  z-index: 520;
  line-height: 1.2;
  overflow: hidden;
}
#bios .biosdel { position: absolute; bottom: 12px; left: 18px; color: #FFFFFF; }
#splash.posting > #logo,
#splash.posting > #wordmark,
#splash.posting > #bootlines { visibility: hidden; }

/* fake dropdown scroll bars: keep them blocky */
::-webkit-scrollbar { width: 12px; height: 12px; }
::-webkit-scrollbar-track { background: #000000; border-left: 1px solid #555555; }
::-webkit-scrollbar-thumb { background: #AAAAAA; border: 1px solid #FFFFFF; }

/* ---- the notes ---------------------------------------------------------- */
.notesroot { display: flex; flex-direction: column; height: 100%; background: #000000; color: #AAAAAA; }
.ntop { display: flex; align-items: center; gap: 4px; padding: 3px 4px; background: #000000;
        border-bottom: 1px solid #555555; flex: 0 0 auto; flex-wrap: wrap; }
.ntop .appbtn { padding: 1px 6px; }
.nsep { width: 1px; height: 16px; background: #555555; margin: 0 3px; }
.nsel { background: #000000; color: #55FF55; border: 1px solid #555555; font: 11px 'Courier New', monospace; padding: 1px 2px; }
.nstat { color: #FFFF55; font: 11px 'Courier New', monospace; padding-left: 6px; white-space: nowrap; }
.nbody { flex: 1 1 auto; display: flex; min-height: 0; }
.nside { width: 170px; flex: 0 0 170px; border-right: 1px solid #555555; display: flex; flex-direction: column; min-height: 0; }
.nfind { background: #000000; color: #55FF55; border: 0; border-bottom: 1px solid #555555;
         font: 11px 'Courier New', monospace; padding: 4px; outline: 0; }
.nfind::placeholder { color: #555555; }
.nlist { flex: 1 1 auto; overflow: auto; }
.nrow { display: flex; justify-content: space-between; gap: 4px; padding: 3px 6px; cursor: pointer;
        font: 12px 'Courier New', monospace; color: #AAAAAA; border-bottom: 1px solid #111111; }
.nrow:hover { background: #0000AA; color: #FFFFFF; }
.nrow.on { background: #00AAAA; color: #000000; }
.nrt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nrc { color: #555555; }
.nrow.on .nrc { color: #000000; }
.nempty { padding: 8px; color: #555555; font: 11px 'Courier New', monospace; }
.nmain { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.ntitle { background: #000000; color: #FFFF55; border: 0; border-bottom: 1px solid #555555;
          font: bold 15px 'Courier New', monospace; padding: 5px 8px; outline: 0; flex: 0 0 auto; }
.nedit { flex: 1 1 auto; background: #000000; color: #AAAAAA; border: 0; resize: none; outline: 0;
         padding: 8px; line-height: 1.5; min-height: 0; }
.nread { flex: 1 1 auto; display: none; overflow: auto; padding: 8px; line-height: 1.5;
         white-space: pre-wrap; word-break: break-word; }
.notesroot.reading .nedit { display: none; }
.notesroot.reading .nread { display: block; }
.nread .nh1 { color: #FFFFFF; font-weight: bold; font-size: 1.35em; }
.nread .nh2 { color: #55FFFF; font-weight: bold; font-size: 1.18em; }
.nread .nh3 { color: #55FF55; font-weight: bold; }
.nread .nli { color: #AAAAAA; }
.nread .ntask { color: #FFFF55; }
.nread .ntask.done { color: #555555; text-decoration: line-through; }
.nlink { color: #55FFFF; cursor: pointer; text-decoration: underline; }
.nlink:hover { background: #00AAAA; color: #000000; }
.nlink.dead { color: #FF5555; }
.nback { flex: 0 0 auto; border-top: 1px solid #555555; padding: 4px 6px; max-height: 92px; overflow: auto;
         font: 11px 'Courier New', monospace; }
.nbl { color: #555555; margin-right: 6px; }
.nbnone { color: #333333; margin-right: 8px; }
.nchip { display: inline-block; margin: 1px 4px 1px 0; padding: 0 5px; border: 1px solid #555555;
         color: #55FF55; cursor: pointer; }
.nchip:hover { background: #00AA00; color: #000000; }
.nchip.dead { color: #FF5555; border-color: #AA0000; }
.ngraph { display: none; flex: 1 1 auto; position: relative; min-width: 0; }
.notesroot.graphing .nmain { display: none; }
.ngraph.on { display: block; }
.ngcv { width: 100%; height: 100%; display: block; background: #07090c; cursor: grab; }
.nghint { position: absolute; left: 8px; bottom: 6px; color: #555555; font: 10px 'Courier New', monospace;
          pointer-events: none; }
.jagpane { background: #150d06; }

/* ---- the clicker --------------------------------------------------------
   A store with two hundred rows in it wants to be a document, not a canvas,
   so this one is DOM everywhere except the star itself. Sixteen colours
   still, and every border is one hard pixel. */
.mgroot { display: flex; flex-direction: column; height: 100%; background: #000000; color: #AAAAAA;
          font: 13px 'Courier New', monospace; position: relative; }
.mgnews { flex: 0 0 auto; background: #000000; border-bottom: 1px solid #555555; padding: 2px 4px;
          color: #55FF55; white-space: pre; overflow: hidden; font-size: 12px; }
.mgbody { flex: 1 1 auto; display: flex; min-height: 0; }
.mgleft { flex: 0 0 306px; display: flex; flex-direction: column; align-items: center;
          border-right: 1px solid #555555; min-height: 0; padding-top: 4px; }
.mgcount { text-align: center; line-height: 1.1; }
.mgcount .mgn { color: #FFFF55; font-size: 26px; font-weight: bold; display: block;
                text-shadow: 2px 2px 0 #000000; word-break: break-all; }
.mgcount .mgu { color: #AAAAAA; font-size: 12px; }
.mgrate { color: #55FFFF; font-size: 12px; margin: 1px 0 3px; }
.mgstagewrap { flex: 0 0 auto; }
.mgcv { width: 300px; height: 300px; image-rendering: pixelated; cursor: pointer; display: block; }
.mgbuffs { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; min-height: 15px;
           font-size: 11px; padding: 2px 4px; }
.mgbuff { text-shadow: 1px 1px 0 #000000; }
.mgact { font-size: 12px; min-height: 18px; padding: 2px; text-align: center; }
.mgshab { color: #FFFF55; }
.mgshab.lit { background: #AA5500; color: #FFFFFF; border: 1px solid #FFFF55; padding: 1px 6px; cursor: pointer; }
.mgshab.lit:hover { background: #FFFF55; color: #000000; }
.mgsoon { color: #555555; }

.mgright { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.mgtabs { flex: 0 0 auto; display: flex; border-bottom: 1px solid #555555; }
.mgtab { flex: 1 1 auto; font: inherit; font-size: 12px; background: #000000; color: #AAAAAA;
         border: 0; border-right: 1px solid #555555; padding: 3px 2px; cursor: pointer; }
.mgtab:hover { background: #0000AA; color: #FFFFFF; }
.mgtab.on { background: #AAAAAA; color: #000000; }
.mgtab i { color: #55FF55; font-style: normal; }
.mgtab.on i { color: #AA0000; }
.mgpane { flex: 1 1 auto; overflow: auto; min-height: 0; }

.mgrow { display: flex; align-items: center; gap: 6px; padding: 3px 6px; cursor: pointer;
         border-bottom: 1px solid #111111; }
.mgrow:hover { background: #0000AA; }
.mgrow.poor { color: #555555; }
.mgrow.poor:hover { background: #550000; }
.mgrow.locked { color: #333333; cursor: default; justify-content: center; }
.mgrow.locked:hover { background: #000000; }
.mgic { width: 26px; height: 26px; flex: 0 0 26px; image-rendering: pixelated; }
.mgnm { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; line-height: 1.15; }
.mgnm b { color: #FFFFFF; font-weight: normal; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mgrow.poor .mgnm b { color: #777777; }
.mgnm i { color: #FFFF55; font-style: normal; font-size: 11px; }
.mgrow.poor .mgnm i { color: #AA5500; }
/* the legacy rows show what the thing does, so that line is yellow too */
.mgrow.leg .mgnm i { color: #FFFF55; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mgrow.leg.poor .mgnm i { color: #AA5500; }
.mgrow.leg.owned .mgnm i { color: #55FF55; }
.mgown { color: #55FFFF; font-size: 17px; flex: 0 0 auto; min-width: 30px; text-align: right; }
.mgtag { color: #55FF55; font-size: 10px; flex: 0 0 auto; }
.mgrow.up { border-left: 2px solid #00AA00; }
.mgrow.leg { border-left: 2px solid #AA00AA; }
.mgrow.leg.owned { color: #55FF55; cursor: default; }
.mgrow.leg.owned .mgtag { color: #FFFFFF; }
.mgq { color: #333333; }
.mgempty, .mghead { padding: 8px; color: #55FFFF; font-size: 12px; line-height: 1.4;
                    border-bottom: 1px solid #555555; }
.mgach { padding: 3px 8px; border-bottom: 1px solid #111111; line-height: 1.2; }
.mgach b { color: #333333; font-weight: normal; display: block; }
.mgach i { color: #222222; font-style: normal; font-size: 11px; }
.mgach.on b { color: #FFFF55; }
.mgach.on i { color: #777777; }
.mgach.on.zero b { color: #55FFFF; }
.mgstat div { display: flex; justify-content: space-between; padding: 2px 8px; border-bottom: 1px solid #111111; }
.mgstat span { color: #AAAAAA; font-size: 12px; }
.mgstat b { color: #FFFF55; font-weight: normal; }
.mgasc { padding: 8px; border-bottom: 1px solid #555555; display: flex; align-items: center; gap: 8px;
         flex-wrap: wrap; }
.mgasc span { color: #55FFFF; font-size: 11px; }

.mgbar { flex: 0 0 auto; display: flex; align-items: center; gap: 5px; padding: 3px 4px;
         background: #000000; border-top: 1px solid #555555; }
.mgbuy.on { background: #FFFF55; }
.mghint { color: #555555; font-size: 11px; white-space: nowrap; overflow: hidden; }
.mgtip { display: none; position: absolute; z-index: 40; width: 250px; background: #000000;
         border: 1px solid #FFFFFF; padding: 6px 8px; font-size: 12px; line-height: 1.35;
         pointer-events: none; box-shadow: 3px 3px 0 #000000; }
.mgtip b { color: #FFFF55; font-weight: normal; }
.mgtip u { color: #55FFFF; text-decoration: none; float: right; }
.mgtip p { color: #AAAAAA; margin-top: 4px; }
.mgtip .mgt2 { color: #55FF55; }
.mgtip .mgt2 b { color: #FFFFFF; }
/* Flavour is grey and mechanics are yellow, everywhere, without exception.
   You should never have to read a paragraph to find the number. */
.mgtip .mgmech { color: #FFFF55; margin-top: 4px; }

/* ---- the juice ----------------------------------------------------------
   Every animation below moves in whole pixels and snaps with steps(), which
   is the only kind of motion this machine is allowed. */
.mgrate b { color: #FFFF55; font-weight: normal; }
.mgrate i { color: #AA5500; font-style: normal; }
.mgrate u { color: #FF55FF; text-decoration: none; }
.mgcount .mgn.big { font-size: 22px; }

/* the bar that says what is next and how long it is */
.mggoal { position: relative; width: 288px; height: 15px; background: #000000;
          border: 1px solid #555555; margin: 1px 0 3px; overflow: hidden; }
.mggoal span, .mggoal b { position: relative; z-index: 2; font-size: 11px; line-height: 13px; }
.mggoal span { float: left; padding-left: 4px; color: #AAAAAA; }
.mggoal b { float: right; padding-right: 4px; color: #55FFFF; font-weight: normal; }
.mggoal i { position: absolute; left: 0; top: 0; bottom: 0; z-index: 1; background: #0000AA; }

/* buffs, with the time left drawn as well as written */
.mgbuff { position: relative; display: inline-block; padding: 1px 5px 4px;
          border: 1px solid #555555; background: #000000; }
.mgbuff i { position: absolute; left: 0; bottom: 0; height: 2px; }

/* rows you can afford breathe; rows you cannot sit still */
@keyframes mg-ready { 0%, 100% { border-left-color: #555555; } 50% { border-left-color: #FFFF55; } }
.mgrow { border-left: 3px solid #555555; }
.mgrow.ready { animation: mg-ready 1.4s steps(1, end) infinite; }
.mgrow.poor { border-left-color: #222222; }
.mgrow.f-tier.ready      { animation: none; border-left-color: #FFFF55; }
.mgrow.f-hand.ready      { animation: none; border-left-color: #FF5555; }
.mgrow.f-kavanah.ready   { animation: none; border-left-color: #FF55FF; }
.mgrow.f-community.ready { animation: none; border-left-color: #55FFFF; }
.mgrow.f-rule.ready      { animation: none; border-left-color: #55FF55; }
.mgrow.up { border-left-width: 3px; }
.mgrow.leg.ready { animation: none; border-left-color: #FF55FF; }

/* the three things a row does when you press it */
@keyframes mg-bought { 0% { background: #FFFFFF; transform: translateX(0); }
                       25% { background: #FFFF55; transform: translateX(6px); }
                       60% { background: #00AA00; transform: translateX(-2px); }
                       100% { background: transparent; transform: translateX(0); } }
@keyframes mg-sold   { 0% { background: #FF5555; transform: translateX(0); }
                       40% { background: #AA0000; transform: translateX(-8px); }
                       100% { background: transparent; transform: translateX(0); } }
@keyframes mg-nope   { 0%, 100% { transform: translateX(0); }
                       25% { transform: translateX(-4px); }
                       75% { transform: translateX(4px); } }
.mgrow.bought { animation: mg-bought 360ms steps(4, end); }
.mgrow.sold   { animation: mg-sold 300ms steps(3, end); }
.mgrow.nope   { animation: mg-nope 160ms steps(1, end) 2; }

/* the icon leans in when the row is hovered, because it should feel touched */
.mgrow:hover .mgic { transform: translateY(-2px) scale(1.12); }
.mgic { transition: none; }

/* an upgrade waiting to be bought pulls at the tab it is under */
@keyframes mg-badge { 0%, 100% { color: #55FF55; } 50% { color: #FFFFFF; } }
.mgtab i { animation: mg-badge 900ms steps(1, end) infinite; }

/* the tabs get a lit edge so the row of them is not a flat strip */
.mgtab { border-bottom: 2px solid #000000; }
.mgtab.on { border-bottom-color: #FFFF55; }
.mgtab:hover { border-bottom-color: #55FFFF; }

/* the buy-count buttons say which one is armed with more than a colour */
.mgbuy { border-width: 2px; }
.mgbuy.on { background: #FFFF55; border-color: #FFFFFF; color: #000000; }

/* the ticker gets a hard rule under it and a mark at each end */
.mgnews { border-bottom: 2px solid #00AA00; position: relative; }

/* the stage sits in a frame with its corners knocked out */
.mgstagewrap { position: relative; border: 1px solid #555555; }
.mgstagewrap:before, .mgstagewrap:after {
  content: ''; position: absolute; width: 7px; height: 7px; background: #FFFF55; }
.mgstagewrap:before { left: -1px; top: -1px; }
.mgstagewrap:after  { right: -1px; bottom: -1px; }

/* ---- filling in the black ------------------------------------------------
   A flat black panel is what you get when nobody decided anything. These are
   ordered dithers of palette greys, written as 4x4 SVG tiles, which is the
   same thing the canvas does with pat() and stays inside the sixteen: every
   pixel is either #000000 or #555555. */
.mgroot {
  --dit: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4"><rect width="4" height="4" fill="%23000000"/><rect x="0" y="0" width="1" height="1" fill="%23555555"/></svg>');
  --dit2: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4"><rect width="4" height="4" fill="%23000000"/><rect x="0" y="0" width="1" height="1" fill="%23555555"/><rect x="2" y="2" width="1" height="1" fill="%23555555"/></svg>');
  --hue: #55FFFF;
  background-image: var(--dit);
}
.mgpane, .mgleft { background-image: var(--dit); }
.mghead, .mgbar, .mgtabs, .mgnews { background-image: var(--dit2); background-color: #000000; }
.mgrow:nth-child(even) { background-image: var(--dit); }
.mgrow:hover { background-image: none; }
.mgach:nth-child(even) { background-image: var(--dit); }
.mgdict:nth-child(even) { background-image: var(--dit); }
.mgstat div:nth-child(even) { background-image: var(--dit); }

/* two rails down the sides of the stage that tick over, so the column is
   never a dead black margin */
.mgleft { position: relative; }
.mgleft:before, .mgleft:after {
  content: ''; position: absolute; top: 0; bottom: 26px; width: 4px;
  background-image: repeating-linear-gradient(
    to bottom, var(--hue) 0 2px, #000000 2px 9px);
  opacity: 0.45;
}
.mgleft:before { left: 0; }
.mgleft:after { right: 0; }

/* ---- and the room takes its colour from what is happening in it ---------- */
.mgroot[data-mood="simcha"] { --hue: #FFFF55; }
.mgroot[data-mood="guest"]  { --hue: #55FF55; }
.mgroot[data-mood="havd"]   { --hue: #FF55FF; }
.mgroot[data-mood="buff"]   { --hue: #55FFFF; }
.mgroot[data-mood="chain"]  { --hue: #FF55FF; }
.mgroot[data-mood="shab"]   { --hue: #AA5500; }
.mgroot[data-mood="bad"]    { --hue: #FF5555; }

.mgleft, .mgright { border-color: var(--hue) !important; }
.mgnews { border-bottom-color: var(--hue); }
.mgbar  { border-top: 1px solid var(--hue); }
.mgtabs { border-bottom-color: var(--hue); }
.mgstagewrap { border-color: var(--hue); }
.mgstagewrap:before, .mgstagewrap:after { background: var(--hue); }
/* the number itself stays gold: it is the thing you are reading, and it
   should not change colour every time a buff lands */
.mgroot[data-mood="bad"]  .mgcount .mgn { color: #FF5555; }
.mgroot[data-mood="shab"] .mgcount .mgn { color: #AA5500; }
.mggoal i { background: #0000AA; }

/* when something is running, the whole frame breathes with it */
@keyframes mg-alive { 0%, 100% { box-shadow: inset 0 0 0 1px #000000; }
                      50%      { box-shadow: inset 0 0 0 1px var(--hue); } }
.mgroot[data-mood="simcha"] .mgstagewrap,
.mgroot[data-mood="guest"] .mgstagewrap,
.mgroot[data-mood="havd"] .mgstagewrap,
.mgroot[data-mood="chain"] .mgstagewrap { animation: mg-alive 700ms steps(1, end) infinite; }
.mgroot[data-mood="bad"] .mgstagewrap { animation: mg-alive 300ms steps(1, end) infinite; }
@keyframes mg-rails { 0%, 100% { opacity: 0.35; } 50% { opacity: 0.9; } }
.mgroot:not([data-mood=""]) .mgleft:before,
.mgroot:not([data-mood=""]) .mgleft:after { animation: mg-rails 900ms steps(1, end) infinite; }
.mgroot[data-mood="bad"] .mgleft:before,
.mgroot[data-mood="bad"] .mgleft:after { animation-duration: 320ms; }

/* the tabs pick it up too, so the whole strip is not one grey */
.mgtab.on { background: var(--hue); border-bottom-color: #FFFFFF; }
.mgtab:hover { border-bottom-color: var(--hue); }

/* ---- the held / for sale toggle, and the word list ----------------------- */
.mgtoggle { display: flex; gap: 0; padding: 0; }
.mgtoggle .mgt { flex: 1 1 0; text-align: center; padding: 4px; cursor: pointer;
                 color: #555555; font-weight: normal; border-right: 1px solid #555555; }
.mgtoggle .mgt:last-child { border-right: 0; }
.mgtoggle .mgt:hover { color: #FFFFFF; }
.mgtoggle .mgt.on { background: var(--hue); color: #000000; }
.mgrow.up.owned { cursor: default; border-left-color: #555555; }
.mgrow.up.owned .mgnm b { color: #55FF55; }
.mgrow.up.owned .mgnm i { color: #FFFF55; font-size: 11px;
                          white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mgdict { padding: 4px 8px; border-bottom: 1px solid #111111; line-height: 1.3; }
.mgdict b { color: #FFFF55; font-weight: normal; display: block; }
.mgdict i { color: #AAAAAA; font-style: normal; font-size: 12px; }

/* ---- the options drawer -------------------------------------------------- */
.mgwipe { display: none; background: #AA0000; color: #FFFFFF; border-color: #FF5555; }
.mgroot.opts .mgwipe { display: inline-block; }
.mgroot.opts .mgopt { background: #FFFF55; }
.mgwipe:hover { background: #FF5555; color: #000000; }
.jagcv { width: 400px; height: auto; max-height: none; image-rendering: pixelated; cursor: pointer; }

/* ==========================================================================
   THE STYLE METER
   Sits in the picture, not on the glass: it is inside #tube, so the lens
   zooms it with everything else. 8000 clears the shell and the toast and
   still leaves the degauss flash (9998), the saver (9000) and the glass
   (9999) on top of it. Palette colours only; every shadow is a hard black
   offset, every animation moves in whole pixels and snaps with steps().
   ========================================================================== */
#smeter {
  position: absolute;
  top: 30px;                 /* clears the menubar. Set to 4px to overlap it. */
  right: 10px;
  z-index: 8000;
  display: none;
  pointer-events: none;
  user-select: none;
  text-align: right;
  width: clamp(150px, 26vmin, 330px);
  font-family: 'VT323', 'Courier New', monospace;
  line-height: 1;
  -webkit-font-smoothing: none;
  image-rendering: pixelated;
  --sm-col: #AAAAAA;
}
#smeter.live { display: block; }

#sm-grade {
  font-size: clamp(38px, 9.5vmin, 104px);
  letter-spacing: -0.04em;
  color: var(--sm-col);
  text-shadow: 3px 3px 0 #000000;
}
#sm-name {
  font-size: clamp(13px, 2.3vmin, 26px);
  letter-spacing: 1px;
  color: var(--sm-col);
  text-shadow: 2px 2px 0 #000000;
  margin-top: -2px;
  white-space: nowrap;
  overflow: hidden;
}

/* the drain bar: sixteen blocks, no interpolation, no rounded ends */
#sm-bar {
  display: flex;
  gap: 2px;
  justify-content: flex-end;
  margin-top: 5px;
}
#sm-bar b {
  flex: 1 1 0;
  height: clamp(6px, 1.3vmin, 13px);
  background: #000000;
  border: 1px solid #555555;
}
#sm-bar b.on {
  background: var(--sm-col);
  border-color: #FFFFFF;
}

/* the running tally under the bar, newest at the top */
#sm-log {
  margin-top: 4px;
  font-size: clamp(11px, 1.8vmin, 20px);
  letter-spacing: 1px;
  color: #AAAAAA;
  text-shadow: 1px 1px 0 #000000;
}
#sm-log div {
  animation: sm-fade 1500ms steps(3, end) forwards;
}
#sm-log div.big { color: var(--sm-col); }
@keyframes sm-fade {
  0%, 55% { opacity: 1; }
  100%    { opacity: 0; }
}

/* the hit: one frame of whole-pixel recoil */
#smeter.hit #sm-grade { animation: sm-shake 120ms steps(1, end); }
@keyframes sm-shake {
  0%   { transform: translate(-3px, 1px); }
  33%  { transform: translate(2px, -2px); }
  66%  { transform: translate(-1px, 0); }
  100% { transform: translate(0, 0); }
}

/* the promotion: a hard three-step pop, never a smooth scale */
#smeter.up #sm-grade { animation: sm-pop 260ms steps(1, end); }
#smeter.up #sm-name  { animation: sm-blink 260ms steps(1, end); }
@keyframes sm-pop {
  0%   { transform: scale(1.7); }
  40%  { transform: scale(1.25); }
  70%  { transform: scale(0.92); }
  100% { transform: scale(1); }
}
@keyframes sm-blink {
  0%, 60% { color: #FFFFFF; }
  100%    { color: var(--sm-col); }
}

/* the top rank shakes on its own until it starts to drain */
#smeter.top #sm-grade { animation: sm-rave 180ms steps(1, end) infinite; }
@keyframes sm-rave {
  0%   { transform: translate(-2px, 0)  scale(1.06); }
  50%  { transform: translate(2px, -2px) scale(1); }
  100% { transform: translate(0, 1px)   scale(1.04); }
}

@media (prefers-reduced-motion: reduce) {
  #smeter.hit #sm-grade,
  #smeter.up  #sm-grade,
  #smeter.up  #sm-name,
  #smeter.top #sm-grade { animation: none; }
}

/* ==========================================================================
   THE COSMETIC LAYER
   --------------------------------------------------------------------------
   Everything a customer can buy from Crazy Dave lands here as a custom
   property on #room. Nothing above this comment was edited to make it work:
   the rules below carry a second id so they outrank the originals, and every
   var() falls back to exactly what the machine shipped with. Take the
   properties away and you get the beige office monitor back, unharmed.
   ========================================================================== */
#room {
  --case-bg: linear-gradient(158deg, #dcd4c0 0%, #c4bba5 26%, #a79e88 62%, #8f8770 100%);
  --well-bg: linear-gradient(160deg, #8c836d 0%, #a89f89 40%, #7d745f 100%);
  --chin-ink: #6b6353;
  --knob-bg: linear-gradient(180deg, #cdc4ae 0%, #a89f89 100%);
  --knob-bg-hi: linear-gradient(180deg, #ded5bf 0%, #b6ad97 100%);
  --knob-ink: #4e4739;
  --lamp-on: #6dff6d;
  --lamp-off: #1d3b1d;
  --lamp-glow: rgba(90,255,90,0.75);
  --scr-tint: transparent;
  --case-shadow:
    inset 0 2px 0 rgba(255,255,255,0.55),
    inset 0 -3px 0 rgba(0,0,0,0.30),
    inset 3px 0 0 rgba(255,255,255,0.16),
    inset -3px 0 0 rgba(0,0,0,0.18);
}
#room #monitor { background: var(--case-bg); box-shadow: var(--case-shadow); }
#room #bezel   { background: var(--well-bg); }
#room #chin    { color: var(--chin-ink); }
#room #badge   { color: var(--chin-ink); }
#room .knob    { background: var(--knob-bg); color: var(--knob-ink); }
#room .knob:hover { background: var(--knob-bg-hi); }
#room .potlbl  { color: var(--chin-ink); }
#room #lamp    { background: var(--lamp-off); }
#room #lamp.on { background: var(--lamp-on); box-shadow: 0 0 7px 2px var(--lamp-glow), inset 0 0 3px rgba(255,255,255,0.9); }
/* the lamp browns out for a fifth of a second when an app takes power */
#room #lamp.dip { background: var(--lamp-off); box-shadow: none; }

/* frame decoration: moss, screws, tape, labels. One layer over the plastic,
   drawn per frame as inline SVG, never in the way of the pointer. */
#framedeco {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
/* the tint the frame lends the phosphor. Inside the glass, under the glass
   canvas, over the picture. */
#frametint {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 9990;
  background: var(--scr-tint);
  mix-blend-mode: screen;
}
#frameflash {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 9991;
  background: #FFFFFF;
  opacity: 0;
}
#frameflash.hit { opacity: 0.32; }

/* ---- the pointer --------------------------------------------------------
   Bought cursors are PNGs minted at boot from pixel arrays, so they stay
   square at every zoom and need no files. The rules are last in the sheet
   and carry #tube, which is enough to outrank every cursor declared above
   without any of those rules being touched. Each falls back to the system
   arrow it replaces, so an un-minted cursor is simply the stock one.
   ========================================================================== */
#tube, #tube * { cursor: var(--cur-arrow, default); }
#tube .icon, #tube .tbtn, #tube .mi, #tube .menuitem, #tube button,
#tube .ddlink, #tube .ddmacro, #tube .titlebar .x, #tube .titlebar .m,
#tube .shopcard, #tube .nchip { cursor: var(--cur-hand, pointer); }
#tube .titlebar { cursor: var(--cur-move, move); }
#tube input, #tube textarea { cursor: var(--cur-text, text); }
#tube .gamecv, #tube .drawcv { cursor: var(--cur-cross, crosshair); }
/* the three ported rooms use the whole picture as a button, and the clicker
   is a document with rows you press, so they take the hand and not the cross */
#tube .elecv, #tube .ckcv, #tube .mgcv, #tube .mgrow, #tube .mgtab,
#tube .mgtoggle .mgt, #tube .mgshab.lit { cursor: var(--cur-hand, pointer); }
#tube button:disabled, #tube .mgrow.locked, #tube .mgrow.leg.owned,
#tube .mgrow.up.owned { cursor: var(--cur-arrow, default); }
#tube .grip { cursor: nwse-resize; }

/* ---- the terminal scheme ------------------------------------------------
   Recolours every terminal, every system dialog, the toast line and the
   pop-up menus at once. Same trick: appended, id-qualified, all defaults.
   ========================================================================== */
#tube .term        { background: var(--sch-bg, #000000); }
#tube .termout .l-echo { color: var(--sch-fg,  #FFFFFF); }
#tube .termout .l-ok   { color: var(--sch-ok,  #55FF55); }
#tube .termout .l-holy { color: var(--sch-hi,  #FFFF55); }
#tube .termout .l-err  { color: var(--sch-err, #FF5555); }
#tube .termout .l-dim  { color: var(--sch-dim, #AAAAAA); }
#tube .termline    { color: var(--sch-ok, #55FF55); }
#tube .termline .p { color: var(--sch-acc, #55FFFF); }
#tube .termline .typed { color: var(--sch-fg, #FFFFFF); }
#tube .dlgpane     { color: var(--sch-dim, #AAAAAA); background: var(--sch-bg, #000000); }
#tube .dlgpane input { background: var(--sch-bg, #000000); color: var(--sch-ok, #55FF55); border-color: var(--sch-dim, #555555); }
#tube .dlgpane button { background: var(--sch-dim, #AAAAAA); color: var(--sch-bg, #000000); border-color: var(--sch-fg, #FFFFFF); }
#tube .dlgpane button:hover { background: var(--sch-fg, #FFFFFF); }
#tube #toast       { background: var(--sch-bg, #000000); color: var(--sch-ok, #55FF55); border-color: var(--sch-ok, #55FF55); }
#tube .popmenu     { background: var(--sch-dim, #AAAAAA); color: var(--sch-bg, #000000); border-color: var(--sch-fg, #FFFFFF); }
#tube .popmenu .mi:hover { background: var(--sch-bg, #000000); color: var(--sch-hi, #FFFF55); }
#tube .sysdlg      { color: var(--sch-fg, #FFFFFF); }

/* ==========================================================================
   THE SUN COUNTER
   Bottom right of the taskbar, left of the clock. The sprite is a canvas so
   it can spin in whole pixels; the number is a row of digit cells so it can
   roll one column at a time instead of being replaced.
   ========================================================================== */
#sunbox {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4px;
  height: 20px;
  padding: 0 7px 0 4px;
  border: 1px solid #555555;
  background: #000000;
  color: #FFFF55;
  cursor: pointer;
  user-select: none;
}
#sunbox:hover { border-color: #FFFF55; }
#sunbox canvas { width: 14px; height: 14px; display: block; image-rendering: pixelated; }
#sundigits { display: flex; height: 20px; overflow: hidden; line-height: 20px; }
#sundigits .dg { width: 10px; text-align: center; position: relative; height: 20px; }
#sundigits .dg span { display: block; height: 20px; }
#sundigits .dg.roll span { animation: dgroll 180ms steps(3) 1; }
@keyframes dgroll { from { transform: translateY(-20px); } to { transform: translateY(0); } }
#clock { margin-left: 6px; }
/* the window buttons give way before the counter and the clock do: with a
   dozen windows open the strip used to run straight over the right-hand end
   of the bar and take the time with it */
#taskbar #tasks { flex: 0 1 auto; min-width: 0; }
#taskbar #sunbox, #taskbar #clock { flex: 0 0 auto; }

/* the ledger */
.ledgpane { padding: 6px 8px; color: var(--sch-dim, #AAAAAA); min-height: 100%; background: var(--sch-bg, #000000); }
.ledghead { background: var(--sch-dim, #AAAAAA); color: var(--sch-bg, #000000); padding: 0 4px; display: flex; }
.ledghead span:last-child { margin-left: auto; }
.ledgrow { display: flex; border-bottom: 1px solid #1a1a1a; }
.ledgrow .w { flex: 1 1 auto; overflow: hidden; white-space: nowrap; }
.ledgrow .n { padding-left: 8px; }
.ledgrow .w { color: var(--sch-fg, #FFFFFF); }
.ledgrow.in  .n { color: var(--sch-ok, #55FF55); }
.ledgrow.out .n { color: var(--sch-err, #FF5555); }
.ledgrow .t { color: var(--sch-dim, #555555); padding-right: 8px; opacity: 0.7; }
.ledgtot { margin-top: 6px; border-top: 1px solid var(--sch-dim, #555555); padding-top: 3px; color: var(--sch-hi, #FFFF55); }

/* ==========================================================================
   CRAZY DAVE'S SHOP
   Deliberately louder chrome than the rest of the machine: a magenta bar
   with a hatched edge, because it turned up uninvited and it knows it.
   ========================================================================== */
.win.shopwin { border-color: #FF55FF; border-width: 3px; }
.win.shopwin .titlebar {
  background: repeating-linear-gradient(90deg, #FF55FF 0 8px, #AA00AA 8px 16px);
  color: #FFFF55;
  height: 24px;
}
.win.shopwin .titlebar .t { color: #FFFFFF; }
.shoproot { display: flex; flex-direction: column; height: 100%; background: #2a0a2a; }
.shoptop { display: flex; gap: 4px; padding: 4px; background: #AA00AA; border-bottom: 2px solid #FF55FF; }
.shopdave { width: 96px; flex: 0 0 96px; }
.shopdave canvas { width: 96px; height: 96px; display: block; image-rendering: pixelated; }
.shopbubble {
  flex: 1 1 auto;
  text-transform: uppercase;
  background: #FFFFFF;
  color: #000000;
  border: 2px solid #000000;
  padding: 4px 6px;
  line-height: 1.05;
  position: relative;
  align-self: flex-start;
  min-height: 62px;
}
.shopbubble:after {
  content: '';
  position: absolute;
  left: -10px; top: 14px;
  width: 0; height: 0;
  border: 5px solid transparent;
  border-right-color: #000000;
}
.shoptabs { display: flex; gap: 2px; padding: 3px 4px 0 4px; background: #2a0a2a; }
.shoptab {
  background: #AA00AA; color: #FFFF55; border: 2px solid #FF55FF; border-bottom: 0;
  padding: 0 8px; cursor: pointer; white-space: nowrap;
}
.shoptab.on { background: #FF55FF; color: #000000; }
.shopgrid {
  flex: 1 1 auto; overflow-y: auto;
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 5px; padding: 5px;
  align-content: start;
  border-top: 2px solid #FF55FF;
}
.shopcard {
  background: #000000; border: 2px solid #AAAAAA; padding: 3px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.shopcard:hover { border-color: #FFFF55; }
.shopcard.owned { border-color: #55FF55; }
.shopcard.eq    { border-color: #55FFFF; background: #001a1a; }
.shopcard.broke { border-color: #AA0000; }
.shopcard canvas { width: 116px; height: 60px; display: block; image-rendering: pixelated; background: #000000; }
.shopcard .nm { color: #FFFFFF; font-size: 17px; text-align: center; line-height: 1; }
.shopcard .pr { color: #FFFF55; font-size: 17px; }
.shopcard.owned .pr { color: #55FF55; }
.shopcard .bt {
  width: 100%; text-align: center; background: #AAAAAA; color: #000000;
  border: 1px solid #FFFFFF; font-size: 16px; line-height: 1.1;
}
.shopcard:hover .bt { background: #FFFFFF; }
.shopcard.eq .bt { background: #00AAAA; color: #000000; }
.shopfoot { padding: 2px 6px; background: #AA00AA; color: #FFFF55; display: flex; }
.shopfoot .r { margin-left: auto; color: #FFFFFF; }

/* ---- the garden --------------------------------------------------------- */
.gardenpane { background: #1d1a12; padding: 2px; }
.gardencv { width: 700px; height: auto; max-height: none; cursor: default; }
.gardencv.canning { cursor: cell; }
.gbar { color: #55FF55; }

/* ---- the sweeper -------------------------------------------------------- */
.sweeppane { background: #06070d; padding: 3px; }
.sweepcv { cursor: default; max-height: none; }
.sweepstats { color: #AAAAAA; font-size: 16px; padding: 2px 6px; background: #000000; border-top: 1px solid #222; display: flex; gap: 12px; flex-wrap: wrap; }
.sweepstats b { color: #55FFFF; font-weight: normal; }

/* ---- the solitaire ------------------------------------------------------ */
.solpane { background: #0a0c10; padding: 2px; }
.solcv { cursor: default; width: 880px; height: auto; max-height: none; }

/* ---- crayon ------------------------------------------------------------- */
.drawroot { display: flex; height: 100%; background: #2a2721; }
.drawtools { width: 96px; flex: 0 0 96px; padding: 4px; display: flex; flex-direction: column; gap: 3px; background: #1a1814; border-right: 2px solid #555555; }
.drawswatch { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; }
.drawswatch i { display: block; height: 18px; border: 2px solid #1a1814; cursor: pointer; }
.drawswatch i.on { border-color: #FFFFFF; }
.drawtools .tl {
  font: inherit; font-size: 16px; background: #6b6357; color: #e8e2d4;
  border: 1px solid #1a1a1a; padding: 0 4px; cursor: pointer; text-align: left;
}
.drawtools .tl.on { background: #e8e2d4; color: #1a1a1a; }
.drawtools .hd { color: #6b6357; font-size: 15px; margin-top: 3px; }
.drawwrap { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.drawcv { image-rendering: pixelated; box-shadow: 0 0 0 1px #1a1a1a, 3px 4px 0 rgba(0,0,0,0.5); }
.thumbwrap { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px; align-content: flex-start; }
.thumb { width: 92px; text-align: center; cursor: pointer; user-select: none; }
.thumb img { width: 80px; height: 60px; display: block; margin: 0 auto 2px auto; border: 1px solid #AAAAAA; background: #e8e2d4; }
.thumb .lbl { color: #FFFFFF; display: inline-block; padding: 0 3px; max-width: 90px; overflow: hidden; white-space: nowrap; }
.thumb.sel .lbl { background: #FFFFFF; color: #000000; }

/* ---- system dialog ------------------------------------------------------ */
.sysdlg { padding: 8px 10px; background: var(--sch-bg, #000000); min-height: 100%; }
.sysdlg .msg { line-height: 1.15; margin-bottom: 8px; white-space: pre-wrap; }
.sysdlg .btns { display: flex; gap: 6px; }
.sysdlg button {
  font: inherit; background: var(--sch-dim, #AAAAAA); color: var(--sch-bg, #000000);
  border: 1px solid var(--sch-fg, #FFFFFF); padding: 0 10px; cursor: pointer;
}
.sysdlg button:hover { background: var(--sch-fg, #FFFFFF); }

/* the refresh band: one pale bar down the tube every twelve seconds */
#refband {
  position: absolute;
  left: 0; right: 0;
  height: 12%;
  top: -14%;
  pointer-events: none;
  z-index: 9989;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.055) 45%, rgba(255,255,255,0) 100%);
  animation: refroll 12s linear infinite;
}
@keyframes refroll { from { top: -14%; } to { top: 100%; } }
@media (prefers-reduced-motion: reduce) { #refband { animation: none; display: none !important; } }

</style>
</head>
<body>

<!-- ========================= THE PHYSICAL MONITOR ======================== -->
<div id="room">
<div id="monitor">
<div id="bezel">
<div id="screen">
<div id="tube">

<!-- twenty years of the same menubar, and the roll, and the coils -->
<div id="burn" aria-hidden="true">
  <div class="bb" style="left:0;right:0;top:0;height:24px"></div>
  <div class="bb" style="left:0;right:0;bottom:0;height:25px"></div>
  <div class="bb" style="left:8px;top:34px;width:92px;height:52px;opacity:.6"></div>
  <div class="bb" style="left:8px;top:112px;width:92px;height:52px;opacity:.6"></div>
  <div class="bb" style="left:8px;top:190px;width:92px;height:52px;opacity:.45"></div>
</div>
<div id="tear" aria-hidden="true"></div>
<div id="degauss" aria-hidden="true"></div>

<!-- ============================ STYLE METER ============================= -->
<!-- Built by Style.mount(); the bar cells are generated so this stays short. -->
<div id="smeter" aria-hidden="true">
  <div id="sm-grade"><span id="sm-key">D</span></div>
  <div id="sm-name">DESECRATING</div>
  <div id="sm-bar"></div>
