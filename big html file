/* ==========================================================================
   17. THE 16-COLOUR PIPE
   --------------------------------------------------------------------------
   A lookup table from 15-bit RGB straight to a palette index. Building it
   costs half a million comparisons once; after that every pixel of every
   video frame is one array read, which is the only reason real time
   dithering of video is affordable at all.
   ========================================================================== */
let VGA_LUT = null;
function vgaLut() {
  if (VGA_LUT) return VGA_LUT;
  VGA_LUT = new Uint8Array(32768);
  for (let r = 0; r < 32; r++) {
    for (let g = 0; g < 32; g++) {
      for (let b = 0; b < 32; b++) {
        const R = r << 3, G = g << 3, B = b << 3;
        let best = 0, bd = Infinity;
        for (let i = 0; i < 16; i++) {
          const p = VGA16[i];
          const d = (R - p[0]) * (R - p[0]) + (G - p[1]) * (G - p[1]) + (B - p[2]) * (B - p[2]);
          if (d < bd) { bd = d; best = i; }
        }
        VGA_LUT[(r << 10) | (g << 5) | b] = best;
      }
    }
  }
  return VGA_LUT;
}

/* Bayer 8x8. Ordered dithering is the right choice for moving pictures:
   error diffusion crawls between frames and the whole image boils. */
const BAYER8 = (function () {
  const m = [
    0, 32,  8, 40,  2, 34, 10, 42,
   48, 16, 56, 24, 50, 18, 58, 26,
   12, 44,  4, 36, 14, 46,  6, 38,
   60, 28, 52, 20, 62, 30, 54, 22,
    3, 35, 11, 43,  1, 33,  9, 41,
   51, 19, 59, 27, 49, 17, 57, 25,
   15, 47,  7, 39, 13, 45,  5, 37,
   63, 31, 55, 23, 61, 29, 53, 21];
  return new Float32Array(m.map(v => (v / 64 - 0.5)));
})();

function ditherBayer(ctx, w, h, strength) {
  const lut = vgaLut();
  const id = ctx.getImageData(0, 0, w, h);
  const d = id.data;
  const amt = (strength == null ? 56 : strength);
  for (let y = 0; y < h; y++) {
    const row = (y & 7) << 3;
    for (let x = 0; x < w; x++) {
      const i = (y * w + x) << 2;
      const t = BAYER8[row | (x & 7)] * amt;
      let r = d[i] + t, g = d[i + 1] + t, b = d[i + 2] + t;
      r = r < 0 ? 0 : r > 255 ? 255 : r;
      g = g < 0 ? 0 : g > 255 ? 255 : g;
      b = b < 0 ? 0 : b > 255 ? 255 : b;
      const p = VGA16[lut[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)]];
      d[i] = p[0]; d[i + 1] = p[1]; d[i + 2] = p[2];
    }
  }
  ctx.putImageData(id, 0, 0);
}

/* ==========================================================================
   18. VIDEO
   --------------------------------------------------------------------------
   Same road in as an image: drag it on, paste it, or File > Upload. It is
   decoded by the browser, then every frame is scaled down and crushed to the
   same sixteen colours the stills get, live, at a frame rate that suits the
   hardware it is pretending to be.
   ========================================================================== */
const VID = {
  maxDim: 320,          /* longest edge of the dithered picture */
  fps: 15,              /* the tube is not going to do sixty */
  keepBytes: 1500000    /* bigger than this cannot be saved, only played */
};
const videoBlobs = Object.create(null);

/* Video goes to the vault whatever its size. Only the key is written to the
   settings drawer, so a two hundred megabyte film costs the same there as a
   thumbnail — and it is still on the desktop next week. */
function readVideoFile(file) {
  return Vault.put(file).then(key => {
    if (key) {
      const url = URL.createObjectURL(file);
      VaultURL.map[key] = url;
      return { name: safeName(file.name), type: 'video', src: url, vault: key,
               bytes: file.size, mime: file.type || 'video/mp4', user: true };
    }
    /* no vault on this browser: the old rules apply */
    return new Promise((resolve, reject) => {
      if (file.size <= VID.keepBytes) {
        const fr = new FileReader();
        fr.onerror = () => reject(new Error('READ FAILED'));
        fr.onload = () => resolve({ name: safeName(file.name), type: 'video', src: String(fr.result),
                                    bytes: file.size, mime: file.type || 'video/mp4', user: true });
        fr.readAsDataURL(file);
        return;
      }
      try {
        const url = URL.createObjectURL(file);
        const k = 'blob' + Date.now() + Math.floor(Math.random() * 1000);
        videoBlobs[k] = url;
        toast(safeName(file.name) + ' PLAYS, BUT THERE IS NO DISK TO KEEP IT ON.');
        resolve({ name: safeName(file.name), type: 'video', src: url, blobKey: k,
                  bytes: file.size, mime: file.type || 'video/mp4', user: true, session: true });
      } catch (e) { reject(new Error('NO BLOB URL')); }
    });
  });
}

function openVideo(node, path) {
  let raf = null, video = null, alive = true;
  createWindow({
    kind: 'video',
    title: node._path || path || node.name,
    w: 420, h: 350,
    build: body => {
      const pane = document.createElement('div');
      pane.className = 'imgpane vidpane';
      const cv = document.createElement('canvas');
      cv.className = 'vidcv';
      const work = document.createElement('canvas');
      pane.appendChild(cv);

      video = document.createElement('video');
      video.src = node.src;
      video.loop = true;
      video.muted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.crossOrigin = 'anonymous';

      const bar = document.createElement('div');
      bar.className = 'appbar';
      const mk = (label, fn) => {
        const b = document.createElement('button');
        b.className = 'appbtn';
        b.textContent = label;
        b.addEventListener('mousedown', ev => { ev.stopPropagation(); Snd.click(); fn(b); });
        bar.appendChild(b);
        return b;
      };
      const status = document.createElement('span');
      status.className = 'godword';

      let mode = 1;                    /* 0 raw, 1 bayer, 2 mono phosphor */
      const MODES = ['RGB', 'VGA16', 'GREEN'];
      const play = mk('PAUSE', b => {
        if (video.paused) { video.play().catch(() => {}); b.textContent = 'PAUSE'; }
        else { video.pause(); b.textContent = 'PLAY'; }
      });
      const dith = mk('DITHER: VGA16', b => {
        mode = (mode + 1) % 3;
        b.textContent = 'DITHER: ' + MODES[mode];
      });
      mk('LOOP', b => { video.loop = !video.loop; b.textContent = video.loop ? 'LOOP' : 'ONCE'; });
      bar.appendChild(status);

      body.appendChild(pane);
      body.appendChild(bar);

      let sized = false;
      const size = () => {
        const W = video.videoWidth || 320, H = video.videoHeight || 240;
        const s = Math.min(1, VID.maxDim / Math.max(W, H));
        cv.width = work.width = Math.max(2, Math.round(W * s));
        cv.height = work.height = Math.max(2, Math.round(H * s));
        sized = true;
      };

      video.addEventListener('loadedmetadata', () => { size(); video.play().catch(() => {}); });
      video.addEventListener('error', () => {
        status.textContent = 'CANNOT DECODE THIS ONE';
        Snd.err();
      });

      let last = 0, frames = 0, fpsAt = 0, shown = 0;
      const tick = ts => {
        if (!alive || !document.body.contains(cv)) { alive = false; return; }
        raf = requestAnimationFrame(tick);
        if (!sized && video.videoWidth) size();
        if (!sized || video.readyState < 2) return;
        if (ts - last < 1000 / VID.fps) return;
        last = ts;
        const g = work.getContext('2d');
        const o = cv.getContext('2d');
        if (!g || !o) return;
        try { g.drawImage(video, 0, 0, work.width, work.height); }
        catch (e) { return; }
        if (mode === 1) {
          ditherBayer(g, work.width, work.height, 56);
        } else if (mode === 2) {
          const id = g.getImageData(0, 0, work.width, work.height);
          const d = id.data;
          for (let i = 0; i < d.length; i += 4) {
            const y = (d[i] * 0.30 + d[i + 1] * 0.59 + d[i + 2] * 0.11);
            const q = y > 190 ? [85, 255, 85] : y > 120 ? [0, 170, 0] : y > 60 ? [0, 90, 0] : [0, 0, 0];
            d[i] = q[0]; d[i + 1] = q[1]; d[i + 2] = q[2];
          }
          g.putImageData(id, 0, 0);
        }
        o.drawImage(work, 0, 0);
        frames++;
        if (ts - fpsAt > 1000) { shown = frames; frames = 0; fpsAt = ts; }
        status.textContent = cv.width + 'x' + cv.height + '  ' + shown + ' FPS  ' +
                             (node.session ? 'SESSION' : 'ON DISK');
      };
      raf = requestAnimationFrame(tick);

      /* stop the decoder when the window goes away */
      const watch = setInterval(() => {
        if (document.body.contains(cv)) return;
        clearInterval(watch);
        alive = false;
        if (raf) cancelAnimationFrame(raf);
        try { video.pause(); video.src = ''; } catch (e) {}
      }, 1000);
    }
  });
}

/* ==========================================================================
   19. AFTEREGYPT
   --------------------------------------------------------------------------
   Terry's demo game: you are leaving Egypt and going to the temple. Fly the
   craft down the colonnade, do not hit a pillar, reach the third temple.
   ========================================================================== */
function openAfterEgypt() {
  createWindow({
    kind: 'app', title: 'AfterEgypt', w: 460, h: 360,
    build: body => {
      const wrap = document.createElement('div');
      wrap.className = 'gamepane';
      const cv = document.createElement('canvas');
      cv.width = 320; cv.height = 200;
      cv.className = 'gamecv';
      cv.tabIndex = 0;
      wrap.appendChild(cv);
      const bar = document.createElement('div');
      bar.className = 'appbar';
      const info = document.createElement('span');
      info.className = 'godword';
      info.textContent = 'ARROWS OR MOUSE. REACH THE TEMPLE.';
      bar.appendChild(info);
      body.appendChild(wrap);
      body.appendChild(bar);

      const g = cv.getContext('2d');
      if (!g) { info.textContent = 'NO CANVAS.'; return; }
      const C = i => { const p = VGA16[i]; return 'rgb(' + p[0] + ',' + p[1] + ',' + p[2] + ')'; };

      const S = { y: 100, vy: 0, dist: 0, goal: 2600, dead: false, won: false, t: 0 };
      let pillars = [];
      const keys = Object.create(null);
      let raf = null, alive = true;

      const reset = () => {
        S.y = 100; S.vy = 0; S.dist = 0; S.dead = false; S.won = false; S.t = 0;
        pillars = [];
        for (let i = 0; i < 7; i++) pillars.push({ x: 340 + i * 90, gap: 60 + Math.random() * 70, h: 44 + Math.random() * 24 });
      };
      reset();

      cv.addEventListener('keydown', e => {
        keys[e.key] = true;
        if (e.key === ' ' || e.key.indexOf('Arrow') === 0) e.preventDefault();
        if ((S.dead || S.won) && (e.key === ' ' || e.key === 'Enter')) { reset(); Snd.ok(); }
      });
      cv.addEventListener('keyup', e => { keys[e.key] = false; });
      cv.addEventListener('mousemove', e => {
        const r = cv.getBoundingClientRect();
        S.y = Math.max(10, Math.min(190, (e.clientY - r.top) / r.height * 200));
        S.vy = 0;
      });
      cv.addEventListener('mousedown', ev => { ev.stopPropagation(); cv.focus(); if (S.dead || S.won) reset(); });
      wrap.addEventListener('mousedown', () => setTimeout(() => cv.focus(), 0));
      setTimeout(() => cv.focus(), 30);

      const stars = [];
      for (let i = 0; i < 40; i++) stars.push({ x: Math.random() * 320, y: Math.random() * 200, s: 0.4 + Math.random() * 1.6 });

      const frame = () => {
        if (!alive || !document.body.contains(cv)) { alive = false; return; }
        raf = requestAnimationFrame(frame);
        S.t++;

        if (!S.dead && !S.won) {
          if (keys.ArrowUp || keys.w) S.vy -= 0.55;
          if (keys.ArrowDown || keys.s) S.vy += 0.55;
          S.vy *= 0.90;
          S.vy += 0.10;                                  /* it wants to sink */
          S.y += S.vy;
          if (S.y < 8) { S.y = 8; S.vy = 0; }
          if (S.y > 192) { S.y = 192; S.vy = 0; }
          S.dist += 2.4;
          if (S.dist >= S.goal) {
            S.won = true;
            Snd.holy();
            /* the one payout moment this game already had */
            Economy.earn(50, 'AFTEREGYPT: THE THIRD TEMPLE');
          }
          pillars.forEach(p => {
            p.x -= 2.4;
            if (p.x < -30) { p.x += 7 * 90; p.gap = 55 + Math.random() * 75; p.h = 40 + Math.random() * 30; }
            if (!S.won && p.x < 46 && p.x > 14) {
              const top = 100 - p.gap / 2, bot = 100 + p.gap / 2;
              if (S.y < top || S.y > bot) { S.dead = true; Snd.err(); Snd.thunk(); }
            }
          });
        }

        /* phosphor: never fully clear, so everything drags a tail */
        g.fillStyle = 'rgba(0,0,0,' + (0.30 + (1 - phosLevel()) * 0.6) + ')';
        g.fillRect(0, 0, 320, 200);

        stars.forEach(s => {
          if (!S.dead && !S.won) s.x -= s.s;
          if (s.x < 0) { s.x = 320; s.y = Math.random() * 200; }
          g.fillStyle = s.s > 1.2 ? C(15) : C(8);
          g.fillRect(s.x | 0, s.y | 0, 1, 1);
        });

        /* sand */
        g.fillStyle = C(6);
        g.fillRect(0, 186, 320, 14);
        g.fillStyle = C(14);
        for (let x = 0; x < 320; x += 8) g.fillRect(x, 186 + ((x + (S.dist | 0)) % 3), 3, 1);

        pillars.forEach(p => {
          const top = 100 - p.gap / 2, bot = 100 + p.gap / 2;
          g.fillStyle = C(7);
          g.fillRect(p.x, 0, 16, top);
          g.fillRect(p.x, bot, 16, 200 - bot);
          g.fillStyle = C(15);
          g.fillRect(p.x, 0, 3, top);
          g.fillRect(p.x, bot, 3, 200 - bot);
          g.fillStyle = C(8);
          g.fillRect(p.x + 13, 0, 3, top);
          g.fillRect(p.x + 13, bot, 3, 200 - bot);
          g.fillStyle = C(14);
          g.fillRect(p.x - 2, top - 5, 20, 5);
          g.fillRect(p.x - 2, bot, 20, 5);
        });

        /* the temple at the end of the road */
        const tx = 330 + (S.goal - S.dist) * 0.42;
        if (tx < 330) {
          g.fillStyle = C(14);
          for (let s = 0; s < 5; s++) g.fillRect(tx - s * 6, 150 - s * 8, 12 + s * 12, 8);
          g.fillRect(tx + 10, 100, 4, 12);
          g.fillRect(tx + 6, 103, 12, 4);
          g.fillStyle = C(3);
          g.fillRect(tx - 6, 158, 48, 28);
          g.fillStyle = C(7);
          for (let c = 0; c < 5; c++) g.fillRect(tx - 4 + c * 10, 158, 5, 28);
        }

        /* the craft */
        if (!S.dead) {
          g.fillStyle = C(11);
          g.fillRect(22, S.y - 2, 14, 4);
          g.fillStyle = C(15);
          g.fillRect(34, S.y - 1, 4, 2);
          g.fillStyle = C(12);
          g.fillRect(16, S.y - 1, 6, 2);
          if (S.t % 3) { g.fillStyle = C(14); g.fillRect(12, S.y, 4, 1); }
        } else {
          g.fillStyle = C(4 + (S.t >> 2) % 2 * 8);
          g.fillRect(20, S.y - 4, 16, 8);
        }

        g.fillStyle = C(15);
        g.font = '10px monospace';
        const pct = Math.min(100, Math.round(S.dist / S.goal * 100));
        g.fillText('TO THE TEMPLE ' + pct + '%', 6, 12);
        if (S.dead) { g.fillStyle = C(12); g.fillText('YOU DID NOT ARRIVE. SPACE TO TRY AGAIN.', 30, 100); }
        if (S.won) { g.fillStyle = C(14); g.fillText('YOU REACHED THE THIRD TEMPLE.', 60, 100); }
      };
      raf = requestAnimationFrame(frame);
      const watch = setInterval(() => {
        if (document.body.contains(cv)) return;
        clearInterval(watch); alive = false;
        if (raf) cancelAnimationFrame(raf);
      }, 1000);
    }
  });
}

