/* ---- 24.1 phosphor ------------------------------------------------------
   P1 phosphor decayed in microseconds; P7 smeared for the better part of a
   second, which is why old radar sets used it. The knob sets a CSS variable
   that widens the glow on every lit character, and the same number sets how
   little the canvas apps clear between frames, so the starfield, the game
   and the doodle all drag their own tails. */
const PHOS_NAME = ['P1', 'P4', 'P7'];
const PHOS_GLOW = [0, 0.45, 1];
function phosLevel() { return PHOS_GLOW[CRT.phos || 0]; }

function applyPhosphor() {
