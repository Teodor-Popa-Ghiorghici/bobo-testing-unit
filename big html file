/* ==========================================================================
   1. PIXEL IMAGE HELPER
   Builds a tiny flat-color SVG and returns it as a data: URI, so the page
   stays fully self-contained. Only palette colors are used.
   ========================================================================== */
function pixelBMP(w, h, paint) {
  let rects = '';
  const px = (x, y, ww, hh, c) => {
    rects += '<rect x="' + x + '" y="' + y + '" width="' + ww + '" height="' + hh + '" fill="' + c + '"/>';
  };
  paint(px);
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h + '" ' +
    'viewBox="0 0 ' + w + ' ' + h + '" shape-rendering="crispEdges">' +
    '<rect width="' + w + '" height="' + h + '" fill="#000000"/>' + rects + '</svg>';
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}

/* Two pre-made 16-color "bitmaps" used by the FS below. */
