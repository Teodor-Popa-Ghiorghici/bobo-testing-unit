  POST_LINES.forEach(put);
  const mem = put('Memory Test: 000000 KB');
  const hint = put('');
  hint.className = 'biosdel';

  let k = 0;
  let delHeld = false;
  const onKey = e => { if (e.key === 'Delete' || e.key === 'Del') delHeld = true; };
  window.addEventListener('keydown', onKey);
  hint.textContent = 'Press DEL to enter SETUP';

  clearInterval(postTimer);
  postTimer = setInterval(() => {
    k += 64;
    if (k > 640) k = 640;
    mem.textContent = 'Memory Test: ' + String(k).padStart(6, '0') + ' KB' + (k >= 640 ? ' OK' : '');
    Snd.tone(1400 + k, 6, { vol: 0.012 });
    if (k < 640) return;
    clearInterval(postTimer);
    window.removeEventListener('keydown', onKey);
    put('');
    put('Fixed Disk 0: TEMPLE  640K');
    put('CD-ROM      : OK');
    put('Network     : none installed');
    put('');
    put('Booting ::/AutoExec.HC ...');
    setTimeout(() => {
      if (!postDone) return;                 /* somebody already skipped it */
      postDone = null;
      host.style.display = 'none';
      splash.classList.remove('posting');
      if (delHeld) openCmos();
      done();
    }, 620);
  }, 55);
}

