/* ---- 40.1 FORMAT --------------------------------------------------------
   Typed on the desktop with nothing focused. There is no menu entry for it
   and there is not going to be one.
   ========================================================================== */
let formatBuf = '';
window.addEventListener('keydown', ev => {
  if (!splashGone()) return;
  const t = ev.target;
  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
  if (document.activeElement && document.activeElement !== document.body) return;
  if (!/^[a-zA-Z]$/.test(ev.key)) { formatBuf = ''; return; }
  formatBuf = (formatBuf + ev.key.toUpperCase()).slice(-6);
  if (formatBuf !== 'FORMAT') return;
  formatBuf = '';
  sysDialog('FORMAT ::/ ?',
    'THIS ERASES EVERY SAVED THING ON THIS MACHINE:\n' +
    'SUN AND THE LEDGER, EVERYTHING BOUGHT FROM DAVE,\nTHE GARDEN, THE STATISTICS, THE DRAWINGS,\n' +
    'THE UPLOADS, THE NOTES AND THE ICON POSITIONS.\n\nTHERE IS NO UNDO. THERE IS NO BACKUP.',
    {
      confirm: true, okLabel: 'FORMAT', w: 470, h: 250,
      onOk: () => {
        try {
          const kill = [];
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.indexOf('templeos.') === 0) kill.push(k);
          }
          kill.forEach(k => localStorage.removeItem(k));
        } catch (e) {}
        Vault.keys().then(ks => {
          const done = () => { try { location.reload(); } catch (e) {} };
          try { Promise.all(ks.map(k => Vault.del(k))).then(done, done); } catch (e) { done(); }
        }, () => { try { location.reload(); } catch (e) {} });
        toast('FORMATTING. THE MACHINE WILL COME BACK EMPTY.');
      }
    });
});

/* ==========================================================================
   41. BRINGING IT ONLINE
   --------------------------------------------------------------------------
   Every subsystem above reads its own key off the disk here, before the
   splash has finished, so the frame, the logo and the pointer are right on
   the first painted frame and the garden has already counted what it grew
   while the machine was off.
   ========================================================================== */
Sweeper.boot();
Solitaire.boot();
Crayon.boot();
Garden.boot();
Cos.boot();

/* the POST lists what is installed, and this machine now has more in it */
POST_LINES.push(
  'ZEN GARDEN CO-PROCESSOR ....... OK',
  'HOLLOW SWEEPER SEISMOGRAPH .... OK',
  'LANE ARBITRATION UNIT ......... OK',
  'WAX FEED AND PAPER TRANSPORT .. OK',
  'SUN LEDGER .................... ' + Economy.balance() + ' ON HAND',
  ''
);

/* a line on the boot screen only when the garden actually grew something */
(function () {
  const waiting = Garden.tokens();
  if (waiting > 0) {
    BOOT_LINES.splice(BOOT_LINES.length - 1, 0,
      ['Garden: ' + waiting + ' token' + (waiting === 1 ? '' : 's') + ' waiting in the soil', 'g']);
  }
})();

/* everything that needs the desktop to exist. bootExtras is wrapped rather
   than edited: the original still runs first, in the same order it did. */
const bootExtras0 = bootExtras;
bootExtras = function () {
  bootExtras0();
  try { SunUI.mount(); } catch (e) {}
  try { applyDisplay(); } catch (e) {}
  try { Cos.applyAll(); } catch (e) {}
  /* the garden keeps counting while its window is shut, so it is caught up
     once a minute rather than only when you open it */
  setInterval(() => { if (!Garden.live) Garden.catchUp(); }, 60000);
  window.addEventListener('beforeunload', () => {
    try { Garden.st.lastTick = Date.now(); sysSaveNow(GARD_KEY, Garden.st); } catch (e) {}
    try { Economy.flush(); } catch (e) {}
  });
};

