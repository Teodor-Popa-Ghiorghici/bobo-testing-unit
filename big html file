  [[4,4],[12,9],[22,3],[38,6],[52,4],[58,12],[30,10],[46,15],[8,18],[60,22]]
    .forEach(p => px(p[0], p[1], 1, 1, '#FFFFFF'));
  px(31, 6, 2, 5, '#FFFF55');           // cross
  px(29, 7, 6, 2, '#FFFF55');
  for (let i = 0; i < 5; i++) px(28 - i*5, 12 + i*2, 8 + i*10, 2, '#FFFF55'); // pediment
  px(6, 22, 52, 3, '#FFFFFF');          // architrave
  px(24, 25, 16, 14, '#00AAAA');        // inner light
  [10, 20, 30, 40, 50].forEach(x => {   // columns
    px(x, 25, 5, 14, '#AAAAAA');
    px(x, 25, 1, 14, '#FFFFFF');
    px(x + 4, 25, 1, 14, '#555555');
  });
  px(4, 39, 56, 3, '#AAAAAA');          // steps
  px(2, 42, 60, 3, '#555555');
  px(0, 45, 64, 3, '#AAAAAA');
});

const IMG_GLYPH = pixelBMP(16, 16, px => {
  px(0, 0, 16, 16, '#0000AA');
