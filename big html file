          g.fillStyle = C(15); g.fillRect(px + 3, py + 3, 14, 5);                                   /* pillow */
          g.fillStyle = C(9); g.fillRect(px + 3, py + 9, 14, 8);                                    /* blanket */
          g.fillStyle = C(11); g.fillRect(px + 3, py + 9, 14, 1); g.fillRect(px + 3, py + 13, 14, 1);
