function spriteFor(node) {
  if (node.type === 'folder')   return SPRITES.folder;
  if (node.type === 'image')    return SPRITES.image;
  if (node.type === 'video')    return SPRITES.video;
  if (node.type === 'terminal') return SPRITES.terminal;
  if (node.type === 'app') {
    if (node.app === 'hifi')   return SPRITES.disc;
    if (node.app === 'notes')  return SPRITES.notes;
    if (node.app === 'bottle') return SPRITES.bottle;
    if (node.app === 'elephant') return SPRITES.elephant;
    if (node.app === 'magen')    return SPRITES.magen;
    if (node.app === 'cook')     return SPRITES.flask;
    if (node.app === 'garden') return SPRITES.garden;
    if (node.app === 'sweeper') return SPRITES.sweeper;
    if (node.app === 'solitaire') return SPRITES.solitaire;
    if (node.app === 'crayon') return SPRITES.crayon;
    if (node.app === 'shop') return SPRITES.shop;
    if (node.app === 'drawings') return SPRITES.drawings;
    if (node.app === 'account') return SPRITES.account;
    return SPRITES.app;
  }
  if (node.type === 'doc')      return SPRITES.doc;
  if (node.type === 'code')     return SPRITES.code;
  return SPRITES.text;
}

/* anything that holds editable prose or source */
function isTextish(n) {
  return n && (n.type === 'text' || n.type === 'doc' || n.type === 'code');
}

/* ==========================================================================
   5. BOOT SEQUENCE
   ========================================================================== */
const PALETTE = ['#FFFF55','#55FF55','#55FFFF','#FF55FF','#FF5555','#FFFFFF','#5555FF'];

const BOOT_LINES = [
  ['TempleOS V5.03', 'w'],
  ['Public Domain. God\'s Third Temple.', 'y'],
  ['Loading Adam (task 0)...', 'g'],
  ['Spawning Seth...', 'g'],
  ['Mem: 640K OK', 'g'],
  ['HolyC JIT Ready', 'g'],
  ['DolDoc Ready', 'g'],
  ['Ring 0. No user mode. No network.', 'y'],
  ['Press Any Key', 'w']
];

(function drawWordmark() {
  const wm = document.getElementById('wordmark');
  'TempleOS'.split('').forEach((ch, i) => {
    const s = document.createElement('span');
    s.textContent = ch;
    s.dataset.i = i;
    wm.appendChild(s);
  });
  let t = 0;
  setInterval(() => {
    t++;
    wm.querySelectorAll('span').forEach((s, i) => {
      s.style.color = PALETTE[(i + t) % PALETTE.length];
    });
  }, 220);
})();

let bootDone = false;
let bootTimer = null;

function runBoot() {
  /* the machine counts its own memory before it says anything else */
  runPost(() => runBootLines());
}

function runBootLines() {
  const box = document.getElementById('bootlines');
  box.innerHTML = '';
  bootDone = false;
  clearTimeout(bootTimer);
  let i = 0;
  const step = () => {
    if (i >= BOOT_LINES.length) {
      const cur = document.createElement('span');
      cur.id = 'bootcursor';
      cur.className = 'blink';
      cur.textContent = '\u2588';
      box.lastChild.appendChild(cur);
      bootDone = true;
      refreshBootHint();
      return;
    }
    const d = document.createElement('div');
    d.className = 'bootline ' + BOOT_LINES[i][1];
    d.textContent = BOOT_LINES[i][0];
    box.appendChild(d);
    i++;
    bootTimer = setTimeout(step, 150);
  };
  bootTimer = setTimeout(step, 400);
}
/* deferred a tick: the POST reads tables declared further down the file */
setTimeout(runBoot, 0);

let desktopBuilt = false;

function dismissSplash() {
  const sp = document.getElementById('splash');
  if (!sp || sp.style.display === 'none') return;
  if (!CRT.on) return;                    /* the monitor is off */
  if (sp.classList.contains('posting')) { postSkip(); Snd.click(); return; }
  sp.style.display = 'none';
  document.getElementById('shell').style.display = 'block';
  Snd.wake();
  if (desktopBuilt) { Snd.ok(); return; } /* coming back from a power cycle */
  desktopBuilt = true;
  /* pull saved uploads back into the tree first, then draw */
  upRestore().then(buildDesktop, buildDesktop);
}

function bootHint(msg) {
  const box = document.getElementById('bootlines');
  if (!box) return;
  let h = document.getElementById('boothint');
  if (!h) {
    h = document.createElement('div');
    h.id = 'boothint';
    box.appendChild(h);
  }
  h.textContent = msg;
}

/* The machine ships silent. Say so, until somebody turns something up. */
function refreshBootHint() {
  if (splashGone() || !bootDone) return;
  bootHint(Vol.sfx > 0 || (Vol.lobby && Vol.mus > 0)
    ? 'PRESS ANY KEY'
    : 'SPEAKER IS COLD \u2014 TURN MUS AND SFX UP, BOTTOM RIGHT');
}

window.addEventListener('keydown', e => { if (!splashGone()) { e.preventDefault(); dismissSplash(); } });
document.getElementById('splash').addEventListener('mousedown', dismissSplash);
function splashGone() { return document.getElementById('splash').style.display === 'none'; }

/* A browser will not make a sound until someone has clicked something, so the
   speaker resumes on the first gesture anywhere — including the first grab
   of a knob, which is the whole point of the panel. */
document.addEventListener('pointerdown', () => { try { Snd.wake(); } catch (e) {} }, true);
document.addEventListener('keydown',     () => { try { Snd.wake(); } catch (e) {} }, true);

/* ==========================================================================
   6. WINDOW MANAGER
   ========================================================================== */
let zTop = 100;
let cascadeN = 0;
const openWins = [];

const TITLE_COLORS = {
  folder:   { bar: '#55FFFF', border: '#00AAAA' },
  text:     { bar: '#FFFF55', border: '#AA5500' },
  doc:      { bar: '#55FF55', border: '#00AA00' },
  image:    { bar: '#FF55FF', border: '#AA00AA' },
  video:    { bar: '#FF5555', border: '#AA0000' },
  app:      { bar: '#FF55FF', border: '#AA00AA' },
  panic:    { bar: '#FF5555', border: '#FF5555' },
  terminal: { bar: '#AAAAAA', border: '#FFFFFF' }
};

function nextCascade(w, h) {
  const desk = document.getElementById('desktop');
  const maxX = Math.max(10, desk.clientWidth  - w - 10);
  const maxY = Math.max(10, desk.clientHeight - h - 10);
  const x = Math.min(120 + cascadeN * 25, maxX);
  const y = Math.min(30  + cascadeN * 25, maxY);
  cascadeN = (cascadeN + 1) % 9;
  return { x: x, y: y };
}

function raise(win) {
  zTop++;
  win.style.zIndex = zTop;
  openWins.forEach(o => o.btn.classList.toggle('active', o.win === win));
}

function createWindow(opts) {
  const desk = document.getElementById('desktop');
  const w = Math.min(opts.w, desk.clientWidth  - 20);
  const h = Math.min(opts.h, desk.clientHeight - 20);

  const win = document.createElement('div');
  win.className = 'win';
  win.style.width = w + 'px';
  win.style.height = h + 'px';
  const pos = nextCascade(w, h);
  win.style.left = pos.x + 'px';
  win.style.top  = pos.y + 'px';

  if (opts.kind === 'panic') win.classList.add('panic');
  const skin = TITLE_COLORS[opts.kind] || TITLE_COLORS.text;
  win.style.borderColor = skin.border;

  const bar = document.createElement('div');
  bar.className = 'titlebar';
  bar.style.background = skin.bar;

  const t = document.createElement('span');
  t.className = 't';
  t.textContent = opts.title;

  const mbtn = document.createElement('span');
  mbtn.className = 'm';
  mbtn.textContent = '[_]';

  const x = document.createElement('span');
  x.className = 'x';
  x.textContent = '[X]';

  bar.appendChild(t);
  bar.appendChild(mbtn);
  bar.appendChild(x);

  const body = document.createElement('div');
  body.className = 'wbody';
  if (opts.build) opts.build(body);

  const grip = document.createElement('div');
  grip.className = 'grip';

  win.appendChild(bar);
  win.appendChild(body);
  win.appendChild(grip);
  desk.appendChild(win);

  /* taskbar button: raise, or minimize the window that is already on top */
  const btn = document.createElement('div');
  btn.className = 'tbtn';
  btn.textContent = opts.title;
  document.getElementById('tasks').appendChild(btn);

  function minimize() {
    win.classList.add('hidden');
    btn.classList.add('min');
    btn.classList.remove('active');
    Snd.min();
  }
  function unminimize() {
    win.classList.remove('hidden');
    btn.classList.remove('min');
    raise(win);
    Snd.open();
  }
  mbtn.addEventListener('mousedown', ev => { ev.stopPropagation(); minimize(); });
  btn.addEventListener('mousedown', () => {
    if (win.classList.contains('hidden')) unminimize();
    else if (btn.classList.contains('active')) minimize();
    else { raise(win); Snd.select(); }
  });

  /* every window is a task, and every task is a child of Seth */
  const rec = { win: win, btn: btn, title: opts.title, kind: opts.kind || 'text',
                id: nextTaskId(), born: Date.now(), close: null };
  openWins.push(rec);

  /* raise on any click inside */
  win.addEventListener('mousedown', () => raise(win));

  /* close */
  function closeWin() {
    win.remove();
    btn.remove();
    const i = openWins.indexOf(rec);
    if (i >= 0) openWins.splice(i, 1);
    Snd.close();
  }
  rec.close = closeWin;
  x.addEventListener('mousedown', ev => { ev.stopPropagation(); closeWin(); });

  /* drag by the title bar. Coordinates go through the desktop's own rect,
     because the desktop is now inset inside the monitor. */
  let dragging = false, offX = 0, offY = 0;
  bar.addEventListener('mousedown', ev => {
    if (ev.target === x || ev.target === mbtn) return;
    const r = desk.getBoundingClientRect();
    dragging = true;
    offX = ev.clientX - r.left - win.offsetLeft;
    offY = ev.clientY - r.top  - win.offsetTop;
    Snd.grab();
    ev.preventDefault();
  });

  /* resize from the bottom right corner */
  let sizing = false, sx = 0, sy = 0, sw = 0, sh = 0;
  grip.addEventListener('mousedown', ev => {
    ev.stopPropagation();
    ev.preventDefault();
    sizing = true;
    sx = ev.clientX; sy = ev.clientY;
    sw = win.offsetWidth; sh = win.offsetHeight;
    raise(win);
    Snd.grab();
  });

  document.addEventListener('mousemove', ev => {
    if (dragging) {
      const r = desk.getBoundingClientRect();
      const maxX = desk.clientWidth  - 40;
      const maxY = desk.clientHeight - 24;
      const nx = Math.max(-(win.offsetWidth - 60), Math.min(ev.clientX - r.left - offX, maxX));
      const ny = Math.max(0, Math.min(ev.clientY - r.top - offY, maxY));
      win.style.left = nx + 'px';
      win.style.top  = ny + 'px';
    } else if (sizing) {
      const nw = Math.max(180, Math.min(sw + ev.clientX - sx, desk.clientWidth  - win.offsetLeft));
      const nh = Math.max(90,  Math.min(sh + ev.clientY - sy, desk.clientHeight - win.offsetTop));
      win.style.width  = nw + 'px';
      win.style.height = nh + 'px';
    }
  });
  document.addEventListener('mouseup', () => {
    if (dragging || sizing) Snd.drop();
    dragging = false;
    sizing = false;
  });

  raise(win);
  Snd.open();
  return { win: win, body: body, title: t, btn: btn, close: closeWin };
}

/* ==========================================================================
   7. ICON GRIDS + OPENING NODES
   ========================================================================== */
function makeIcon(node, onOpen) {
  const el = document.createElement('div');
  el.className = 'icon';
  el.innerHTML = spriteFor(node);
  const lbl = document.createElement('div');
  const span = document.createElement('span');
  span.className = 'lbl';
  span.textContent = node.name;
  lbl.appendChild(span);
  el.appendChild(lbl);

  el.addEventListener('click', ev => {
    ev.stopPropagation();
    if (el.dataset.desk) return;      /* the desktop runs its own selection */
    if (!el.classList.contains('sel')) Snd.select();
    document.querySelectorAll('.icon.sel').forEach(n => n.classList.remove('sel'));
    el.classList.add('sel');
  });
  el.addEventListener('dblclick', ev => {
    ev.stopPropagation();
    onOpen();
  });

  /* right click: open / upload into / delete */
  el.addEventListener('contextmenu', ev => {
    ev.preventDefault();
    ev.stopPropagation();
    document.querySelectorAll('.icon.sel').forEach(n => n.classList.remove('sel'));
    el.classList.add('sel');
    const items = [{ label: 'OPEN', run: onOpen }];
    if (node.type === 'folder') {
      items.push({ label: 'UPLOAD IMAGES HERE...', run: () => {
        lastFolder = node;
        document.getElementById('pickimg').click();
      }});
    }
    if (node.type === 'image') {
      items.push({ label: 'SET AS BACKGROUND',  run: () => setWallpaper(node, 'fill') });
      items.push({ label: 'TILE AS BACKGROUND', run: () => setWallpaper(node, 'tile') });
    }
    if (isTextish(node)) {
      items.push({ label: 'COMPILE', run: () => openCompile(node) });
      if (node.type === 'code') items.push({ label: 'RUN IT', run: () => runFileHolyC(node) });
    }
    if (node.type === 'video') {
      items.push({ label: 'SET AS BACKGROUND', run: () => setWallpaper(node, 'fill') });
    }
    items.push({ sep: true });
    if (node.user) items.push({ label: 'DELETE', run: () => deleteNode(node) });
    else           items.push({ label: 'SYSTEM FILE. LOCKED.', off: true });
    showMenu(document.getElementById('ctxmenu'), ev.clientX, ev.clientY, items);
  });

  /* a folder icon accepts a file dropped straight onto it */
  if (node.type === 'folder') wireDrop(el, () => node);

  return el;
}

function openNode(node, path) {
  if (!node) return;
  path = path || node._path;
  if (node.type === 'folder')   return openFolder(node, path);
  if (node.type === 'doc')      return openDoc(node, path);
  if (node.type === 'text')     return openText(node, path);
  if (node.type === 'code')     return openText(node, path);
  if (node.type === 'image')    return openImage(node, path);
  if (node.type === 'video')    return openVideo(node, path);
  if (node.type === 'app')      return runApp(node.app, node.name);
  if (node.type === 'terminal') return openTerminal();
}

function openFolder(node, path) {
  createWindow({
    kind: 'folder',
    title: node._path || path,
    w: 460, h: 300,
    build: body => {
      const pane = document.createElement('div');
      pane.className = 'folderpane';

      /* redrawn whenever the tree under this folder changes */
      const render = () => {
        pane.innerHTML = '';
        if (!node.children || node.children.length === 0) {
          const e = document.createElement('div');
          e.className = 'emptynote';
          e.textContent = 'FOLDER EMPTY. DROP AN IMAGE HERE.';
          pane.appendChild(e);
        } else {
          node.children.forEach(child => {
            pane.appendChild(makeIcon(child, () => {
              openNode(child, child._path || (String(path).replace(/\/$/, '') + '/' + child.name));
            }));
          });
        }
      };
      render();
      folderPanes.push({ pane: pane, render: render });
      wireDrop(pane, () => node);

      pane.addEventListener('click', () => {
        pane.querySelectorAll('.icon.sel').forEach(n => n.classList.remove('sel'));
      });
      /* remember where an upload should land */
      pane.addEventListener('mousedown', () => { lastFolder = node; });
      body.appendChild(pane);
    }
  });
  lastFolder = node;
}

function openText(node, path) {
  lastText = node;
  createWindow({
    kind: 'text',
    title: node._path || path,
    w: 480, h: 320,
    build: body => {
      const ta = document.createElement('textarea');
      ta.className = 'editor';
      ta.spellcheck = false;
      ta.value = node.content || '';
      /* write edits straight back into the FS object, then to disk */
      ta.addEventListener('input', () => {
        node.content = ta.value;
        queueSave(node);
      });
      ta.addEventListener('mousedown', () => { lastText = node; Snd.select(); });
      ta.addEventListener('keydown', ev => {
        if (ev.key === 'Enter') Snd.enter();
        else if (ev.key.length === 1 || ev.key === 'Backspace') Snd.type();
      });
      body.appendChild(ta);
    }
  });
}

/* ---- the compiler ------------------------------------------------------- */
function compileNode(node, print) {
  const src = String(node.content || '');
  const lines = src.split('\n');
  const stmts = lines.filter(l => {
    const t = l.trim();
    return t.length && t.slice(0, 2) !== '//';
  }).length;
  const bytes = src.length;
  const base = 0x104000 + ((bytes * 7919) % 0x9000);
  const emitted = Math.max(16, Math.round(stmts * 11.3 + bytes * 0.4));

  print(['HOLYC JIT — ' + (node._path || node.name), ''], 'l-dim');
  print(['  LEX     ' + lines.length + ' LINE(S), ' + commas(bytes) + ' BYTE(S)',
         '  PARSE   ' + stmts + ' STATEMENT(S)',
         '  EMIT    0x' + base.toString(16).toUpperCase().padStart(16, '0') +
           '   ' + commas(emitted) + ' BYTES'], 'l-ok');

  if (!/\.HC$/i.test(node.name)) {
    print(['  WARN    ' + node.name + ' IS NOT .HC. COMPILING IT ANYWAY.'], 'l-err');
  }
  if (!stmts) {
    print(['  ERROR   NOTHING TO COMPILE. THE FILE IS EMPTY.', ''], 'l-err');
    Snd.err();
    return;
  }
  print(['', 'COMPILES CLEAN. NO WARNINGS. NO LINKER.', 'NO INTERCESSOR.'], 'l-holy');
  Snd.bell();
}

/* Compile from the menubar gets its own little output window. */
function openCompile(node) {
  if (!isTextish(node)) {
    toast('NOTHING TO COMPILE. OPEN A TEXT FILE FIRST.');
    Snd.err();
    return;
  }
  createWindow({
    kind: 'terminal',
    title: 'COMPILE ' + (node._path || node.name),
    w: 520, h: 260,
    build: body => {
      const term = document.createElement('div');
      term.className = 'term';
      const out = document.createElement('div');
      out.className = 'termout';
      term.appendChild(out);
      body.appendChild(term);
      const print = (rows, cls) => {
        rows.forEach(txt => {
          const d = document.createElement('div');
          d.className = cls;
          d.textContent = txt;
          out.appendChild(d);
        });
        out.scrollTop = out.scrollHeight;
      };
      compileNode(node, print);
    }
  });
}

function openImage(node, path) {
  createWindow({
    kind: 'image',
    title: path,
    w: 360, h: 300,
    build: body => {
      const pane = document.createElement('div');
      pane.className = 'imgpane';
      const img = document.createElement('img');
      img.src = node.src;
      img.alt = node.name;
      pane.appendChild(img);
      body.appendChild(pane);
    }
  });
}

/* ==========================================================================
   8. TERMINAL
   ========================================================================== */
function pick(list) { return list[Math.floor(Math.random() * list.length)]; }

/* Walk a path spec against the tree. Accepts C:/HOME, /HOME, ../APPS, NAME. */
function termResolve(cwd, spec) {
  let node = cwd;
  let s = String(spec || '').replace(/\\/g, '/').trim();
  if (s.slice(0, 2) === '::') { node = FS; s = s.slice(2); }
  else if (/^C:/i.test(s)) { node = FS; s = s.slice(2); }   /* old habits */
  else if (s.charAt(0) === '/') { node = FS; }
  const parts = s.split('/').filter(p => p.length);
  for (const p of parts) {
    if (p === '.') continue;
    if (p === '..') { node = parentOf(node) || FS; continue; }
    if (!node.children) return null;
    const hit = node.children.filter(c => c.name.toUpperCase() === p.toUpperCase())[0];
    if (!hit) return null;
    node = hit;
  }
  return node;
}

function nodeBytes(node) {
  if (isTextish(node))       return (node.content || '').length;
  if (node.type === 'app')   return 4096;
  if (node.type === 'image' || node.type === 'video') {
    return node.bytes || Math.round((node.src || '').length * 0.75);
  }
  if (node.type === 'folder') {
    return (node.children || []).reduce((a, c) => a + nodeBytes(c), 0);
  }
  return 0;
}

function commas(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

function stamp() {
  const d = new Date();
  const p = n => String(n).padStart(2, '0');
  const h = d.getHours();
  return p(d.getMonth() + 1) + '-' + p(d.getDate()) + '-' + p(d.getFullYear() % 100) +
         '  ' + String(h % 12 || 12).padStart(2, ' ') + ':' + p(d.getMinutes()) +
         (h < 12 ? 'a' : 'p');
}

function openTerminal() {
  createWindow({
    kind: 'terminal',
    title: 'TERMINAL.HC',
    w: 560, h: 340,
    build: body => {
      const term = document.createElement('div');
      term.className = 'term';

      const out = document.createElement('div');
      out.className = 'termout';

      let cwd = FS;

      const line = document.createElement('div');
      line.className = 'termline';
      line.innerHTML =
        '<span class="p">::/&gt;</span><span class="typed"></span>' +
        '<span class="cur blink">\u2588</span>';

      const input = document.createElement('input');
      input.className = 'terminput';
      input.spellcheck = false;
      input.autocomplete = 'off';
      line.appendChild(input);

      term.appendChild(out);
      term.appendChild(line);
      body.appendChild(term);

      const typed = line.querySelector('.typed');

      /* Every command answers with exactly one sound, picked from the
         loudest class it printed: a verdict, not a stream of beeps. */
      let verdict = null;
      const RANK = { 'l-holy': 3, 'l-err': 2, 'l-ok': 1 };

      function print(lines, cls) {
        if (RANK[cls] && RANK[cls] > (RANK[verdict] || 0)) verdict = cls;
        lines.forEach(txt => {
          const d = document.createElement('div');
          d.className = cls;
          d.textContent = txt;
          out.appendChild(d);
        });
        out.scrollTop = out.scrollHeight;   /* auto-scroll to the bottom */
      }

      function sayVerdict() {
        if (verdict === 'l-holy') Snd.holy();
        else if (verdict === 'l-err') Snd.err();
        else if (verdict === 'l-ok') Snd.ok();
      }

      const prompt = line.querySelector('.p');
      const setPrompt = () => { prompt.textContent = (cwd._path || '::') + '>'; };
      setPrompt();

      /* banner */
      print(['TEMPLEOS TERMINAL — HOLYC JIT ACTIVE',
             'THE TREE IS LIVE. TYPE HELP.',
             'IT IS ALSO THE COMPILER: TRY  \"HELLO\\n\";', ''], 'l-dim');

      /* what you typed survives the window, the tab and the machine */
      const HIST_KEY = 'templeos.history.v1';
      let history = [];
      try { const r = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
            if (Array.isArray(r)) history = r.slice(-300); } catch (e) {}
      const histSave = () => { try { localStorage.setItem(HIST_KEY, JSON.stringify(history.slice(-300))); } catch (e) {} };
      let hpos = history.length;

      /* ---- commands that touch the real tree --------------------------- */
      function doDir(arg) {
        const node = termResolve(cwd, arg);
        if (!node) return print(['PATH NOT FOUND: ' + arg], 'l-err');
        if (node.type !== 'folder') return doType(arg);

        const kids = node.children || [];
        const lines = [' VOLUME IN :: IS TEMPLE', ' DIRECTORY OF ' + node._path, ''];
        let files = 0, dirs = 0, bytes = 0;

        kids.forEach(c => {
          const size = c.type === 'folder' ? '<DIR>' : commas(nodeBytes(c));
          if (c.type === 'folder') dirs++; else { files++; bytes += nodeBytes(c); }
          lines.push(' ' + c.name.padEnd(16) + size.padStart(9) + '   ' + stamp() +
                     (c.user ? '  *' : ''));
        });
        if (!kids.length) lines.push(' NO ENTRIES.');
        lines.push('');
        lines.push('     ' + String(files).padStart(4) + ' FILE(S) ' + commas(bytes).padStart(11) + ' BYTES');
        lines.push('     ' + String(dirs).padStart(4) + ' DIR(S)  ' +
                   commas(Math.max(0, 640000 - nodeBytes(FS))).padStart(11) + ' BYTES FREE');
        if (kids.some(c => c.user)) lines.push(' * = YOURS, NOT MINE.');
        print(lines, 'l-ok');
      }

      function doCd(arg) {
        if (!arg) return print([cwd._path], 'l-ok');
        const node = termResolve(cwd, arg);
        if (!node) return print(['PATH NOT FOUND: ' + arg], 'l-err');
        if (node.type !== 'folder') return print([node.name + ' IS NOT A DIRECTORY.'], 'l-err');
        cwd = node;
        setPrompt();
      }

      function doType(arg) {
        const node = termResolve(cwd, arg);
        if (!node) return print(['FILE NOT FOUND: ' + arg], 'l-err');
        if (node.type === 'image') {
          openNode(node, node._path);
          return print(['BINARY. OPENED IN A VIEWER INSTEAD.'], 'l-dim');
        }
        if (!isTextish(node)) return print([node.name + ' IS A DIRECTORY.'], 'l-err');
        const rows = String(node.content || '').split('\n');
        print(rows.slice(0, 200), 'l-dim');
        if (rows.length > 200) print(['-- TRUNCATED AT 200 LINES --'], 'l-err');
      }

      function doDel(arg) {
        const node = termResolve(cwd, arg);
        if (!node) return print(['FILE NOT FOUND: ' + arg], 'l-err');
        if (node === FS) return print(['YOU CANNOT DELETE THE ROOT.'], 'l-err');
        if (!node.user) return print([node.name + ' IS A SYSTEM FILE. LOCKED.'], 'l-err');
        if (containsNode(node, cwd)) cwd = parentOf(node) || FS;
        deleteNode(node);
        setPrompt();
        print(['DELETED ' + node.name + '.'], 'l-ok');
      }

      function doMd(arg) {
        if (!arg) return print(['MD NEEDS A NAME.'], 'l-err');
        addNode(cwd, { name: safeName(arg), type: 'folder', children: [] });
        upSave();
        refreshViews();
        print(['CREATED ' + safeName(arg) + ' IN ' + cwd._path + '.'], 'l-ok');
      }

      function doTree(node, depth, lines) {
        lines = lines || [node._path];
        (node.children || []).forEach(c => {
          lines.push('  '.repeat(depth + 1) + (c.type === 'folder' ? '+ ' : '  ') + c.name);
          if (c.type === 'folder') doTree(c, depth + 1, lines);
        });
        return lines;
      }

      function doCompile(arg) {
        const node = arg ? termResolve(cwd, arg) : (lastText || findNode('AutoExec.HC'));
        if (!isTextish(node)) {
          return print(['NOTHING TO COMPILE. OPEN A .HC OR NAME ONE.'], 'l-err');
        }
        compileNode(node, print);
      }

      /* ---- dispatch ---------------------------------------------------- */
      function runCommand(raw) {
        const s = raw.trim();
        verdict = null;
        print([(cwd._path || '::') + '>' + s], 'l-echo');
        if (!s) { out.scrollTop = out.scrollHeight; Snd.enter(); return; }

        const head = s.split(/\s+/)[0];
        const cmd = head.toUpperCase();
        /* these three make their own noise, so the verdict stays quiet */
        const owned = (cmd === 'BELL' || cmd === 'COMPILE');
        const arg = s.slice(head.length).trim();
        const q = s.toLowerCase();

        switch (cmd) {
          case 'DIR': case 'LS':          doDir(arg); break;
          case 'CD': case 'CHDIR':        doCd(arg); break;
          case 'TYPE': case 'CAT':        Snd.page(); doType(arg); break;
          case 'DEL': case 'RM':          doDel(arg); break;
          case 'MD': case 'MKDIR':        doMd(arg); break;
          case 'OPEN': case 'RUN': {
            const n = termResolve(cwd, arg);
            if (!n) print(['NOT FOUND: ' + arg], 'l-err');
            else {
              openNode(n, n._path);
              print(['OPENED ' + n.name + '.'], 'l-ok');
              verdict = null;              /* the window already announced itself */
            }
            break;
          }
          case 'TREE':                    print(doTree(cwd, 0), 'l-ok'); break;
          case 'COMPILE':                 doCompile(arg); break;
          case 'MEM':
            print([' CONVENTIONAL   640,000 BYTES',
                   ' IN USE       ' + commas(nodeBytes(FS)).padStart(11) + ' BYTES',
                   ' FREE         ' + commas(Math.max(0, 640000 - nodeBytes(FS))).padStart(11) + ' BYTES',
                   ' IT IS ENOUGH.'], 'l-ok');
            break;
          case 'BELL':                    Snd.bell(); print(['RUNG.'], 'l-holy'); break;
          case 'CLS': case 'CLEAR':       out.innerHTML = ''; Snd.click(); return;
          case 'PWD':                     print([cwd._path], 'l-ok'); break;
          case 'EXIT': case 'QUIT':       print(['THERE IS NOWHERE TO EXIT TO.'], 'l-holy'); break;

          default: {
            /* the rest of the command set: neofetch, the oracle, the games */
            if (runExtra(cmd, arg, s, { print: print, out: out, cwd: cwd })) {
              verdict = null;
              break;
            }
            /* then HolyC, because the shell IS the compiler */
            if (looksLikeHolyC(s)) { verdict = null; runHolyC(s, print); break; }
            /* and then the answering machine, which is the point of it */
            if (q.includes('god') || q.includes('temple')) print(pick(TERM.divine), 'l-holy');
            else if (q.includes('help') || q === '?')      print(pick(TERM.help), 'l-ok');
            else if (q.includes('hello') || q.includes('hi')) {
              print(pick(TERM.hello), 'l-ok');
              verdict = null;
              Snd.chirp();                 /* a greeting gets a greeting */
            }
            else if (s.length < 4)  print(pick(TERM.tooShort), 'l-err');
            else if (s.length > 40) print(pick(TERM.tooLong), 'l-err');
            else print(pick(TERM.unknown), 'l-err');
          }
        }
        print([''], 'l-dim');
        if (!owned) sayVerdict();
      }

      input.addEventListener('input', () => { typed.textContent = input.value; Snd.type(); });
      input.addEventListener('keydown', ev => {
        if (ev.key === 'Enter') {
          const v = input.value;
          Snd.enter();
          if (v.trim()) { history.push(v); hpos = history.length; histSave(); }
          runCommand(v);
          input.value = '';
          typed.textContent = '';
        } else if (ev.key === 'ArrowUp') {
          Snd.key();
          ev.preventDefault();
          if (hpos > 0) { hpos--; input.value = history[hpos]; typed.textContent = input.value; }
        } else if (ev.key === 'ArrowDown') {
          Snd.key();
          ev.preventDefault();
          if (hpos < history.length - 1) { hpos++; input.value = history[hpos]; }
          else { hpos = history.length; input.value = ''; }
          typed.textContent = input.value;
        }
      });
      term.addEventListener('mousedown', () => setTimeout(() => input.focus(), 0));
      setTimeout(() => input.focus(), 0);
    }
  });
}

/* ==========================================================================
   9. DESKTOP + MENU + CLOCK
   ========================================================================== */
/* the root of the FS, redrawn from scratch whenever it changes */
/* ---- the desktop as a desktop -------------------------------------------
   Icons carry their own coordinates, drag in groups, take a rubber band, and
   remember where they were put. Positions are keyed by name and saved, so
   rearranging survives a reload the way it would on a real machine.
   ========================================================================== */
const ICON_KEY = 'templeos.icons.v2';
const ICON_W = 100, ICON_H = 78;
let iconPos = {};                  /* name -> {x, y} */
let deskClickArmed = true;         /* a marquee must not clear its own result */

function deskIcons() {
  return Array.prototype.slice.call(document.querySelectorAll('#icons .icon'));
}
function clearIconSel() {
  deskIcons().forEach(n => n.classList.remove('sel'));
}
function selectedIcons() {
  return deskIcons().filter(n => n.classList.contains('sel'));
}
function saveIconPos() { kvSet(ICON_KEY, iconPos); }

/* ---- keeping the desk tidy ----------------------------------------------
   Two icons on the same square is one icon you cannot see, and a new file
   landing under an open window is a file you will not find. So every
   placement — first build, drop, paste, new import — is pushed to the
   nearest free square that is also clear of any window that is open.
   ========================================================================= */
const ICON_PAD = 6;
function iconBoxes(skipName) {
  const out = [];
  deskIcons().forEach(el => {
    if (skipName != null && el.dataset.name === skipName) return;
    out.push({ x: el.offsetLeft, y: el.offsetTop, w: el.offsetWidth || 84, h: el.offsetHeight || 70 });
  });
  return out;
}
function windowBoxes() {
  const desk = document.getElementById('desktop');
  if (!desk) return [];
  const dr = desk.getBoundingClientRect();
  return Array.prototype.slice.call(document.querySelectorAll('.win')).map(w => {
    if (w.classList.contains('hidden')) return null;
    const r = w.getBoundingClientRect();
    return { x: r.left - dr.left, y: r.top - dr.top, w: r.width, h: r.height };
  }).filter(Boolean);
}
function overlaps(a, b, pad) {
  pad = pad || 0;
  return !(a.x + a.w + pad <= b.x || b.x + b.w + pad <= a.x ||
           a.y + a.h + pad <= b.y || b.y + b.h + pad <= a.y);
}
/* spiral outwards from where it wanted to be until the square is free */
function freeSlot(want, skipName, avoidWindows) {
  const desk = document.getElementById('desktop');
  const dw = (desk && desk.clientWidth) || 640, dh = (desk && desk.clientHeight) || 480;
  const cols = Math.max(1, Math.floor((dw - 8) / ICON_W));
  const rows = Math.max(1, Math.floor((dh - 12) / ICON_H));
  const taken = iconBoxes(skipName);
  const wins = avoidWindows === false ? [] : windowBoxes();
  const fits = (x, y, wins2) => {
    const box = { x: x, y: y, w: ICON_W - 16, h: ICON_H - 8 };
    if (x < 0 || y < 0 || x + ICON_W - 16 > dw || y + ICON_H - 8 > dh) return false;
    for (const t of taken) if (overlaps(box, t, ICON_PAD)) return false;
    for (const t of wins2) if (overlaps(box, t, 2)) return false;
    return true;
  };
  const c0 = Math.max(0, Math.min(cols - 1, Math.round((want.x - 8) / ICON_W)));
  const r0 = Math.max(0, Math.min(rows - 1, Math.round((want.y - 8) / ICON_H)));
  /* two passes: first respecting open windows, then ignoring them, because a
     desk covered edge to edge in windows still has to put the icon somewhere */
  for (const w of [wins, []]) {
    for (let ring = 0; ring < cols + rows; ring++) {
      for (let dc = -ring; dc <= ring; dc++) {
        for (let dr = -ring; dr <= ring; dr++) {
          if (Math.max(Math.abs(dc), Math.abs(dr)) !== ring) continue;
          const c = c0 + dc, r = r0 + dr;
          if (c < 0 || r < 0 || c >= cols || r >= rows) continue;
          const x = 8 + c * ICON_W, y = 8 + r * ICON_H;
          if (fits(x, y, w)) return { x: x, y: y };
        }
      }
    }
  }
  return { x: Math.min(want.x, dw - ICON_W), y: Math.min(want.y, dh - ICON_H) };
}

/* the default grid: down the left edge first, then across, like every
   desktop that ever shipped */
function iconSlot(i) {
  const desk = document.getElementById('desktop');
  /* the desktop may not have been measured yet — building while the tube is
     dark would otherwise pile every icon into one row across the top */
  const h = desk.clientHeight || desk.offsetHeight || 600;
  const rows = Math.max(1, Math.floor((h - 12) / ICON_H));
  return { x: 8 + Math.floor(i / rows) * ICON_W, y: 8 + (i % rows) * ICON_H };
}

function buildIcons() {
  const box = document.getElementById('icons');
  box.innerHTML = '';

  const nodes = FS.children.slice();
  nodes.push({ name: 'TERMINAL', type: 'terminal' });   /* plus the terminal */

  nodes.forEach((node, i) => {
    const open = node.type === 'terminal'
      ? openTerminal
      : () => openNode(node, node._path || ('::/' + node.name));
    const el = makeIcon(node, open);
    el.dataset.desk = '1';
    el.dataset.name = node.name;
    el.style.left = '0px'; el.style.top = '0px';
    wireDeskIcon(el);
    box.appendChild(el);
    /* placed after it is in the DOM, so its real size is known and the
       squares already taken can be measured */
    const want = iconPos[node.name] || iconSlot(i);
    const p = freeSlot(want, node.name, !iconPos[node.name]);
    el.style.left = p.x + 'px';
    el.style.top  = p.y + 'px';
    iconPos[node.name] = p;
  });
  saveIconPos();
}

/* put everything back on the grid, in tree order */
function arrangeIcons() {
  iconPos = {};
  deskIcons().forEach((el, i) => {
    const p = iconSlot(i);
    el.style.left = p.x + 'px';
    el.style.top  = p.y + 'px';
    iconPos[el.dataset.name] = p;
  });
  saveIconPos();
  Snd.save();
  toast('ICONS ARRANGED.');
}

function wireDeskIcon(el) {
  el.addEventListener('pointerdown', ev => {
    if (ev.button !== 0) return;
    ev.preventDefault();
    ev.stopPropagation();
    const add = ev.ctrlKey || ev.metaKey || ev.shiftKey;
    if (add) {
      el.classList.toggle('sel');
      Snd.select();
    } else if (!el.classList.contains('sel')) {
      clearIconSel();
      el.classList.add('sel');
      Snd.select();
    }

    const desk = document.getElementById('desktop');
    const sx = ev.clientX, sy = ev.clientY;
    const group = selectedIcons().map(n => ({ n: n, x: n.offsetLeft, y: n.offsetTop }));
    let moved = false;

    const move = e2 => {
      const dx = e2.clientX - sx, dy = e2.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) < 4) return;   /* still a click */
      if (!moved) {
        moved = true;
        Snd.grab();
        group.forEach(s => s.n.classList.add('dragging'));
      }
      group.forEach(s => {
        s.n.style.left = Math.max(0, Math.min(s.x + dx, desk.clientWidth  - s.n.offsetWidth)) + 'px';
        s.n.style.top  = Math.max(0, Math.min(s.y + dy, desk.clientHeight - s.n.offsetHeight)) + 'px';
      });
    };

    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      if (!moved) return;
      deskClickArmed = false;
      group.forEach(s => {
        s.n.classList.remove('dragging');
        /* let go on top of another icon and it settles into the next free
           square instead of hiding underneath */
        const p = freeSlot({ x: s.n.offsetLeft, y: s.n.offsetTop }, s.n.dataset.name, false);
        s.n.style.left = p.x + 'px';
        s.n.style.top  = p.y + 'px';
        iconPos[s.n.dataset.name] = p;
      });
      saveIconPos();
      Snd.drop();
    };

    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  });
}

/* rubber band selection on bare desktop */
function wireMarquee(desk) {
  const box = document.getElementById('marquee');
  desk.addEventListener('pointerdown', ev => {
    if (ev.button !== 0) return;
    if (ev.target.closest && (ev.target.closest('.icon') || ev.target.closest('.win'))) return;
    const add = ev.ctrlKey || ev.metaKey || ev.shiftKey;
    const keep = add ? selectedIcons() : [];
    if (!add) clearIconSel();

    const r = desk.getBoundingClientRect();
    const ox = ev.clientX - r.left, oy = ev.clientY - r.top;
    let live = false;

    const move = e2 => {
      const x = e2.clientX - r.left, y = e2.clientY - r.top;
      if (!live && Math.abs(x - ox) + Math.abs(y - oy) < 4) return;
      live = true;
      const L = Math.min(ox, x), T = Math.min(oy, y);
      const Wd = Math.abs(x - ox), Ht = Math.abs(y - oy);
      box.style.display = 'block';
      box.style.left = L + 'px';
      box.style.top = T + 'px';
      box.style.width = Wd + 'px';
      box.style.height = Ht + 'px';
      deskIcons().forEach(n => {
        const hit = n.offsetLeft < L + Wd && n.offsetLeft + n.offsetWidth  > L &&
                    n.offsetTop  < T + Ht && n.offsetTop  + n.offsetHeight > T;
        n.classList.toggle('sel', hit || keep.indexOf(n) >= 0);
      });
    };

    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      box.style.display = 'none';
      if (live) { deskClickArmed = false; Snd.select(); }
    };

    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  });
}

function buildDesktop() {
  stampPaths();
  buildIcons();

  const desk = document.getElementById('desktop');

  desk.addEventListener('click', () => {
    if (!deskClickArmed) { deskClickArmed = true; return; }  /* just dragged */
    clearIconSel();
    lastFolder = null;      /* back to C:/ as the upload target */
  });

  wireMarquee(desk);

  /* right click on bare desktop */
  desk.addEventListener('contextmenu', ev => {
    if (ev.target.closest && (ev.target.closest('.icon') || ev.target.closest('.win'))) return;
    ev.preventDefault();
    lastFolder = null;
    const items = [
      { label: 'UPLOAD IMAGES...', run: () => document.getElementById('pickimg').click() },
      { label: 'NEW FOLDER...',    run: () => newFolderIn(FS) },
      { label: 'ARRANGE ICONS',    run: arrangeIcons }
    ];
    if (wallpaper) items.push({ label: 'CLEAR BACKGROUND', run: () => setWallpaper(null) });
    items.push({ sep: true });
    items.push({ label: 'DISPLAY SETTINGS...',  run: openDisplaySettings });
    items.push({ label: 'CRAZY DAVE\'S SHOP...', run: openShop });
    items.push({ label: 'ABOUT THIS MACHINE',   run: openAbout });
    showMenu(document.getElementById('ctxmenu'), ev.clientX, ev.clientY, items);
  });

  /* anything dropped on open desktop lands in C:/ */
  wireDrop(desk, () => FS);

  /* menu labels are decorative; File, Tools and Help do something */
  document.querySelectorAll('.menuitem').forEach(mi => {
    mi.addEventListener('mousedown', ev => {
      const m = mi.dataset.menu;
      Snd.click();
      if (m === 'File')    { ev.stopPropagation(); openFileMenu(mi); return; }
      if (m === 'Compile') openCompile(lastText || findNode('AutoExec.HC'));
      if (m === 'Tools')   openTerminal();
      if (m === 'Help')    openNode(findNode('Welcome.DD'), '::/Welcome.DD');
    });
  });

  applyWallpaper();

  /* the two hidden pickers */
  document.getElementById('pickimg').addEventListener('change', ev => {
    importFiles(ev.target.files, activeFolder());
    ev.target.value = '';
  });
  document.getElementById('picktxt').addEventListener('change', ev => {
    importFiles(ev.target.files, activeFolder());
    ev.target.value = '';
  });

  startClock();
  try { bootExtras(); } catch (e) { panic(e, 'boot'); }
  /* open the readme so the desktop isn't bare on first boot */
  openNode(findNode('Welcome.DD'), '::/Welcome.DD');
}

function findNode(name, node) {
  node = node || FS;
  if (node.name === name) return node;
  if (!node.children) return null;
  for (const c of node.children) {
    const hit = findNode(name, c);
    if (hit) return hit;
  }
  return null;
}

function startClock() {
  const el = document.getElementById('clock');
  const tick = () => {
    const d = new Date();
    const p = n => String(n).padStart(2, '0');
    el.textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
  };
  tick();
  setInterval(tick, 1000);
}

/* ==========================================================================
   10. THE TUBE — lens, glass, speaker, power
   --------------------------------------------------------------------------
   The curvature comes from two places. The GLASS is a canvas of bowed
   scanlines, vignette and glare drawn with the barrel formula directly; it
   costs nothing because nothing clicks it. The CONTENT is bent by a real
   feDisplacementMap, kept deliberately gentle: the browser still hit-tests
   the flat layout, so a hard bend would put your pointer somewhere your eye
   isn't. LENS: FULL lifts that limit for screenshots and says so.
   ========================================================================== */

const CRT = {
  lens: 1,          /* 0 flat, 1 soft, 2 full */
  scan: 2,          /* scanline pitch in px */
  phos: 0,          /* 0 P1, 1 P4, 2 P7 */
  burn: false,      /* twenty years of the same menubar */
  dgauss: false,    /* the coil, left energised or not */
  on: true
};
const LENS_NAME = ['FLAT', 'SOFT', 'FULL'];

/* Curvature is one dimensionless number per setting: how much magnification
   the tube loses out at its rim. It is a fraction of each axis rather than a
   pixel count, so 16:9 bows by the same visual amount as 4:3.

   Note the SIGN. Barrel — what a curved tube and a fisheye lens both do —
   means magnification FALLS with radius: the corners pull in and the sides
   bulge out between them. The old code pushed outward, which is pincushion,
   the opposite shape, and part of why the curve and the frame never agreed. */
const LENS_BOW = [0, 0.032, 0.078];

/* Everything the plastic does to keep up with the glass. Pixels, not
   percentages: these have to stay the same size on a 600px window and a
   2400px one, or the corner arc starts eating the interface. */
const LENS_TUBE_R = ['8px / 10px', '16px / 20px', '26px / 34px'];
const LENS_WELL_R = ['12px', '22px', '40px'];
const LENS_CASE_R = ['12px', '24px', '44px'];
/* No overscan. Scaling the tube pushed the shell's corners back out past
   the very curve we just moved them inside, and a non-integer scale is also
   what puts a shimmer on small text. The lens is visible enough without it:
   the mask changes shape and the whole interface slides in. */
const LENS_ZOOM   = [1, 1, 1];

/* Where the picture's own corner sits, as a fraction of the half-axis. The
   barrel map puts the corner at (1-2k)/(1-k), so it comes in by k/(1-k). */
function lensInset() { const k = LENS_BOW[CRT.lens]; return k / (1 - k); }

/* One call re-shapes the whole front of the machine: glass, well, case, the
   margin the interface keeps clear of the curve, and a touch of overscan so
   the picture visibly jumps when the knob is pressed. The margin is worked
   out from the live screen size, so it is right on any aspect ratio and is
   redone on every resize. */
function applyLensShape() {
  const mon = document.getElementById('monitor');
  const scr = document.getElementById('screen');
  if (!mon || !scr) return;
  mon.style.setProperty('--tube-r', LENS_TUBE_R[CRT.lens]);
  mon.style.setProperty('--well-r', LENS_WELL_R[CRT.lens]);
  mon.style.setProperty('--case-r', LENS_CASE_R[CRT.lens]);
  mon.style.setProperty('--tube-zoom', String(LENS_ZOOM[CRT.lens]));

  /* Inset by exactly the corner pull-in, on each axis. That lands the
     shell's corners precisely on the picture's corners: the boundary bulges
     outward everywhere between them, so nothing else can be clipped. */
  const r = scr.getBoundingClientRect();
  const f = lensInset();
  const sx = Math.round((r.width  || 0) / 2 * f) + 2;
  const sy = Math.round((r.height || 0) / 2 * f) + 2;
  mon.style.setProperty('--safe-x', (CRT.lens ? Math.max(6, sx) : 0) + 'px');
  mon.style.setProperty('--safe-y', (CRT.lens ? Math.max(4, sy) : 0) + 'px');
}

/* ---- 11.2 the glass ------------------------------------------------------ */
function paintGlass() {
  const cv = document.getElementById('glass');
  const screen = document.getElementById('screen');
  const r = screen.getBoundingClientRect();
  if (!r.width || !r.height) return;

  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const W = Math.round(r.width), H = Math.round(r.height);
  cv.width = Math.round(W * dpr);
  cv.height = Math.round(H * dpr);
  cv.style.width = W + 'px';
  cv.style.height = H + 'px';

  const g = cv.getContext('2d');
  if (!g) return;
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, W, H);

  /* Barrel projection. Magnification falls off as r^2, and the whole thing
     is renormalised by (1-k) so the middle of each side still touches the
     glass — the corners are the only part that comes in. Everything drawn
     below goes through this, which is what makes the tube look blown. */
  const k = 0.010 + LENS_BOW[CRT.lens];
  const norm = 1 - k;
  const toScreen = (u, v) => {
    const m = (1 - (u * u + v * v) * k) / norm;
    return [(u * m + 1) / 2 * W, (v * m + 1) / 2 * H];
  };

  /* the outline of the picture itself, traced counter-clockwise */
  const edge = (g2, n) => {
    n = n || 40;
    const put = (u, v, first) => {
      const p = toScreen(u, v);
      if (first) g2.moveTo(p[0], p[1]); else g2.lineTo(p[0], p[1]);
    };
    for (let i = 0; i <= n; i++) put(-1 + (i / n) * 2, -1, i === 0);
    for (let i = 1; i <= n; i++) put(1, -1 + (i / n) * 2, false);
    for (let i = 1; i <= n; i++) put(1 - (i / n) * 2, 1, false);
    for (let i = 1; i <= n; i++) put(-1, 1 - (i / n) * 2, false);
    g2.closePath();
  };

  /* 1. scanlines, bowed to follow the tube. DISP.scan is the Display
     settings switch; the SCAN knob on the chin still sets the pitch. */
  g.lineWidth = 1;
  g.strokeStyle = 'rgba(0,0,0,0.34)';
  const steps = 34;
  for (let y = 0; (typeof DISP === 'undefined' || DISP.scan) && y < H; y += CRT.scan + 1) {
    const v = (y / H) * 2 - 1;
    g.beginPath();
    for (let s = 0; s <= steps; s++) {
      const u = (s / steps) * 2 - 1;
      const p = toScreen(u, v);
      if (s === 0) g.moveTo(p[0], p[1]); else g.lineTo(p[0], p[1]);
    }
    g.stroke();
  }

  /* 2. aperture grille: faint vertical triads */
  g.globalAlpha = 0.055;
  for (let x = 0; x < W; x += 3) {
    g.fillStyle = ['#FF0000', '#00FF00', '#0000FF'][(x / 3) % 3];
    g.fillRect(x, 0, 1, H);
  }
  g.globalAlpha = 1;

  /* 3. colour fringing where the lens is thickest */
  const fringe = g.createLinearGradient(0, 0, W, 0);
  fringe.addColorStop(0,    'rgba(255,60,60,0.10)');
  fringe.addColorStop(0.14, 'rgba(255,60,60,0)');
  fringe.addColorStop(0.86, 'rgba(60,140,255,0)');
  fringe.addColorStop(1,    'rgba(60,140,255,0.10)');
  g.fillStyle = fringe;
  g.fillRect(0, 0, W, H);

  /* 4. vignette into the corners, unless it has been switched off */
  if (typeof DISP === 'undefined' || DISP.vig) {
  const vig = g.createRadialGradient(W / 2, H / 2, Math.min(W, H) * 0.28,
                                     W / 2, H / 2, Math.max(W, H) * 0.78);
  vig.addColorStop(0,    'rgba(0,0,0,0)');
  vig.addColorStop(0.62, 'rgba(0,0,0,0.16)');
  vig.addColorStop(1,    'rgba(0,0,0,0.82)');
  g.fillStyle = vig;
  g.fillRect(0, 0, W, H);
  }

  /* 5. the reflection that sells the bulge */
  g.save();
  g.translate(W * 0.30, H * 0.20);
  g.rotate(-0.42);
  const gl = g.createRadialGradient(0, 0, 0, 0, 0, Math.max(W, H) * 0.42);
  gl.addColorStop(0,   'rgba(255,255,255,0.085)');
  gl.addColorStop(0.5, 'rgba(255,255,255,0.028)');
  gl.addColorStop(1,   'rgba(255,255,255,0)');
  g.fillStyle = gl;
  g.scale(1, 0.42);
  g.beginPath();
  g.arc(0, 0, Math.max(W, H) * 0.42, 0, Math.PI * 2);
  g.fill();
  g.restore();

  /* 6. THE BEZEL MASK. Everything outside the barrel outline is painted
     out, so the picture itself ends up corner-pinched and side-bulged — the
     fisheye silhouette, drawn once, with no filter anywhere near the live
     interface. This is what you actually see when you turn the knob. */
  g.fillStyle = '#000000';
  g.beginPath();
  g.rect(0, 0, W, H);
  edge(g, 44);
  g.fill('evenodd');

  /* 7. the glass rolling away into that edge: a few soft strokes inside the
     outline, then one bright rim on top of it */
  g.lineJoin = 'round';
  for (let i = 6; i >= 1; i--) {
    g.strokeStyle = 'rgba(0,0,0,' + (0.10 + i * 0.02).toFixed(3) + ')';
    g.lineWidth = i * 2.2;
    g.beginPath();
    edge(g, 44);
    g.stroke();
  }
  g.strokeStyle = 'rgba(255,255,255,0.10)';
  g.lineWidth = 1.4;
  g.beginPath();
  edge(g, 44);
  g.stroke();
}

/* ---- 11.3 the front panel state -----------------------------------------
   Nothing here makes a sound until somebody turns it up. Both pots start at
   0 and the lobby switch starts down, so the first thing you do with this
   machine is the first thing you did with a real one: reach for the panel.
   These are deliberately NOT saved — every reload is a cold boot.
   ========================================================================== */
/* The hold controls start locked at 5, because they are the one pair on the
   panel you are meant to find already correct. */
const Vol = { sfx: 0, mus: 0, lobby: false, vhold: 5, hhold: 5 };

/* a real pot is not linear; the bottom of the travel has to stay quiet */
function sfxGain() { return Math.pow(Vol.sfx / 10, 1.6) * 1.25; }
function musGain() { return Math.pow(Vol.mus / 10, 1.6) * 0.85; }

/* ---- 11.3b the speaker ---------------------------------------------------
   One oscillator per event, plus a noise burst for anything mechanical. The
   whole thing is a PC speaker with delusions: square waves, short envelopes,
   nothing sampled. Two buses come out of it: everything the OS says runs
   through SFX and obeys the knob, while the panel's own clicks and clacks
   run through MECH and are always audible — they are the sound of plastic,
   not the sound of software, and you have to hear them to find the knob at
   all when the volume is still at zero. */
const Snd = {
  ctx: null,
  sfx: null,
  mech: null,
  wake() {
    if (!this.ctx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      try { this.ctx = new AC(); } catch (e) { return; }
    }
    if (!this.sfx) {
      this.sfx = this.ctx.createGain();
      this.sfx.gain.value = sfxGain();
      this.sfx.connect(this.ctx.destination);
      this.mech = this.ctx.createGain();
      this.mech.gain.value = 0.8;
      this.mech.connect(this.ctx.destination);
    }
    if (this.ctx.state === 'suspended') this.ctx.resume();
  },
  /* a context that has not been resumed yet reports currentTime 0 forever;
     scheduling a hair late keeps the first click from being swallowed */
  at(opt) {
    const lead = (this.ctx.state === 'running') ? 0 : 0.06;
    return this.ctx.currentTime + lead + (opt.delay || 0);
  },
  tone(freq, ms, opt) {
    opt = opt || {};
    if (!opt.mech && (!CRT.on || Vol.sfx <= 0)) return;
    this.wake();
    if (!this.ctx) return;
    const t0 = this.at(opt);
    const dur = ms / 1000;
    const osc = this.ctx.createOscillator();
    const amp = this.ctx.createGain();
    osc.type = opt.type || 'square';
    osc.frequency.setValueAtTime(freq, t0);
    if (opt.to) osc.frequency.exponentialRampToValueAtTime(opt.to, t0 + dur);
    const vol = (opt.vol == null) ? 0.045 : opt.vol;
    amp.gain.setValueAtTime(0.0001, t0);
    amp.gain.exponentialRampToValueAtTime(vol, t0 + 0.005);
    amp.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    osc.connect(amp);
    amp.connect(opt.mech ? this.mech : this.sfx);
    osc.start(t0);
    osc.stop(t0 + dur + 0.03);
  },
  /* filtered white noise: keycaps, drawer slams, the sound of a file dying */
  noise(ms, opt) {
    opt = opt || {};
    if (!opt.mech && (!CRT.on || Vol.sfx <= 0)) return;
    this.wake();
    if (!this.ctx) return;
    let buf;
    try {
      const n = Math.max(1, Math.floor(this.ctx.sampleRate * ms / 1000));
      buf = this.ctx.createBuffer(1, n, this.ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
    } catch (e) { return; }
    const t0 = this.at(opt);
    const src = this.ctx.createBufferSource();
    src.buffer = buf;
    const f = this.ctx.createBiquadFilter();
    f.type = 'bandpass';
    f.frequency.value = opt.freq || 1800;
    f.Q.value = opt.q || 1;
    const amp = this.ctx.createGain();
    amp.gain.value = (opt.vol == null) ? 0.05 : opt.vol;
    src.connect(f); f.connect(amp); amp.connect(opt.mech ? this.mech : this.sfx);
    src.start(t0);
  },

  /* --- the panel, in plastic -------------------------------------------- */
  /* a pot detent: the spring leaf dropping into the next notch. Every click
     is pitched slightly differently, because no two notches are the same. */
  detent(step, delay) {
    const j = ((step % 4) - 1.5) * 90;
    const d = delay || 0;
    this.noise(11, { mech: true, delay: d, freq: 2350 + j + Math.random() * 260, q: 2.4, vol: 0.52 });
    this.tone(176 + Math.random() * 26, 15, { mech: true, delay: d, type: 'triangle', vol: 0.10 });
  },
  /* the shaft hitting the end of its travel: no click, just a dull stop */
  endstop() {
    this.noise(55, { mech: true, freq: 420, q: 0.7, vol: 0.40 });
    this.tone(88, 70, { mech: true, type: 'triangle', to: 48, vol: 0.13 });
  },
  grip() { this.noise(28, { mech: true, freq: 620, q: 0.8, vol: 0.16 }); },
  /* a slim rocker: the snap of the spring, then the body of the plate */
  clackOn() {
    this.noise(7,  { mech: true, freq: 3300, q: 2.6, vol: 0.55 });
    this.noise(42, { mech: true, freq: 330,  q: 0.8, vol: 0.42, delay: 0.016 });
    this.tone(124, 70, { mech: true, type: 'triangle', to: 62, vol: 0.14, delay: 0.016 });
  },
  clackOff() {
    this.noise(6,  { mech: true, freq: 2300, q: 2.2, vol: 0.44 });
    this.noise(55, { mech: true, freq: 235,  q: 0.7, vol: 0.40, delay: 0.022 });
    this.tone(96, 85, { mech: true, type: 'triangle', to: 44, vol: 0.13, delay: 0.022 });
  },

  /* --- windows ---------------------------------------------------------- */
  open()  { this.tone(660, 30); this.tone(990, 40, { delay: 0.035 }); },
  close() { this.tone(520, 55, { to: 220 }); },
  min()   { this.tone(760, 90, { to: 240, vol: 0.035 }); },
  grab()  { this.tone(320, 26, { type: 'triangle', vol: 0.028 }); },
  drop()  { this.tone(190, 70, { type: 'triangle', to: 110, vol: 0.045 }); },

  /* --- controls --------------------------------------------------------- */
  click()  { this.noise(16, { freq: 2600, q: 1.2, vol: 0.05 }); this.tone(1500, 12, { vol: 0.012 }); },
  press()  { this.noise(28, { freq: 900, q: 1.4, vol: 0.075 }); this.tone(240, 32, { vol: 0.022 }); },
  select() { this.tone(1180, 16, { vol: 0.018 }); },
  menu()   { this.tone(700, 16, { vol: 0.02 }); this.tone(1050, 22, { delay: 0.022, vol: 0.02 }); },
  blip()   { this.tone(1560, 14, { vol: 0.02 }); },

  /* --- typing ----------------------------------------------------------- */
  key()   { this.tone(1800, 8, { vol: 0.015 }); },
  type()  { this.noise(9, { freq: 3000, q: 0.9, vol: 0.03 }); },
  enter() { this.tone(880, 24, { vol: 0.03 }); this.tone(1320, 34, { delay: 0.028, vol: 0.03 }); },

  /* --- verdicts --------------------------------------------------------- */
  ok()    { this.tone(1320, 35); },
  err()   { this.tone(150, 170, { type: 'sawtooth', vol: 0.04 }); },
  chirp() { this.tone(988, 40, { vol: 0.03 }); this.tone(1318, 55, { delay: 0.045, vol: 0.03 }); },
  page()  { this.noise(90, { freq: 1200, q: 0.5, vol: 0.028 }); },
  del()   { this.noise(160, { freq: 700, q: 0.6, vol: 0.055 });
            this.tone(420, 150, { type: 'sawtooth', to: 80, vol: 0.04 }); },
  save()  { [784, 1046, 1318].forEach((f, i) => this.tone(f, 50, { delay: i * 0.05, vol: 0.035 })); },
  holy()  { [523, 784, 1046, 1318].forEach((f, i) =>
              this.tone(f, 420, { type: 'triangle', delay: i * 0.07, vol: 0.035 }));
            this.tone(2093, 240, { delay: 0.3, vol: 0.013 }); },
  bell()  { [1046, 1318, 1568].forEach((f, i) => this.tone(f, 130, { delay: i * 0.085, vol: 0.04 })); },
  boot()  { [523, 659, 784, 1046].forEach((f, i) => this.tone(f, 85, { delay: i * 0.095, vol: 0.04 })); },
  thunk() { this.tone(95, 240, { type: 'triangle', to: 28, vol: 0.08 }); }
};

/* ---- 11.3b the boot hymn -------------------------------------------------
   Four bars in D minor, i - VI - III - V, on a square-wave organ with a
   triangle pad under it and a bass that walks root-root-fifth-root. It loops
   for as long as the splash is up and stops the moment the desktop appears.
   Edit HYMN to change the tune: [note, start in eighths, length in eighths].
   ========================================================================== */
const HZ = {
  D2: 73.42,  E2: 82.41,  F2: 87.31,   A2: 110.00, Bb2: 116.54, C3: 130.81,
  D3: 146.83, E3: 164.81, F3: 174.61,  G3: 196.00, A3: 220.00,  Bb3: 233.08,
  C4: 261.63, Cs4: 277.18, D4: 293.66, E4: 329.63, F4: 349.23,  G4: 392.00,
  A4: 440.00, Bb4: 466.16, C5: 523.25, D5: 587.33
};

const HYMN = {
  bpm: 92,
  lead: [
    ['D4', 0, 2], ['F4', 2, 2], ['A4', 4, 2], ['G4', 6, 1], ['F4', 7, 1],
    ['E4', 8, 2], ['D4', 10, 2], ['F4', 12, 3], ['D4', 15, 1],
    ['C5', 16, 2], ['A4', 18, 2], ['F4', 20, 2], ['A4', 22, 2],
    ['E4', 24, 2], ['Cs4', 26, 2], ['E4', 28, 1], ['A4', 29, 3]
  ],
  bass: [
    ['D2', 0, 2], ['D2', 2, 2], ['A2', 4, 2], ['D2', 6, 2],
    ['Bb2', 8, 2], ['Bb2', 10, 2], ['F2', 12, 2], ['Bb2', 14, 2],
    ['F2', 16, 2], ['F2', 18, 2], ['C3', 20, 2], ['F2', 22, 2],
    ['A2', 24, 2], ['A2', 26, 2], ['E2', 28, 2], ['A2', 30, 2]
  ],
  pad: [
    ['D3', 0, 8], ['F3', 0, 8], ['A3', 0, 8],
    ['Bb2', 8, 8], ['D3', 8, 8], ['F3', 8, 8],
    ['F3', 16, 8], ['A3', 16, 8], ['C4', 16, 8],
    ['E3', 24, 8], ['A3', 24, 8], ['Cs4', 24, 8]
  ]
};

const Music = {
  on: false,
  bus: null,
  timer: null,
  when: 0,
  voices: [],       /* every oscillator still in the queue, so stop() means stop */
  eighth() { return 30 / HYMN.bpm; },
  ensure() {
    Snd.wake();
    if (!Snd.ctx) return false;
    if (!this.bus) {
      this.bus = Snd.ctx.createGain();
      this.bus.gain.value = 0.0001;
      this.bus.connect(Snd.ctx.destination);
    }
    return true;
  },
  voice(name, at, eighths, type, vol, detune) {
    const f = HZ[name];
    if (!f) return;
    const c = Snd.ctx;
    const dur = eighths * this.eighth() * 0.92;
    const o = c.createOscillator();
    const g = c.createGain();
    o.type = type;
    o.frequency.setValueAtTime(f, at);
    if (detune) o.detune.setValueAtTime(detune, at);
    g.gain.setValueAtTime(0.0001, at);
    g.gain.exponentialRampToValueAtTime(vol, at + 0.03);
    g.gain.setValueAtTime(vol, at + dur * 0.6);
    g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    o.connect(g);
    g.connect(this.bus);
    o.start(at);
    o.stop(at + dur + 0.05);
    /* A loop is scheduled up to ten seconds ahead. Fading the bus hides
       those notes but does not cancel them, and the next start() raised
       the fader right back over the top of them — which is where the
       doubled music came from on a power cycle. Hold onto them. */
    this.voices.push(o);
    o.onended = () => {
      const i = this.voices.indexOf(o);
      if (i >= 0) this.voices.splice(i, 1);
    };
  },
  loop(t0) {
    const e = this.eighth();
    HYMN.pad.forEach(n  => this.voice(n[0], t0 + n[1] * e, n[2], 'triangle', 0.05));
    HYMN.bass.forEach(n => this.voice(n[0], t0 + n[1] * e, n[2], 'square', 0.07));
    HYMN.lead.forEach(n => {
      this.voice(n[0], t0 + n[1] * e, n[2], 'square', 0.08);
      /* a second oscillator a few cents sharp, the way a real chip drifted */
      this.voice(n[0], t0 + n[1] * e, n[2], 'square', 0.026, 8);
    });
    return 32 * e;
  },
  start() {
    if (this.on || !CRT.on || !Vol.lobby || Vol.mus <= 0) return;
    if (!this.ensure()) return;
    this.on = true;
    const g = this.bus.gain, now = Snd.ctx.currentTime;
    g.cancelScheduledValues(now);
    g.setValueAtTime(0.0001, now);
    g.exponentialRampToValueAtTime(Math.max(0.0002, musGain()), now + 1.1);
    this.when = now + 0.15;
    this.tick();
  },
  /* the MUS pot, riding the loop while it plays */
  level() {
    if (!this.bus || !Snd.ctx) return;
    const g = this.bus.gain, now = Snd.ctx.currentTime;
    g.cancelScheduledValues(now);
    g.setValueAtTime(Math.max(0.0001, g.value), now);
    g.exponentialRampToValueAtTime(Math.max(0.0002, musGain()), now + 0.14);
  },
  /* the single place that decides whether the lobby is playing */
  sync() {
    if (!(CRT.on && Vol.lobby && Vol.mus > 0)) { this.stop(); return; }
    if (this.on) this.level(); else this.start();
  },
  tick() {
    if (!this.on || !Snd.ctx) return;
    const now = Snd.ctx.currentTime;
    if (this.when < now) this.when = now + 0.05;   /* the tab was asleep */
    const len = this.loop(this.when);
    this.when += len;
    this.timer = setTimeout(() => this.tick(), Math.max(250, len * 1000 - 400));
  },
  stop() {
    this.on = false;
    clearTimeout(this.timer);
    if (!this.bus || !Snd.ctx) { this.voices = []; return; }
    const g = this.bus.gain, now = Snd.ctx.currentTime;
    g.cancelScheduledValues(now);
    g.setValueAtTime(Math.max(0.0001, g.value), now);
    g.exponentialRampToValueAtTime(0.0001, now + 0.6);
    /* silence the queue behind the fade, not just the fader in front of it */
    this.voices.forEach(o => { try { o.stop(now + 0.62); } catch (e) {} });
    this.voices = [];
  }
};

/* ==========================================================================
   11.3d THE STYLE METER
   Deleting a file is not housekeeping, it is a performance, and the machine
   grades it. Points in, points always bleeding out; the letter follows the
   points. Nothing here is saved — every reload starts you back at nothing.
   ========================================================================== */
const STYLE_CFG = {
  BASE: 220,          /* points for one file */
  COMBO_STEP: 40,     /* added per link in the chain */
  COMBO_MAX: 200,     /* ceiling on that bonus */
  COMBO_WINDOW: 3.5,  /* seconds before the chain is considered broken */
  GRACE: 2.2,         /* seconds of quiet before the drain opens */
  DRAIN: 55,          /* points a second at D */
  DRAIN_TIER: 22,     /* and again for every rank above it */
  TOP_HOLD: 8,        /* the birthday rank is frozen this long, once */
  BULK_CAP: 12        /* most files one bulk action may ever score */
};

/* at: the running total this rank starts at. col: palette, no exceptions. */
const STYLE_RANKS = [
  { key: 'D',   name: 'DESECRATING',          at: 0,    col: '#AAAAAA' },
  { key: 'C',   name: 'CORRUPTING',           at: 700,  col: '#55FF55' },
  { key: 'B',   name: 'BLASPHEMOUS',          at: 1500, col: '#55FFFF' },
  { key: 'A',   name: 'ANNIHILATING',         at: 2500, col: '#FFFF55' },
  { key: 'S',   name: 'SACRILEGIOUS',         at: 3800, col: '#AA5500' },
  { key: 'SS',  name: 'SSCORCHED EARTH',      at: 5400, col: '#FF5555' },
  { key: 'SSS', name: 'SSSTEFAN BOERUSTORM',  at: 7300, col: '#FF55FF' },
  { key: '!!!', name: 'HAPPY BIRTHDAY',       at: 9500, col: '#FFFFFF' }
];

/* what the machine calls the act, as it stops being an act of maintenance */
const STYLE_VERBS = [
  'DELETED', 'SHREDDED', 'PURGED', 'VAPORISED',
  'OBLITERATED', 'UNMADE', 'ERASED FROM THE RECORD', 'UNWRAPPED'
];

/* the birthday rank cycles the whole palette, one colour per two frames */
const STYLE_PARTY = ['#FFFF55', '#55FF55', '#55FFFF', '#FF55FF', '#FF5555', '#FFFFFF'];

const Style = {
  pts: 0,
  tier: -1,        /* -1 is dormant: the meter is not on screen at all */
  combo: 0,
  last: 0,         /* performance.now() of the last hit, in seconds */
  hold: 0,         /* seconds of drain freeze left */
  crowned: false,  /* the top rank has been reached once this session */
  raf: null,
  prev: 0,
  el: null,

  mount() {
    if (this.el) return true;
    const root = document.getElementById('smeter');
    if (!root) return false;
    const bar = document.getElementById('sm-bar');
    bar.innerHTML = '';
    for (let i = 0; i < 16; i++) bar.appendChild(document.createElement('b'));
    this.el = {
      root: root,
      key: document.getElementById('sm-key'),
      name: document.getElementById('sm-name'),
      cells: Array.prototype.slice.call(bar.children),
      log: document.getElementById('sm-log')
    };
    return true;
  },

  now() { return performance.now() / 1000; },

  /* ---- scoring --------------------------------------------------------- */
  /* node may be null. n is how many files this action killed — pass the
     child count for a folder, or the list length for a bulk clear. */
  hit(node, n) {
    if (!CRT.on) return;
    if (!this.mount()) return;
    let count = Math.max(1, n || 1);
    const bulk = count > 1;
    if (bulk) count = Math.min(count, STYLE_CFG.BULK_CAP);

    const t = this.now();
    if (t - this.last > STYLE_CFG.COMBO_WINDOW) this.combo = 0;
    this.last = t;

    let gained = 0;
    for (let i = 0; i < count; i++) {
      const bonus = Math.min(STYLE_CFG.COMBO_MAX, this.combo * STYLE_CFG.COMBO_STEP);
      gained += STYLE_CFG.BASE + bonus;
      this.combo++;
    }
    this.pts += gained;

    const tier = this.rankFor(this.pts);
    this.setTier(tier);

    /* the verb, then the chain, then the pile if it was a pile */
    this.say(STYLE_VERBS[Math.max(0, tier)], true);
    if (bulk) this.say('MASS DELETION x' + count);
    else if (this.combo > 2) this.say('CHAIN x' + this.combo);

    this.el.root.classList.remove('hit');
    void this.el.root.offsetWidth;      /* restart the recoil */
    this.el.root.classList.add('hit');

    Snd.delT(Math.max(0, tier));
    Rage.sync();
    this.run();
  },

  rankFor(p) {
    if (p <= 0) return -1;      /* nothing on the board: the meter goes away */
    let t = -1;
    for (let i = 0; i < STYLE_RANKS.length; i++) if (p >= STYLE_RANKS[i].at) t = i;
    return t;
  },

  setTier(t) {
    if (t === this.tier) return;
    const up = t > this.tier;
    this.tier = t;
    if (t < 0) { this.hide(); return; }
    const r = STYLE_RANKS[t];
    this.el.root.classList.add('live');
    this.el.root.style.setProperty('--sm-col', r.col);
    this.el.key.textContent = r.key;
    this.el.name.textContent = r.name;
    this.el.root.classList.toggle('top', t === STYLE_RANKS.length - 1);
    if (up) {
      this.el.root.classList.remove('up');
      void this.el.root.offsetWidth;
      this.el.root.classList.add('up');
      this.say(r.name, true);
      Snd.rankUp(t);
    }
    if (t === STYLE_RANKS.length - 1 && !this.crowned) {
      this.crowned = true;
      this.hold = STYLE_CFG.TOP_HOLD;
      Snd.fanfare();
      this.onTop();
    }
    Rage.sync();
  },

  /* overwrite this later for cake, confetti, a window that opens itself */
  onTop() {},

  say(text, big) {
    const d = document.createElement('div');
    d.textContent = text;
    if (big) d.className = 'big';
    this.el.log.insertBefore(d, this.el.log.firstChild);
    while (this.el.log.children.length > 5) {
      this.el.log.removeChild(this.el.log.lastChild);
    }
    setTimeout(() => { if (d.parentNode) d.parentNode.removeChild(d); }, 1600);
  },

  /* ---- the bleed ------------------------------------------------------- */
  run() {
    if (this.raf) return;
    this.prev = this.now();
    const loop = () => {
      this.raf = requestAnimationFrame(loop);
      this.frame();
    };
    this.raf = requestAnimationFrame(loop);
  },

  frame() {
    const t = this.now();
    const dt = Math.min(0.25, t - this.prev);
    this.prev = t;
    if (!CRT.on) { this.reset(); return; }

    if (this.hold > 0) {
      this.hold -= dt;
    } else if (t - this.last > STYLE_CFG.GRACE) {
      const rate = STYLE_CFG.DRAIN + STYLE_CFG.DRAIN_TIER * Math.max(0, this.tier);
      this.pts = Math.max(0, this.pts - rate * dt);
      const tier = this.rankFor(this.pts);
      if (tier !== this.tier) this.setTier(tier);
      if (this.pts <= 0 && this.tier < 0) { this.stop(); return; }
    }
    this.render();
  },

  render() {
    if (this.tier < 0) return;
    const r = STYLE_RANKS[this.tier];
    const next = STYLE_RANKS[this.tier + 1];
    const span = next ? next.at - r.at : 1;
    const frac = next ? (this.pts - r.at) / span : 1;
    const lit = Math.max(0, Math.min(16, Math.round(frac * 16)));
    for (let i = 0; i < 16; i++) this.el.cells[i].classList.toggle('on', i < lit);
    if (!next) {
      const c = STYLE_PARTY[Math.floor(this.now() * 12) % STYLE_PARTY.length];
      this.el.root.style.setProperty('--sm-col', c);
    }
  },

  hide() {
    if (!this.el) return;
    this.el.root.classList.remove('live', 'top', 'up', 'hit');
    this.el.log.innerHTML = '';
  },

  stop() {
    if (this.raf) cancelAnimationFrame(this.raf);
    this.raf = null;
    this.hide();
    Rage.sync();
  },

  /* power cycle, or anything else that should wipe the run */
  reset() {
    this.pts = 0;
    this.combo = 0;
    this.tier = -1;
    this.hold = 0;
    this.stop();
  }
};

/* ---- 11.3e the sound of a file dying, by rank ----------------------------
   Bolted onto Snd rather than written into it, so the speaker above stays
   the speaker it was. Every two ranks the delete gets a bigger gun.
   ========================================================================== */
Object.assign(Snd, {
  delT(tier) {
    if (tier < 2) {              /* D–C: the stock sound, a file giving up */
      this.del();
    } else if (tier < 4) {       /* B–A: it is being taken apart */
      this.noise(120, { freq: 1500, q: 1.4, vol: 0.07 });
      this.tone(620, 130, { type: 'sawtooth', to: 90, vol: 0.05 });
      this.tone(310, 90, { type: 'square', to: 60, vol: 0.035, delay: 0.03 });
    } else if (tier < 6) {       /* S–SS: a shotgun in a server room */
      this.noise(200, { freq: 420, q: 0.6, vol: 0.11 });
      this.noise(60, { freq: 3400, q: 2.0, vol: 0.06 });
      this.tone(180, 220, { type: 'sawtooth', to: 40, vol: 0.07 });
      this.tone(880, 70, { type: 'square', to: 220, vol: 0.03, delay: 0.02 });
    } else {                     /* SSS and above: it is a party favour */
      this.noise(240, { freq: 300, q: 0.5, vol: 0.12 });
      [1046, 1318, 1568, 2093].forEach((f, i) =>
        this.tone(f, 130, { type: 'square', delay: i * 0.028, vol: 0.045 }));
      this.tone(140, 260, { type: 'sawtooth', to: 35, vol: 0.07 });
    }
  },
  /* the promotion sting: a rising fifth, higher every rank */
  rankUp(tier) {
    const base = 330 * Math.pow(1.12, tier);
    [1, 1.5, 2].forEach((m, i) =>
      this.tone(base * m, 130, { type: 'square', delay: i * 0.05, vol: 0.05 }));
    this.noise(70, { freq: 2600, q: 1.6, vol: 0.05 });
  },
  /* reserved for the birthday, and used exactly once */
  fanfare() {
    [523, 659, 784, 1046, 1318, 1568, 2093].forEach((f, i) =>
      this.tone(f, 300, { type: 'square', delay: i * 0.075, vol: 0.055 }));
    [523, 784, 1046].forEach(f =>
      this.tone(f, 900, { type: 'triangle', delay: 0.55, vol: 0.04 }));
  }
});

/* ---- 11.3f the layer over the hymn ---------------------------------------
   D minor, same key as the boot hymn, at twice its tempo, on its own bus
   under the MUS pot. One instrument joins per rank and a lowpass opens as
   you climb, so the track does not change — it stops being held back.
   ========================================================================== */
const RZ = {
  D1: 36.71, A1: 55.00, D2: 73.42, F2: 87.31, A2: 110.00, Bb2: 116.54, C3: 130.81,
  D3: 146.83, F3: 174.61, G3: 196.00, A3: 220.00, Bb3: 233.08, C4: 261.63,
  D4: 293.66, E4: 329.63, F4: 349.23, G4: 392.00, A4: 440.00, Bb4: 466.16,
  C5: 523.25, D5: 587.33, F5: 698.46, A5: 880.00
};

const Rage = {
  on: false,
  bus: null,
  filt: null,
  when: 0,
  timer: null,
  voices: [],
  bpm: (typeof HYMN !== 'undefined' ? HYMN.bpm : 92) * 2,
  step() { return 15 / this.bpm; },              /* one sixteenth, in seconds */

  ensure() {
    Snd.wake();
    if (!Snd.ctx) return false;
    if (!this.bus) {
      this.filt = Snd.ctx.createBiquadFilter();
      this.filt.type = 'lowpass';
      this.filt.frequency.value = 800;
      this.filt.Q.value = 0.6;
      this.bus = Snd.ctx.createGain();
      this.bus.gain.value = 0.0001;
      this.filt.connect(this.bus);
      this.bus.connect(Snd.ctx.destination);
    }
    return true;
  },

  keep(o) {
    this.voices.push(o);
    o.onended = () => {
      const i = this.voices.indexOf(o);
      if (i >= 0) this.voices.splice(i, 1);
    };
  },

  note(f, at, dur, type, vol, to) {
    const c = Snd.ctx;
    const o = c.createOscillator();
    const g = c.createGain();
    o.type = type;
    o.frequency.setValueAtTime(f, at);
    if (to) o.frequency.exponentialRampToValueAtTime(to, at + dur);
    g.gain.setValueAtTime(0.0001, at);
    g.gain.exponentialRampToValueAtTime(vol, at + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    o.connect(g); g.connect(this.filt);
    o.start(at); o.stop(at + dur + 0.04);
    this.keep(o);
  },

  drum(at, ms, freq, q, vol) {
    const c = Snd.ctx;
    const n = Math.max(1, Math.floor(c.sampleRate * ms / 1000));
    let buf;
    try { buf = c.createBuffer(1, n, c.sampleRate); } catch (e) { return; }
    const d = buf.getChannelData(0);
    for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
    const s = c.createBufferSource();
    s.buffer = buf;
    const f = c.createBiquadFilter();
    f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = q;
    const g = c.createGain();
    g.gain.value = vol;
    s.connect(f); f.connect(g); g.connect(this.filt);
    s.start(at);
  },

  kick(at)  { this.note(130, at, 0.16, 'sine', 0.30, 42); },
  snare(at) { this.drum(at, 130, 1900, 0.8, 0.16); this.note(190, at, 0.09, 'triangle', 0.09, 90); },
  hat(at, v){ this.drum(at, 26, 8000, 1.6, v); },

  /* one bar of sixteen sixteenths, drawn according to how high we are */
  bar(t0, tier) {
    const s = this.step();
    const at = i => t0 + i * s;

    for (let i = 0; i < 16; i += (tier >= 5 ? 1 : 2)) this.hat(at(i), tier >= 5 ? 0.05 : 0.07);
    if (tier >= 1) [0, 4, 7, 10, 12].forEach(i => this.kick(at(i)));
    if (tier >= 6) [4, 12].forEach(i => this.snare(at(i)));

    if (tier >= 2) {
      const riff = ['D2','D2','D2','F2','D2','D2','C3','D2','D2','D2','Bb2','D2','A2','A2','C3','D2'];
      riff.forEach((n, i) => this.note(RZ[n], at(i), s * 0.85, 'square', 0.11));
    }
    if (tier >= 3) {
      [2, 6, 9, 14].forEach(i => {
        ['D3','F3','A3'].forEach(n => this.note(RZ[n], at(i), s * 1.6, 'sawtooth', 0.045));
      });
    }
    if (tier >= 4) {
      const lead = [['D4',0,2],['F4',2,2],['A4',4,2],['G4',6,1],['F4',7,1],
                    ['E4',8,2],['D4',10,1],['F4',11,1],['A4',12,2],['D5',14,2]];
      lead.forEach(n => {
        this.note(RZ[n[0]], at(n[1]), s * n[2] * 0.9, 'square', 0.075);
        if (tier >= 5) this.note(RZ[n[0]] * 2, at(n[1]), s * n[2] * 0.9, 'square', 0.03);
      });
    }
    if (tier >= 6) {
      this.note(RZ.A4, t0, s * 16, 'sawtooth', 0.028, RZ.A5);
    }
    if (tier >= 7) {
      [['D5',0,3],['D5',3,1],['E4',4,4],['D5',8,4],['A5',12,4]].forEach(n =>
        this.note(RZ[n[0]], at(n[1]), s * n[2] * 0.9, 'square', 0.07));
    }
    return 16 * s;
  },

  level() {
    if (!this.bus || !Snd.ctx) return;
    const t = Math.max(0, Style.tier);
    const now = Snd.ctx.currentTime;
    const target = Math.max(0.0002, musGain() * (0.30 + 0.085 * t));
    const g = this.bus.gain;
    g.cancelScheduledValues(now);
    g.setValueAtTime(Math.max(0.0001, g.value), now);
    g.exponentialRampToValueAtTime(target, now + 0.25);
    const cut = 700 * Math.pow(1.48, t);          /* 700 Hz at D, wide open at the top */
    this.filt.frequency.cancelScheduledValues(now);
    this.filt.frequency.setValueAtTime(this.filt.frequency.value, now);
    this.filt.frequency.linearRampToValueAtTime(Math.min(15000, cut), now + 0.45);
  },

  /* the one place that decides whether the layer is playing */
  sync() {
    if (!(CRT.on && Vol.mus > 0 && Style.tier >= 0)) { this.stop(); return; }
    if (this.on) this.level(); else this.start();
  },

  start() {
    if (this.on || !this.ensure()) return;
    this.on = true;
    this.when = Snd.ctx.currentTime + 0.12;
    this.level();
    this.tick();
  },

  tick() {
    if (!this.on || !Snd.ctx) return;
    const now = Snd.ctx.currentTime;
    if (this.when < now) this.when = now + 0.05;
    const len = this.bar(this.when, Math.max(0, Style.tier));
    this.when += len;
    this.timer = setTimeout(() => this.tick(), Math.max(120, len * 1000 - 300));
  },

  stop() {
    if (!this.on) return;
    this.on = false;
    clearTimeout(this.timer);
    if (!this.bus || !Snd.ctx) { this.voices = []; return; }
    const now = Snd.ctx.currentTime;
    const g = this.bus.gain;
    g.cancelScheduledValues(now);
    g.setValueAtTime(Math.max(0.0001, g.value), now);
    g.exponentialRampToValueAtTime(0.0001, now + 0.45);
    this.voices.forEach(o => { try { o.stop(now + 0.47); } catch (e) {} });
    this.voices = [];
  }
};

/* ---- 11.4 the knobs on the chin ------------------------------------------ */
function labelKnobs() {
  document.getElementById('k-lens').textContent = 'LENS: ' + LENS_NAME[CRT.lens];
  document.getElementById('k-scan').textContent = 'SCAN: ' + CRT.scan;
  const dg = document.getElementById('k-dgauss');
  if (dg) dg.textContent = 'DGAUSS: ' + (CRT.dgauss ? 'ON' : 'OFF');
  try { applyPhosphor(); applyBurn(); } catch (e) {}
}

function saveCRT() {
  try { localStorage.setItem('templeos.crt.v1', JSON.stringify(CRT)); } catch (e) {}
}

function loadCRT() {
  try {
    const raw = localStorage.getItem('templeos.crt.v1');
    if (raw) Object.assign(CRT, JSON.parse(raw));
  } catch (e) {}
  delete CRT.sound;        /* an older save; the SFX pot owns this now */
  CRT.lens = Math.max(0, Math.min(2, CRT.lens | 0));
  CRT.dgauss = !!CRT.dgauss;
  CRT.on = true;
  /* a coil that was left on is still on when the set warms up again */
  if (CRT.dgauss) setTimeout(() => {
    const r = document.getElementById('degauss');
    if (r) { r.style.display = 'block'; r.classList.add('held'); }
  }, 60);
}

function wireChin() {
  document.getElementById('k-lens').addEventListener('click', () => {
    CRT.lens = (CRT.lens + 1) % 3;
    applyLensShape();    /* glass, well, case, safe inset, overscan */
    paintGlass();
    labelKnobs();
    saveCRT();
    Snd.press();
    if (splashGone()) {
      toast(CRT.lens === 0 ? 'LENS FLAT. THE GLASS IS A PANE AGAIN.'
                           : 'LENS ' + LENS_NAME[CRT.lens] + '. THE PICTURE MOVES IN OFF THE CURVE.');
    }
  });

  document.getElementById('k-scan').addEventListener('click', () => {
    CRT.scan = CRT.scan >= 4 ? 0 : CRT.scan + 1;
    paintGlass();
    labelKnobs();
    saveCRT();
    Snd.press();
    if (splashGone()) toast('SCAN ' + (CRT.scan ? CRT.scan : 'OFF') + '.');
  });

  document.getElementById('k-dgauss').addEventListener('click', () => {
    Snd.press();
    CRT.dgauss = !CRT.dgauss;
    labelKnobs();
    saveCRT();
    const ring = document.getElementById('degauss');
    if (CRT.dgauss) {
      degauss();                       /* sweep once, then stay energised */
    } else if (ring) {
      ring.classList.remove('held');
      ring.style.display = 'none';
      Snd.ok();
    }
    if (splashGone()) toast('DEGAUSS COIL ' + (CRT.dgauss ? 'ON.' : 'OFF.'));
  });

  document.getElementById('k-phos').addEventListener('click', () => {
    CRT.phos = ((CRT.phos || 0) + 1) % 3;
    applyPhosphor();
    saveCRT();
    Snd.press();
    if (splashGone()) toast('PHOSPHOR ' + PHOS_NAME[CRT.phos] + '.');
  });

  document.getElementById('k-burn').addEventListener('click', () => {
    CRT.burn = !CRT.burn;
    applyBurn();
    saveCRT();
    Snd.press();
    if (splashGone()) {
      toast(CRT.burn ? 'BURN-IN ON. THIS TUBE HAS SEEN ONE MENUBAR.' : 'BURN-IN OFF.');
    }
  });

  document.getElementById('power').addEventListener('click', () => {
    Snd.press();
    CRT.on ? powerOff() : powerOn();
  });

  wirePanel();
}

/* ---- 11.5 the front panel ------------------------------------------------
   Two rotary pots and a rocker. The pots turn through 270 degrees, one
   detent per step, and the pointer follows your hand one-to-one: grab
   anywhere on the cap and swing around the centre. Scroll and the arrow
   keys work too, for anyone who would rather not drag.
   ========================================================================== */
function drawTicks(svg) {
  if (!svg) return;
  const C = 20, N = 11;
  let s = '';
  for (let i = 0; i < N; i++) {
    const a = (-225 + (i / (N - 1)) * 270) * Math.PI / 180;
    const big = (i === 0 || i === N - 1 || i === (N - 1) / 2);
    const r0 = big ? 15.2 : 16.4, r1 = 19.3;
    s += '<line x1="' + (C + Math.cos(a) * r0).toFixed(2) +
         '" y1="' + (C + Math.sin(a) * r0).toFixed(2) +
         '" x2="' + (C + Math.cos(a) * r1).toFixed(2) +
         '" y2="' + (C + Math.sin(a) * r1).toFixed(2) +
         '" stroke="' + (big ? '#4b4436' : '#7e7663') +
         '" stroke-width="' + (big ? 1.7 : 1) + '" stroke-linecap="round"/>';
  }
  svg.innerHTML = s;
}

function wirePot(id, lblId, name, start, write) {
  const el = document.getElementById(id);
  if (!el) return;
  const lbl = document.getElementById(lblId);
  drawTicks(el.querySelector('.ticks'));

  let pos = start;              /* the shaft angle, continuous 0..10 */
  let turning = false, lastA = 0, lastEnd = 0;

  function paint() {
    const step = Math.round(pos);
    el.style.setProperty('--deg', (-135 + (pos / 10) * 270).toFixed(1) + 'deg');
    el.setAttribute('aria-valuenow', String(step));
    if (lbl) lbl.textContent = name + ' ' + step;
  }

  function commit(next) {
    const before = Math.round(pos);
    const clamped = Math.max(0, Math.min(10, next));
    if (clamped === pos && (next < 0 || next > 10)) {
      const t = Date.now();
      if (t - lastEnd > 220) { lastEnd = t; Snd.endstop(); }
    }
    pos = clamped;
    const after = Math.round(pos);
    if (after !== before) {
      /* a fast sweep passes several notches: click for each one, so it
         ratchets instead of ticking once */
      const dir = after > before ? 1 : -1;
      const notches = Math.min(Math.abs(after - before), 6);
      for (let i = 1; i <= notches; i++) Snd.detent(before + dir * i, (i - 1) * 0.013);
      write(after);
    }
    paint();
  }

  function angleAt(ev) {
    const r = el.getBoundingClientRect();
    return Math.atan2(ev.clientY - (r.top + r.height / 2),
                      ev.clientX - (r.left + r.width / 2)) * 180 / Math.PI;
  }

  el.addEventListener('pointerdown', ev => {
    ev.preventDefault();
    Snd.wake();
    turning = true;
    lastA = angleAt(ev);
    el.classList.add('turning');
    el.focus();
    Snd.grip();
    try { el.setPointerCapture(ev.pointerId); } catch (e) {}
    /* the window, not the cap: your hand will wander off a 24px disc long
       before you have turned it all the way up */
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', release);
    window.addEventListener('pointercancel', release);
  });

  function onMove(ev) {
    if (!turning) return;
    let d = angleAt(ev) - lastA;
    while (d > 180) d -= 360;
    while (d < -180) d += 360;
    lastA += d;
    commit(pos + (d / 270) * 10);       /* 270 degrees of travel, one to one */
  }

  function release() {
    if (!turning) return;
    turning = false;
    el.classList.remove('turning');
    pos = Math.round(pos);              /* the spring settles into the notch */
    paint();
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', release);
    window.removeEventListener('pointercancel', release);
  }

  el.addEventListener('wheel', ev => {
    ev.preventDefault();
    Snd.wake();
    commit(Math.round(pos) + (ev.deltaY < 0 ? 1 : -1));
  }, { passive: false });

  el.addEventListener('keydown', ev => {
    const k = ev.key;
    if (k === 'ArrowUp' || k === 'ArrowRight')       { ev.preventDefault(); commit(Math.round(pos) + 1); }
    else if (k === 'ArrowDown' || k === 'ArrowLeft') { ev.preventDefault(); commit(Math.round(pos) - 1); }
    else if (k === 'Home')                           { ev.preventDefault(); commit(0); }
    else if (k === 'End')                            { ev.preventDefault(); commit(10); }
  });

  paint();
}

/* the SFX bus rides its pot the way a real volume control does */
function applySfxLevel() {
  if (!Snd.sfx || !Snd.ctx) return;
  const g = Snd.sfx.gain, now = Snd.ctx.currentTime;
  g.cancelScheduledValues(now);
  g.setValueAtTime(g.value, now);
  g.linearRampToValueAtTime(sfxGain(), now + 0.08);
}

function setLobby(on) {
  Vol.lobby = !!on;
  const sw = document.getElementById('lobby');
  sw.classList.toggle('on', Vol.lobby);
  sw.setAttribute('aria-checked', Vol.lobby ? 'true' : 'false');
  Vol.lobby ? Snd.clackOn() : Snd.clackOff();
  Music.sync();
  Rage.sync();
  if (splashGone()) {
    toast(!Vol.lobby ? 'LOBBY MUSIC OFF.'
        : Vol.mus > 0 ? 'LOBBY MUSIC ON.'
                      : 'LOBBY MUSIC ON. THE MUS POT IS AT 0.');
  } else {
    refreshBootHint();
  }
}

function wirePanel() {
  wirePot('pot-mus', 'lbl-mus', 'MUS', Vol.mus, v => {
    Vol.mus = v;
    Music.sync();
    Rage.sync();
    if (!splashGone()) { /* nothing to say */ } else if (v === 0 && Vol.lobby) {
      toast('MUS 0. THE LOBBY IS STILL ON, JUST SILENT.');
    }
    refreshBootHint();
  });

  wirePot('pot-sfx', 'lbl-sfx', 'SFX', Vol.sfx, v => {
    const wasOff = Vol.sfx === 0;
    Vol.sfx = v;
    applySfxLevel();
    if (wasOff && v > 0) Snd.ok();     /* the OS clearing its throat */
    refreshBootHint();
  });

  wirePot('pot-vhold', 'lbl-vhold', 'VHLD', Vol.vhold, v => {
    Vol.vhold = v;
    Hold.apply();
    if (splashGone() && v !== 5) toast('VERTICAL HOLD OFF LOCK. PUT IT BACK TO 5.');
  });

  wirePot('pot-hhold', 'lbl-hhold', 'HHLD', Vol.hhold, v => {
    Vol.hhold = v;
    Hold.apply();
    if (splashGone() && v !== 5) toast('HORIZONTAL HOLD OFF LOCK.');
  });

  const sw = document.getElementById('lobby');
  if (!sw) return;
  sw.addEventListener('pointerdown', ev => {
    ev.preventDefault();
    Snd.wake();
    sw.focus();
    setLobby(!Vol.lobby);
  });
  sw.addEventListener('keydown', ev => {
    if (ev.key === ' ' || ev.key === 'Enter') { ev.preventDefault(); setLobby(!Vol.lobby); }
  });
}

function powerOff() {
  const screen = document.getElementById('screen');
  Snd.thunk();
  Music.stop();
  Style.reset();
  CRT.on = false;
  document.getElementById('lamp').classList.remove('on');
  screen.classList.add('collapsing');
  setTimeout(() => {
    screen.classList.add('off');
    screen.classList.remove('collapsing');
  }, 270);
}

function powerOn() {
  const screen = document.getElementById('screen');
  CRT.on = true;
  screen.classList.remove('off', 'collapsing');
  document.getElementById('lamp').classList.add('on');
  document.getElementById('shell').style.display = 'none';
  const sp = document.getElementById('splash');
  sp.style.display = 'flex';
  runBoot();
  Snd.boot();
  Music.sync();
}

/* redraw the glass whenever the tube changes size */
let glassTimer = null;
function reglass() {
  clearTimeout(glassTimer);
  glassTimer = setTimeout(() => { applyLensShape(); paintGlass(); }, 90);
}
window.addEventListener('resize', reglass);

(function bootHardware() {
  /* The monitor is decoration. If any of it fails to start, the computer
     inside it still has to boot. */
  try { loadCRT(); labelKnobs(); wireChin(); } catch (e) {}
  try { applyLensShape(); } catch (e) {}
  try { paintGlass(); } catch (e) {}
  try {
    document.getElementById('lamp').classList.add('on');
    if (window.ResizeObserver) {
      new ResizeObserver(reglass).observe(document.getElementById('screen'));
    }
  } catch (e) {}
})();

/* ==========================================================================
   11. >>> USER FILE IMPORT — PUT YOUR OWN IMAGES IN THE FOLDERS <<<
   --------------------------------------------------------------------------
   Four ways in, no editing required:
     - drag files onto the desktop            -> they land in C:/
     - drag files onto an open folder window  -> they land in that folder
     - drag files onto a folder ICON          -> they land inside it
     - File > UPLOAD IMAGES..., or Ctrl+V to paste from the clipboard

   Imports are written into the FS tree in section 2 and saved, so they come
   back after a reload. Right click an uploaded file to delete it.
   Knobs are in UP below.
   ========================================================================== */

const UP = {
  vga:    true,          /* crush imports to the 16-color palette with dithering */
  maxDim: 384,           /* longest edge in pixels after import */
  budget: 4 * 1024 * 1024 /* stop saving past this; session-only beyond it */
};

/* v2: the tree moved from C:/ to ::/ , so old saves would land in the wrong
   place. A fresh namespace is cheaper than a migration nobody would read. */
const UP_KEY = 'templeos.uploads.v2';
const ED_KEY = 'templeos.edits.v2';
const WALL_KEY = 'templeos.wall.v2';
let uploadList = [];     /* [{ parent: 'C:/HOME', node: {...} }] */
let stockEdits = {};     /* path -> content, for files that ship with the OS */
let wallpaper = null;    /* { src, mode } */
let lastFolder = null;   /* most recently touched folder = upload target */
let lastText = null;     /* most recently touched text file = compile target */
const folderPanes = [];  /* open folder windows, so they redraw on change */

/* ---- 11.0 a tiny key/value layer over three possible backends ----------- */
async function kvGet(key, fallback) {
  try {
    if (window.storage && window.storage.get) {
      const r = await window.storage.get(key);
      return (r && r.value) ? JSON.parse(r.value) : fallback;
    }
  } catch (e) { return fallback; }
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch (e) {}
  return fallback;
}

async function kvSet(key, value) {
  const payload = JSON.stringify(value);
  try {
    if (window.storage && window.storage.set) {
      await window.storage.set(key, payload);
      return true;
    }
  } catch (e) {}
  try { localStorage.setItem(key, payload); return true; } catch (e) {}
  return false;
}


/* ---- 11.0b the disk under the disk --------------------------------------
   localStorage is a five megabyte drawer you have to serialise into strings,
   which is why videos and audio used to evaporate on reload. IndexedDB takes
   Blobs directly and runs to hundreds of megabytes, so anything big — an
   imported song, a video, a full-size picture — goes in here under a key, and
   only the key travels in the JSON that localStorage still holds.

   Everything degrades: no IndexedDB means the old behaviour, session only.
   ========================================================================== */
const Vault = {
  db: null, ready: null, ok: false,
  open() {
    if (this.ready) return this.ready;
    this.ready = new Promise(res => {
      let req;
      try { req = indexedDB.open('templeos.vault', 1); } catch (e) { return res(null); }
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains('blobs')) db.createObjectStore('blobs');
      };
      req.onsuccess = () => { this.db = req.result; this.ok = true; res(req.result); };
      req.onerror = () => res(null);
      req.onblocked = () => res(null);
      setTimeout(() => res(this.db), 4000);           /* never hang the boot on it */
    });
    return this.ready;
  },
  async tx(mode, fn) {
    const db = await this.open();
    if (!db) return null;
    return new Promise(res => {
      let t;
      try { t = db.transaction('blobs', mode); } catch (e) { return res(null); }
      const store = t.objectStore('blobs');
      let out = null;
      try { out = fn(store); } catch (e) { return res(null); }
      t.oncomplete = () => res(out && out.result !== undefined ? out.result : out);
      t.onerror = () => res(null);
      t.onabort = () => res(null);
    });
  },
  key() { return 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8); },
  async put(blob, key) {
    key = key || this.key();
    const r = await this.tx('readwrite', s => s.put(blob, key));
    return r === null && !this.ok ? null : key;
  },
  async get(key) { return key ? this.tx('readonly', s => s.get(key)) : null; },
  async del(key) { if (key) await this.tx('readwrite', s => s.delete(key)); },
  async keys() { return (await this.tx('readonly', s => s.getAllKeys())) || []; },
  /* a data: URL is a string; a Blob is not. Both go in, one comes out. */
  async putData(dataURL, key) {
    try {
      const b = await (await fetch(dataURL)).blob();
      return await this.put(b, key);
    } catch (e) { return null; }
  }
};
Vault.open();

/* Object URLs minted from the vault, so the same blob is not re-wrapped on
   every repaint and nothing leaks when a window closes. */
const VaultURL = {
  map: Object.create(null),
  async url(key) {
    if (!key) return null;
    if (this.map[key]) return this.map[key];
    const b = await Vault.get(key);
    if (!b) return null;
    try { this.map[key] = URL.createObjectURL(b); } catch (e) { return null; }
    return this.map[key];
  },
  drop(key) {
    if (!this.map[key]) return;
    try { URL.revokeObjectURL(this.map[key]); } catch (e) {}
    delete this.map[key];
  }
};

/* Rehydrate every node that carries a vault key back into something the rest
   of the OS can use without knowing the vault exists. */
async function vaultRehydrate(node) {
  if (!node) return;
  const list = [];
  (function walk(n) { if (n.vault) list.push(n); (n.children || []).forEach(walk); })(node);
  for (const n of list) {
    const u = await VaultURL.url(n.vault);
    if (u) { n.src = u; n.session = false; }
    else { n.missing = true; }
  }
}

/* text windows save half a second after you stop typing */
let editTimer = null;
function queueSave(node) {
  clearTimeout(editTimer);
  editTimer = setTimeout(() => {
    if (node.user) {
      upSave();                       /* uploads carry their own content */
    } else {
      stockEdits[node._path] = node.content;
      kvSet(ED_KEY, stockEdits);
    }
  }, 500);
}

/* ---- wallpaper ---------------------------------------------------------- */
function applyWallpaper() {
  const desk = document.getElementById('desktop');
  if (!desk) return;
  if (typeof DeskVid !== 'undefined' && (!wallpaper || wallpaper.kind !== 'video')) DeskVid.stop();
  if (!wallpaper) {
    desk.style.backgroundImage = '';
    return;
  }
  if (wallpaper.kind === 'video') {
    desk.style.backgroundImage = '';
    DeskVid.start(wallpaper.src);
    return;
  }
  desk.style.backgroundImage = 'url("' + wallpaper.src + '")';
  desk.style.backgroundRepeat = wallpaper.mode === 'tile' ? 'repeat' : 'no-repeat';
  desk.style.backgroundSize = wallpaper.mode === 'tile' ? 'auto' : 'cover';
  desk.style.backgroundPosition = 'center center';
}

function setWallpaper(node, mode) {
  wallpaper = node ? { src: node.src, mode: mode, vault: node.vault || null,
                       kind: node.type === 'video' ? 'video' : 'image' } : null;
  if (node && node.type === 'video' && node.session && !node.vault) {
    toast('VIDEO BACKGROUND. IT WILL NOT SURVIVE A RELOAD.');
  }
  applyWallpaper();
  kvSet(WALL_KEY, wallpaper);
  if (node) Snd.holy(); else Snd.close();
  toast(node ? ('BACKGROUND SET FROM ' + node.name + '.') : 'BACKGROUND CLEARED.');
}

/* ---- 10.1 paths --------------------------------------------------------- */
function stampPaths(node, prefix) {
  node = node || FS;
  prefix = prefix || '::';
  node._path = prefix;
  if (node.children) node.children.forEach(c => stampPaths(c, prefix + '/' + c.name));
}

function ensureFolder(path) {
  const parts = String(path).split('/').filter(Boolean);   /* ["C:","HOME"] */
  let cur = FS;
  for (let i = 1; i < parts.length; i++) {
    cur.children = cur.children || [];
    let next = cur.children.filter(c => c.name === parts[i] && c.type === 'folder')[0];
    if (!next) {
      next = { name: parts[i], type: 'folder', children: [], user: true };
      cur.children.push(next);
    }
    cur = next;
  }
  return cur;
}

function parentOf(target, node) {
  node = node || FS;
  if (!node.children) return null;
  if (node.children.indexOf(target) >= 0) return node;
  for (const c of node.children) {
    const hit = parentOf(target, c);
    if (hit) return hit;
  }
  return null;
}

function activeFolder() {
  return (lastFolder && lastFolder.type === 'folder') ? lastFolder : FS;
}

/* ---- 10.2 saving -------------------------------------------------------- */
/* Three storage backends, tried in order: the artifact store, then
   localStorage for a file opened straight off disk, then memory only. */
function stripNode(n) {
  const o = { name: n.name, type: n.type, user: true };
  if (n.vault) {                         /* the payload is in the vault */
    o.vault = n.vault;
    if (n.mime) o.mime = n.mime;
    if (n.bytes) o.bytes = n.bytes;
  } else {
    if (n.type === 'image')  o.src = n.src;
    if (n.type === 'video' && !n.session) o.src = n.src;
  }
  if (n.type === 'text')   o.content = n.content;
  if (n.type === 'folder') o.children = (n.children || []).map(stripNode);
  return o;
}

async function upLoadSaved() {
  try {
    if (window.storage && window.storage.get) {
      const r = await window.storage.get(UP_KEY);
      return (r && r.value) ? JSON.parse(r.value) : [];
    }
  } catch (e) { return []; }          /* no key yet */
  try {
    const raw = localStorage.getItem(UP_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) {}
  return [];
}

async function upSave() {
  const payload = JSON.stringify(uploadList.map(u => ({
    parent: u.parent, node: stripNode(u.node)
  })));
  if (payload.length > UP.budget) {
    toast('OVER 4MB. THESE FILES LAST UNTIL RELOAD.');
    return;
  }
  try {
    if (window.storage && window.storage.set) {
      await window.storage.set(UP_KEY, payload);
      return;
    }
  } catch (e) {}
  try { localStorage.setItem(UP_KEY, payload); return; } catch (e) {}
  toast('NO DISK HERE. FILES LAST UNTIL RELOAD.');
}

function markUser(n) { n.user = true; if (n.children) n.children.forEach(markUser); }

/* what the text files said before anyone touched them */
const STOCK_TEXT = {};
function snapshotStock() {
  stampPaths();
  (function walk(n) {
    if (isTextish(n)) STOCK_TEXT[n._path] = n.content;
    (n.children || []).forEach(walk);
  })(FS);
}

async function upRestore() {
  snapshotStock();
  const saved = await upLoadSaved();
  uploadList = [];
  saved.forEach(rec => {
    try {
      const parent = ensureFolder(rec.parent);
      parent.children = parent.children || [];
      markUser(rec.node);
      rec.node.name = uniqueName(parent, rec.node.name);
      parent.children.push(rec.node);
      uploadList.push({ parent: rec.parent, node: rec.node });
    } catch (e) {}
  });
  stampPaths();

  /* edits to files that ship with the OS live in their own overlay, so the
     stock tree in section 2 stays exactly as written */
  stockEdits = await kvGet(ED_KEY, {});
  Object.keys(stockEdits).forEach(p => {
    const n = termResolve(FS, p);
    if (isTextish(n)) n.content = stockEdits[p];
  });

  await vaultRehydrate(FS);               /* blobs become playable again */

  wallpaper = await kvGet(WALL_KEY, null);
  if (wallpaper && wallpaper.vault) {
    const u = await VaultURL.url(wallpaper.vault);
    if (u) wallpaper.src = u; else wallpaper = null;
  }
  iconPos = await kvGet(ICON_KEY, {}) || {};
}

/* ---- 10.3 the 16-color crush -------------------------------------------- */
const VGA16 = [
  [0,0,0],      [0,0,170],    [0,170,0],    [0,170,170],
  [170,0,0],    [170,0,170],  [170,85,0],   [170,170,170],
  [85,85,85],   [85,85,255],  [85,255,85],  [85,255,255],
  [255,85,85],  [255,85,255], [255,255,85], [255,255,255]
];

function nearestVGA(r, g, b) {
  let best = VGA16[0], bd = Infinity;
  for (let i = 0; i < 16; i++) {
    const p = VGA16[i];
    const d = (r-p[0])*(r-p[0]) + (g-p[1])*(g-p[1]) + (b-p[2])*(b-p[2]);
    if (d < bd) { bd = d; best = p; }
  }
  return best;
}


/* Floyd-Steinberg, so photos survive 16 colors instead of going to mud */
function ditherVGA(ctx, w, h) {
  const id = ctx.getImageData(0, 0, w, h);
  const d = id.data;
  const spill = (x, y, f, er, eg, eb) => {
    if (x < 0 || x >= w || y >= h) return;
    const j = (y * w + x) * 4;
    d[j]   = Math.max(0, Math.min(255, d[j]   + er * f));
    d[j+1] = Math.max(0, Math.min(255, d[j+1] + eg * f));
    d[j+2] = Math.max(0, Math.min(255, d[j+2] + eb * f));
  };
  for (let y = 0; y < h; y++) {
    for (let x = 0; x < w; x++) {
      const i = (y * w + x) * 4;
      const or = d[i], og = d[i+1], ob = d[i+2];
      const p = nearestVGA(or, og, ob);
      d[i] = p[0]; d[i+1] = p[1]; d[i+2] = p[2];
      const er = or - p[0], eg = og - p[1], eb = ob - p[2];
      spill(x+1, y,   7/16, er, eg, eb);
      spill(x-1, y+1, 3/16, er, eg, eb);
      spill(x,   y+1, 5/16, er, eg, eb);
      spill(x+1, y+1, 1/16, er, eg, eb);
    }
  }
  ctx.putImageData(id, 0, 0);
}

/* ---- 10.4 reading files ------------------------------------------------- */
/* TempleOS named things in CamelCase, not SHOUTING.DOS. Keep whatever case
   the file arrived with, just make it safe to put in a path. */
function safeName(name) {
  const n = String(name).replace(/[\\/'"]/g, '_').trim().slice(0, 28);
  return n || 'File';
}

function uniqueName(folder, name) {
  const taken = (folder.children || []).map(c => c.name);
  if (taken.indexOf(name) < 0) return name;
  const dot  = name.lastIndexOf('.');
  const stem = dot > 0 ? name.slice(0, dot) : name;
  const ext  = dot > 0 ? name.slice(dot)    : '';
  let n = 2;
  while (taken.indexOf(stem + '_' + n + ext) >= 0) n++;
  return stem + '_' + n + ext;
}

function readImageFile(file) {
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onerror = () => reject(new Error('READ FAILED'));
    fr.onload = () => {
      const raw = fr.result;
      /* vector and small animations pass through untouched */
      if (/svg/i.test(file.type) || (/gif/i.test(file.type) && raw.length < 700000)) {
        return resolve({ name: safeName(file.name), type: 'image', src: raw, user: true });
      }
      const img = new Image();
      /* a decoder that answers neither way would stall the whole batch */
      const giveUp = setTimeout(() => reject(new Error('DECODE TIMED OUT')), 8000);
      img.onerror = () => { clearTimeout(giveUp); reject(new Error('NOT AN IMAGE')); };
      img.onload = () => {
       clearTimeout(giveUp);
       try {
        const s = Math.min(1, UP.maxDim / Math.max(img.width, img.height));
        const w = Math.max(1, Math.round(img.width  * s));
        const h = Math.max(1, Math.round(img.height * s));
        const cv = document.createElement('canvas');
        cv.width = w; cv.height = h;
        const ctx = cv.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);

        let hasAlpha = false;
        try {
          const px = ctx.getImageData(0, 0, w, h).data;
          for (let i = 3; i < px.length; i += 4) {
            if (px[i] < 250) { hasAlpha = true; break; }
          }
          if (UP.vga) ditherVGA(ctx, w, h);
        } catch (e) { /* canvas unreadable; keep the plain resize */ }

        /* PNG keeps flat colors and transparency small; JPEG is for photos */
        const src = (UP.vga || hasAlpha)
          ? cv.toDataURL('image/png')
          : cv.toDataURL('image/jpeg', 0.85);
        resolve({ name: safeName(file.name), type: 'image', src: src, user: true });
       } catch (e) { reject(new Error('NO CANVAS')); }
      };
      img.src = raw;
    };
    fr.readAsDataURL(file);
  });
}

function readTextFile(file) {
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onerror = () => reject(new Error('READ FAILED'));
    fr.onload  = () => resolve({
      name: safeName(file.name),
      type: 'text',
      content: String(fr.result).slice(0, 200000),
      user: true
    });
    fr.readAsText(file);
  });
}

/* ---- 10.5 writing into the tree ----------------------------------------- */
function containsNode(root, target) {
  if (root === target) return true;
  if (!root.children) return false;
  return root.children.some(c => containsNode(c, target));
}

function addNode(folder, node) {
  folder.children = folder.children || [];
  node.name = uniqueName(folder, node.name);
  node.user = true;
  /* if the folder is itself an upload, it already gets saved with its
     children, so don't track this file a second time */
  const tracked = uploadList.some(u => containsNode(u.node, folder));
  folder.children.push(node);
  stampPaths();
  if (!tracked) uploadList.push({ parent: folder._path, node: node });
}

async function importFiles(fileList, folder) {
  const files = Array.prototype.slice.call(fileList || []);
  if (!files.length) return;
  folder = folder || FS;
  let ok = 0, bad = 0;

  for (const f of files) {
    const isImg = /^image\//.test(f.type);
    const isVid = /^video\//.test(f.type) || /\.(mp4|webm|ogv|ogg|mov|m4v)$/i.test(f.name);
    const isTxt = /^text\//.test(f.type) || /\.(txt|md|hc|c|h|json|csv|log|dd)$/i.test(f.name);
    if (!isImg && !isTxt && !isVid) { bad++; continue; }
    try {
      const node = isImg ? await readImageFile(f)
                 : isVid ? await readVideoFile(f)
                 : await readTextFile(f);
      /* .DD arrives as a document, .HC as source */
      if (!isImg && !isVid) {
        if (/\.dd$/i.test(f.name)) node.type = 'doc';
        else if (/\.(hc|c|h)$/i.test(f.name)) node.type = 'code';
      }
      addNode(folder, node);
      ok++;
    } catch (e) { bad++; }
  }

  if (ok) { await upSave(); Snd.save(); } else { Snd.err(); }
  refreshViews();
  toast(ok + ' FILE(S) WRITTEN TO ' + folder._path +
        (bad ? '. ' + bad + ' NOT AN IMAGE, VIDEO OR TEXT FILE.' : '.'));
}

/* a folder is worth what is inside it */
function countFiles(node) {
  if (!node || node.type !== 'folder') return 1;
  let n = 0;
  (node.children || []).forEach(c => { n += countFiles(c); });
  return Math.max(1, n);
}

async function deleteNode(node) {
  const parent = parentOf(node);
  if (!parent) return;
  /* a deleted file gives its vault space back */
  (function reap(n) {
    if (n.vault) { VaultURL.drop(n.vault); Vault.del(n.vault); }
    (n.children || []).forEach(reap);
  })(node);
  parent.children.splice(parent.children.indexOf(node), 1);
  for (let i = uploadList.length - 1; i >= 0; i--) {
    if (uploadList[i].node === node) uploadList.splice(i, 1);
  }
  if (lastFolder === node) lastFolder = null;
  stampPaths();
  await upSave();
  refreshViews();
  Style.hit(node, node.type === 'folder' ? countFiles(node) : 1);
  toast('DELETED ' + node.name);
}

async function clearUploads() {
  const n = uploadList.length;
  uploadList.slice().forEach(u => {
    const p = parentOf(u.node);
    if (p) p.children.splice(p.children.indexOf(u.node), 1);
  });
  uploadList = [];
  lastFolder = null;
  stampPaths();
  await upSave();
  refreshViews();
  if (n) Style.hit(null, n);
  toast('ALL UPLOADS CLEARED. C:/ IS BACK TO STOCK.');
}

function newFolderIn(folder) {
  askName('NEW FOLDER IN ' + folder._path, 'PICTURES', v => {
    if (!v.trim()) return;
