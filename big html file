          if (c === 'P') { g.fillStyle = C(8); for (let i = 0; i < BEK_T; i += 5) g.fillRect(px, py + i, BEK_T, 1); g.fillStyle = C(6); g.fillRect(px + 2, py, 1, BEK_T); g.fillRect(px + 12, py, 1, BEK_T); }
          else {
