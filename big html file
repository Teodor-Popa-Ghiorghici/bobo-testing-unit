/* Serialising the whole document to count its newlines is not cheap, and the
   answer never changes, so it is counted once and kept. */
let SRC_LINES = 0;
function sourceLineCount() {
  if (SRC_LINES) return SRC_LINES;
  try {
    const s = document.documentElement.outerHTML;
    let n = 1;
    for (let i = 0; i < s.length; i++) if (s.charCodeAt(i) === 10) n++;
    SRC_LINES = n;
  } catch (e) { SRC_LINES = 0; }
  return SRC_LINES;
}

