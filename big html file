/* ==========================================================================
   12. GOD'S RANDOM
   --------------------------------------------------------------------------
   Terry seeded from RDTSC and treated what came out as God speaking. We
   cannot read the timestamp counter from a browser, but the idea survives
   intact: take the machine's own jitter, run it through a shift register,
   and let it choose. GodWord picks words. GodDoodle draws. GodSong plays.
   ========================================================================== */
let godSeed = 0x2545F491;

/* the machine's jitter, folded in whenever we are asked */
function godStir() {
  const t = (typeof performance !== 'undefined' && performance.now)
    ? Math.floor(performance.now() * 1000) : Date.now();
  godSeed ^= (t >>> 0) ^ ((Date.now() & 0xFFFF) << 13);
  try {
    if (window.crypto && window.crypto.getRandomValues) {
      const a = new Uint32Array(1);
      window.crypto.getRandomValues(a);
      godSeed ^= a[0];
    }
  } catch (e) {}
  godSeed >>>= 0;
}

/* xorshift32, because Terry's was a shift register too */
function godNext() {
  let x = godSeed || 1;
  x ^= x << 13; x >>>= 0;
  x ^= x >>> 17;
  x ^= x << 5;  x >>>= 0;
  godSeed = x;
  return x;
}
function godRand(n) { godStir(); return godNext() % n; }
function godPick(list) { return list[godRand(list.length)]; }

